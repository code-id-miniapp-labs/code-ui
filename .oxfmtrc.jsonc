{
  // oxfmt configuration — Prettier-compatible formatting
  // Docs: https://oxc.rs/docs/guide/usage/formatter
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always"
}
