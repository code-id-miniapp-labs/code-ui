{
  "name": "code-ui",
  "version": "0.0.0",
  "private": true,
  "description": "A framework-agnostic UI library for MiniApp environments powered by FSM + alien-signals",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-id-miniapp-labs/code-ui.git"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "size": "node scripts/size-report.mjs",
    "size:check": "node scripts/size-report.mjs --check",
    "components": "node scripts/component-report.mjs",
    "lint": "oxlint packages",
    "lint:fix": "oxlint --fix packages",
    "format": "oxfmt packages",
    "format:check": "oxfmt --check packages",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.5.4",
    "vitest": "^5.0.2"
  }
}
