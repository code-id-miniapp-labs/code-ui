{
  "name": "@code-ui/utils",
  "version": "0.0.1",
  "description": "Shared DOM and event utilities for MiniApp native components",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "miniprogram-api-typings": "^5.2.3",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4"
  }
}
