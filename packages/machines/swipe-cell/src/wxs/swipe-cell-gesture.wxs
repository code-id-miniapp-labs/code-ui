var dom = require('./dom.wxs');

var startX = 0;
var startY = 0;
var startOffset = 0;
var currentOffset = 0;
var isDragging = false;
var direction = '';

var _wrapperEl = null;

var _throttledCallMove = dom.throttle(function(ownerInstance, data) {
  if (ownerInstance) {
    ownerInstance.callMethod('handleTouchMove', data);
  }
}, 16);

function onTouchStart(event, ownerInstance) {
  var touch = dom.getTouch(event);
  var dataset = dom.getDataset(event);
  if (!touch) return;

  if (dataset.disabled === true || dataset.disabled === 'true') {
    return;
  }

  startX = touch.clientX;
  startY = touch.clientY;
  startOffset =
    dataset.offset !== undefined && dataset.offset !== null && dataset.offset !== ''
      ? Number(dataset.offset)
      : (currentOffset || 0);
  if (isNaN(startOffset)) startOffset = currentOffset || 0;
  currentOffset = startOffset;
  isDragging = false;
  direction = '';

  if (_throttledCallMove && _throttledCallMove.reset) {
    _throttledCallMove.reset();
  }

  _wrapperEl =
    event.instance ||
    dom.selectEl(ownerInstance, '#' + dataset.wrapperId) ||
    dom.selectEl(ownerInstance, '.cui-swipe-cell__wrapper');
}

function onTouchMove(event, ownerInstance) {
  var touch = dom.getTouch(event);
  var dataset = dom.getDataset(event);
  if (!touch) return;

  if (dataset.disabled === true || dataset.disabled === 'true') {
    return;
  }

  var deltaX = touch.clientX - startX;
  var deltaY = touch.clientY - startY;

  if (!direction) {
    var absX = Math.abs(deltaX);
    var absY = Math.abs(deltaY);
    if (absX > absY && absX > 5) {
      direction = 'horizontal';
    } else if (absY > absX && absY > 5) {
      direction = 'vertical';
    }
  }

  if (direction === 'vertical') {
    return;
  }

  if (direction === 'horizontal') {
    if (!isDragging) {
      isDragging = true;
      if (_wrapperEl) {
        _wrapperEl.setStyle('transition: none; transform: translate3d(' + startOffset + 'px, 0, 0);');
      }
      ownerInstance.callMethod('handleTouchStart', {
        clientX: touch.clientX,
        clientY: touch.clientY,
        offset: startOffset
      });
    }
    var leftWidth = dataset.leftWidth ? Number(dataset.leftWidth) : 0;
    var rightWidth = dataset.rightWidth ? Number(dataset.rightWidth) : 0;
    var newOffset = startOffset + deltaX;

    if (newOffset > 0) {
      if (leftWidth <= 0) {
        newOffset = 0;
      } else if (newOffset > leftWidth) {
        newOffset = leftWidth + (newOffset - leftWidth) * 0.2;
      }
    } else if (newOffset < 0) {
      if (rightWidth <= 0) {
        newOffset = 0;
      } else if (newOffset < -rightWidth) {
        newOffset = -rightWidth + (newOffset + rightWidth) * 0.2;
      }
    }

    currentOffset = newOffset;

    if (_wrapperEl) {
      _wrapperEl.setStyle('transition: none; transform: translate3d(' + newOffset + 'px, 0, 0);');
    }

    _throttledCallMove(ownerInstance, {
      offset: newOffset,
      deltaX: deltaX
    });

    return false;
  }
}

function onTouchEnd(event, ownerInstance) {
  var touch = dom.getChangedTouch(event);
  var dataset = dom.getDataset(event);

  if (!isDragging || direction !== 'horizontal') {
    _wrapperEl = null;
    isDragging = false;
    direction = '';
    return;
  }

  var leftWidth = dataset.leftWidth ? Number(dataset.leftWidth) : 0;
  var rightWidth = dataset.rightWidth ? Number(dataset.rightWidth) : 0;
  var threshold = dataset.threshold ? Number(dataset.threshold) : 30;
  var duration = dataset.duration ? Number(dataset.duration) : 300;

  var deltaX = touch ? (touch.clientX - startX) : (currentOffset - startOffset);

  var target = 0;
  var opened = false;
  var side = null;

  var curOffset = typeof currentOffset === 'number' ? currentOffset : (startOffset + deltaX);

  if (startOffset === 0) {
    if (deltaX > threshold && leftWidth > 0) {
      target = leftWidth;
      opened = true;
      side = 'left';
    } else if (deltaX < -threshold && rightWidth > 0) {
      target = -rightWidth;
      opened = true;
      side = 'right';
    } else {
      target = 0;
      opened = false;
      side = null;
    }
  } else if (startOffset > 0) {
    if ((curOffset < -threshold || (startOffset + deltaX) < -threshold) && rightWidth > 0) {
      target = -rightWidth;
      opened = true;
      side = 'right';
    } else if (deltaX < -threshold) {
      target = 0;
      opened = false;
      side = null;
    } else {
      target = leftWidth;
      opened = true;
      side = 'left';
    }
  } else if (startOffset < 0) {
    if ((curOffset > threshold || (startOffset + deltaX) > threshold) && leftWidth > 0) {
      target = leftWidth;
      opened = true;
      side = 'left';
    } else if (deltaX > threshold) {
      target = 0;
      opened = false;
      side = null;
    } else {
      target = -rightWidth;
      opened = true;
      side = 'right';
    }
  }

  if (_wrapperEl) {
    _wrapperEl.setStyle(
      'transition: transform ' + duration + 'ms cubic-bezier(0.16, 1, 0.3, 1); transform: translate3d(' + target + 'px, 0, 0);'
    );
  }

  _wrapperEl = null;
  isDragging = false;
  direction = '';
  currentOffset = target;

  if (_throttledCallMove && _throttledCallMove.reset) {
    _throttledCallMove.reset();
  }

  ownerInstance.callMethod('handleTouchEnd', {
    opened: opened,
    side: side,
    offset: target
  });
}

function onOffsetChange(newValue, oldValue, ownerInstance, instance) {
  if (newValue === oldValue) return;
  if (isDragging) return;

  var targetEl =
    instance ||
    _wrapperEl ||
    (ownerInstance
      ? dom.selectEl(ownerInstance, '.cui-swipe-cell__wrapper')
      : null);
  if (!targetEl) return;

  var offset = typeof newValue === 'number' ? newValue : 0;
  var dataset = targetEl.getDataset ? targetEl.getDataset() : {};
  var duration = dataset.duration ? Number(dataset.duration) : 300;

  if (oldValue === undefined || oldValue === null) {
    if (offset !== 0) {
      targetEl.setStyle('transform: translate3d(' + offset + 'px, 0, 0);');
    }
    currentOffset = offset;
    return;
  }

  targetEl.setStyle(
    'transition: transform ' + duration + 'ms cubic-bezier(0.16, 1, 0.3, 1); transform: translate3d(' + offset + 'px, 0, 0);'
  );
  currentOffset = offset;
}

module.exports = {
  onTouchStart: onTouchStart,
  onTouchMove: onTouchMove,
  onTouchEnd: onTouchEnd,
  onOffsetChange: onOffsetChange,
};

