{
  "name": "@code-id-labs/input-menu",
  "version": "0.0.1",
  "private": true,
  "description": "Input menu state machine for code-ui",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../../vitest.config.mts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@code-id-labs/anatomy": "workspace:*",
    "@code-id-labs/core": "workspace:*",
    "@code-id-labs/popover": "workspace:*",
    "@code-id-labs/form": "workspace:*",
    "@code-id-labs/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "alien-signals": "^3.2.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "alien-signals": ">=3.0.0"
  }
}
