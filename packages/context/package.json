{
  "name": "@code-ui/context",
  "version": "0.0.1",
  "description": "Dependency injection and event bus context primitives for MiniApp native components",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@code-ui/utils": "workspace:*"
  },
  "devDependencies": {
    "miniprogram-api-typings": "^5.2.3",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4"
  }
}
