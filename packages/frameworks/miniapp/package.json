{
  "name": "@code-ui/miniapp",
  "version": "0.0.1",
  "description": "MiniApp framework runtime and machine adapter for code-ui",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./computed": {
      "types": "./dist/behaviors/computed-behavior.d.ts",
      "import": "./dist/behaviors/computed-behavior.js",
      "require": "./dist/behaviors/computed-behavior.cjs"
    },
    "./behavior": {
      "types": "./dist/behavior.d.ts",
      "import": "./dist/behavior.js",
      "require": "./dist/behavior.cjs"
    },
    "./behaviors/form": {
      "types": "./dist/behaviors/form.d.ts",
      "import": "./dist/behaviors/form.js",
      "require": "./dist/behaviors/form.cjs"
    },
    "./behaviors/radio": {
      "types": "./dist/behaviors/radio.d.ts",
      "import": "./dist/behaviors/radio.js",
      "require": "./dist/behaviors/radio.cjs"
    },
    "./behaviors/checkbox": {
      "types": "./dist/behaviors/checkbox.d.ts",
      "import": "./dist/behaviors/checkbox.js",
      "require": "./dist/behaviors/checkbox.cjs"
    },
    "./behaviors/stepper": {
      "types": "./dist/behaviors/stepper.d.ts",
      "import": "./dist/behaviors/stepper.js",
      "require": "./dist/behaviors/stepper.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@code-ui/core": "workspace:*",
    "@code-ui/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "alien-signals": "^1.0.4",
    "miniprogram-api-typings": "^5.2.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "alien-signals": ">=1.0.0"
  }
}
