{
  "name": "@code-ui/core",
  "version": "0.0.1",
  "description": "Core FSM types and machine infrastructure for code-ui",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@code-ui/utils": "workspace:*"
  },
  "devDependencies": {
    "alien-signals": "^1.0.4",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "miniprogram-api-typings": "^5.2.3",
    "@types/node": "^26.2.0"
  },
  "peerDependencies": {
    "alien-signals": ">=1.0.0"
  }
}
