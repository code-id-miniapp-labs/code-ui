{
  "name": "@code-id-labs/compiler",
  "version": "0.0.2",
  "private": true,
  "description": "WXML compiler and compile-time active slot analyzer for @code-ui",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.5.4"
  }
}
