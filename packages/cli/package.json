{
  "name": "@code-id-labs/cli",
  "version": "1.2.6",
  "description": "CLI tool for code-ui prebuilt WeChat MiniProgram component library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-id-miniapp-labs/code-ui.git",
    "directory": "packages/cli"
  },
