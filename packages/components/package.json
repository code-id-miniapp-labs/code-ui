    "./behaviors/*": "./dist/behaviors/*",
    "./utils/app": {
      "types": "./dist/behaviors/app.d.ts",
      "import": "./dist/behaviors/app.js",
      "require": "./dist/behaviors/app.js"
    },
    "./runtime/*": "./dist/runtime/*",
    "./dist/*": "./dist/*",
    "./themes/*": "./dist/themes/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "weapp-vite build",
    "dev": "weapp-vite",
    "analyze": "weapp-vite analyze",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@code-ui/plugin-vite": "workspace:*",
    "@types/node": "^26.2.0",
    "alien-signals": "^3.2.1",
    "miniprogram-api-typings": "^5.2.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "weapp-vite": "^7.3.0",
    "@code-ui/accordion": "workspace:*",
    "@code-ui/accordion-item": "workspace:*",
    "@code-ui/anatomy": "workspace:*",
    "@code-ui/button": "workspace:*",
    "@code-ui/checkbox": "workspace:*",
    "@code-ui/checkbox-group": "workspace:*",
    "@code-ui/context": "workspace:*",
    "@code-ui/core": "workspace:*",
    "@code-ui/drawer": "workspace:*",
    "@code-ui/form": "workspace:*",
    "@code-ui/form-field": "workspace:*",
    "@code-ui/input": "workspace:*",
