{
  "name": "@code-ui/components",
  "version": "0.0.1",
  "description": "Prebuilt native WeChat MiniProgram UI components for code-ui",
  "files": [
    "dist",
    "index.css",
    "keyframes.wxss"
  ],
  "type": "module",
  "miniprogram": "dist",
  "style": "./index.css",
  "sideEffects": [
    "*.wxss",
    "*.css",
    "src/runtime/**/index.ts",
    "dist/runtime/**/index.js"
  ],
  "main": "./dist/app.js",
  "exports": {
    ".": {
      "style": "./index.css",
      "import": "./dist/app.js",
      "require": "./dist/app.js"
    },
    "./index.css": "./index.css",
    "./keyframes.wxss": "./keyframes.wxss",
    "./theme": "./index.css",
    "./button": {
      "types": "./dist/runtime/button/index.d.ts",
      "import": "./dist/runtime/button/index.js",
      "require": "./dist/runtime/button/index.js"
    },
    "./button/*": "./dist/runtime/button/*",
    "./accordion": {
      "types": "./dist/runtime/accordion/index.d.ts",
      "import": "./dist/runtime/accordion/index.js",
      "require": "./dist/runtime/accordion/index.js"
    },
    "./accordion/*": "./dist/runtime/accordion/*",
    "./accordion-item": {
      "types": "./dist/runtime/accordion-item/index.d.ts",
      "import": "./dist/runtime/accordion-item/index.js",
      "require": "./dist/runtime/accordion-item/index.js"
    },
    "./accordion-item/*": "./dist/runtime/accordion-item/*",
    "./avatar": {
      "types": "./dist/runtime/avatar/index.d.ts",
      "import": "./dist/runtime/avatar/index.js",
