{
  "name": "@code-ui/components",
  "version": "0.0.1",
  "description": "Prebuilt native WeChat MiniProgram UI components for code-ui",
  "files": [
    "dist",
    "index.css"
  ],
  "type": "module",
  "miniprogram": "dist",
  "style": "./index.css",
  "sideEffects": [
    "*.wxss",
    "*.css",
    "src/runtime/**/index.ts",
    "dist/runtime/**/index.js"
  ],
  "main": "./dist/app.js",
  "exports": {
    ".": {
      "style": "./index.css",
      "import": "./dist/app.js",
      "require": "./dist/app.js"
    },
    "./index.css": "./index.css",
    "./theme": "./index.css",
    "./button": {
      "types": "./dist/runtime/button/index.d.ts",
      "import": "./dist/runtime/button/index.js",
      "require": "./dist/runtime/button/index.js"
    },
    "./button/*": "./dist/runtime/button/*",
    "./card": {
      "types": "./dist/runtime/card/index.d.ts",
      "import": "./dist/runtime/card/index.js",
      "require": "./dist/runtime/card/index.js"
    },
    "./card/*": "./dist/runtime/card/*",
    "./checkbox": {
      "types": "./dist/runtime/checkbox/index.d.ts",
      "import": "./dist/runtime/checkbox/index.js",
      "require": "./dist/runtime/checkbox/index.js"
    },
    "./checkbox/*": "./dist/runtime/checkbox/*",
    "./checkbox-group": {
      "types": "./dist/runtime/checkbox-group/index.d.ts",
      "import": "./dist/runtime/checkbox-group/index.js",
      "require": "./dist/runtime/checkbox-group/index.js"
    },
    "./checkbox-group/*": "./dist/runtime/checkbox-group/*",
    "./chip": {
      "types": "./dist/runtime/chip/index.d.ts",
      "import": "./dist/runtime/chip/index.js",
      "require": "./dist/runtime/chip/index.js"
    },
    "./chip/*": "./dist/runtime/chip/*",
    "./drawer": {
      "types": "./dist/runtime/drawer/index.d.ts",
      "import": "./dist/runtime/drawer/index.js",
      "require": "./dist/runtime/drawer/index.js"
    },
    "./drawer/*": "./dist/runtime/drawer/*",
    "./form": {
      "types": "./dist/runtime/form/index.d.ts",
      "import": "./dist/runtime/form/index.js",
      "require": "./dist/runtime/form/index.js"
    },
    "./form/*": "./dist/runtime/form/*",
    "./form-field": {
      "types": "./dist/runtime/form-field/index.d.ts",
      "import": "./dist/runtime/form-field/index.js",
      "require": "./dist/runtime/form-field/index.js"
    },
    "./form-field/*": "./dist/runtime/form-field/*",
    "./icon": {
      "types": "./dist/runtime/icon/index.d.ts",
      "import": "./dist/runtime/icon/index.js",
      "require": "./dist/runtime/icon/index.js"
    },
    "./icon/*": "./dist/runtime/icon/*",
    "./input": {
      "types": "./dist/runtime/input/index.d.ts",
      "import": "./dist/runtime/input/index.js",
      "require": "./dist/runtime/input/index.js"
    },
    "./input/*": "./dist/runtime/input/*",
    "./pin-input": {
      "types": "./dist/runtime/pin-input/index.d.ts",
      "import": "./dist/runtime/pin-input/index.js",
      "require": "./dist/runtime/pin-input/index.js"
    },
    "./pin-input/*": "./dist/runtime/pin-input/*",
    "./qr-code": {
      "types": "./dist/runtime/qr-code/index.d.ts",
      "import": "./dist/runtime/qr-code/index.js",
      "require": "./dist/runtime/qr-code/index.js"
    },
    "./qr-code/*": "./dist/runtime/qr-code/*",
    "./radio": {
      "types": "./dist/runtime/radio/index.d.ts",
      "import": "./dist/runtime/radio/index.js",
      "require": "./dist/runtime/radio/index.js"
    },
    "./radio/*": "./dist/runtime/radio/*",
    "./radio-group": {
      "types": "./dist/runtime/radio-group/index.d.ts",
      "import": "./dist/runtime/radio-group/index.js",
      "require": "./dist/runtime/radio-group/index.js"
    },
    "./radio-group/*": "./dist/runtime/radio-group/*",
    "./stepper": {
      "types": "./dist/runtime/stepper/index.d.ts",
      "import": "./dist/runtime/stepper/index.js",
      "require": "./dist/runtime/stepper/index.js"
    },
    "./stepper/*": "./dist/runtime/stepper/*",
    "./stepper-item": {
      "types": "./dist/runtime/stepper-item/index.d.ts",
      "import": "./dist/runtime/stepper-item/index.js",
      "require": "./dist/runtime/stepper-item/index.js"
    },
    "./stepper-item/*": "./dist/runtime/stepper-item/*",
    "./switch": {
      "types": "./dist/runtime/switch/index.d.ts",
      "import": "./dist/runtime/switch/index.js",
      "require": "./dist/runtime/switch/index.js"
    },
    "./switch/*": "./dist/runtime/switch/*",
    "./textarea": {
      "types": "./dist/runtime/textarea/index.d.ts",
      "import": "./dist/runtime/textarea/index.js",
      "require": "./dist/runtime/textarea/index.js"
    },
    "./textarea/*": "./dist/runtime/textarea/*",
    "./runtime/*": "./dist/runtime/*",
    "./dist/*": "./dist/*",
    "./themes/*": "./dist/themes/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "weapp-vite build",
    "dev": "weapp-vite",
    "analyze": "weapp-vite analyze",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@code-ui/plugin-vite": "workspace:*",
    "@types/node": "^26.2.0",
    "alien-signals": "^3.2.1",
    "miniprogram-api-typings": "^5.2.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "weapp-vite": "^7.3.0",
    "@code-ui/anatomy": "workspace:*",
    "@code-ui/button": "workspace:*",
    "@code-ui/checkbox": "workspace:*",
    "@code-ui/checkbox-group": "workspace:*",
    "@code-ui/context": "workspace:*",
    "@code-ui/core": "workspace:*",
    "@code-ui/drawer": "workspace:*",
    "@code-ui/form": "workspace:*",
    "@code-ui/form-field": "workspace:*",
    "@code-ui/input": "workspace:*",
    "@code-ui/miniapp": "workspace:*",
    "@code-ui/pin-input": "workspace:*",
    "@code-ui/qr-code": "workspace:*",
    "@code-ui/radio": "workspace:*",
    "@code-ui/radio-group": "workspace:*",
    "@code-ui/stepper": "workspace:*",
    "@code-ui/stepper-item": "workspace:*",
    "@code-ui/switch": "workspace:*",
    "@code-ui/textarea": "workspace:*",
    "@code-ui/utils": "workspace:*",
    "@weapp-tailwindcss/escape": "^0.0.2"
  },
  "peerDependencies": {
    "alien-signals": ">=3.0.0"
  }
}
