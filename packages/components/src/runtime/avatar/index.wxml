<view wx:if="{{!groupHidden}}" class="{{classes.root}}" style="{{rootStyle}}">
  <image wx:if="{{src && !imageError}}" src="{{src}}" mode="{{mode}}" lazy-load="{{lazyLoad}}" class="{{classes.image}}" binderror="onImageError" />
  <block wx:else>
    <c-icon wx:if="{{icon}}" name="{{icon}}" className="{{classes.icon}}" />
    <view wx:else class="{{classes.fallback}}">{{fallbackText}}</view>
  </block>
</view>
