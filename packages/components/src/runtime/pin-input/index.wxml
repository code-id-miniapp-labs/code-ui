<view id="{{pinInput.rootProps.id}}" class="{{classes.root}}" data-scope="pin-input" data-part="root" data-state="{{pinInput.state}}" data-disabled="{{pinInput.disabled}}" data-readonly="{{pinInput.readOnly}}" data-invalid="{{pinInput.invalid}}" data-complete="{{pinInput.isValueComplete}}" aria-role="group" aria-disabled="{{pinInput.disabled}}" aria-invalid="{{pinInput.invalid}}">
  <text wx:if="{{label}}" id="{{pinInput.labelProps.id}}" class="{{classes.label}}" data-scope="pin-input" data-part="label">{{label}}</text>
  <view class="{{classes.control}}" data-scope="pin-input" data-part="control" data-disabled="{{pinInput.disabled}}" data-invalid="{{pinInput.invalid}}">
    <block wx:for="{{pinInput.inputs}}" wx:key="index">
      <input
        id="{{item.inputProps.id}}"
        class="{{classes.input}}"
        data-scope="pin-input"
        data-part="input"
        data-index="{{item.index}}"
        data-state="{{item.isFocused ? 'focused' : 'idle'}}"
        data-focused="{{item.isFocused}}"
        data-disabled="{{pinInput.disabled}}"
        data-readonly="{{pinInput.readOnly}}"
        data-invalid="{{pinInput.invalid}}"
        data-complete="{{pinInput.isValueComplete}}"
        value="{{item.inputProps.value}}"
        focus="{{item.inputProps.focus}}"
        disabled="{{item.inputProps.disabled}}"
        type="{{item.inputProps.type}}"
        password="{{item.inputProps.password}}"
        placeholder="{{item.inputProps.placeholder}}"
        maxlength="{{item.inputProps.maxlength}}"
        aria-label="{{item.inputProps['aria-label']}}"
        aria-invalid="{{pinInput.invalid}}"
        bindinput="handleInput"
        bindfocus="handleFocus"
        bindblur="handleBlur"
        bindtap="handleTap"
      />
      <text
        wx:if="{{item.hasSeparator}}"
        class="{{classes.separator}}"
        data-scope="pin-input"
        data-part="separator"
        aria-hidden="true"
      >{{item.separatorChar}}</text>
    </block>
  </view>
</view>
