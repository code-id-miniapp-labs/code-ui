<view id="{{pinInput.rootProps.id}}" class="{{classes.root}}" data-scope="pin-input" data-part="root" data-state="{{pinInput.state}}" data-disabled="{{pinInput.rootProps['data-disabled']}}" data-readonly="{{pinInput.rootProps['data-readonly']}}" data-complete="{{pinInput.rootProps['data-complete']}}" role="group" aria-disabled="{{pinInput.rootProps['aria-disabled']}}">
  <text wx:if="{{label}}" id="{{pinInput.labelProps.id}}" class="{{classes.label}}" data-scope="pin-input" data-part="label">{{label}}</text>
  <view id="{{pinInput.controlProps.id}}" class="{{classes.control}}" data-scope="pin-input" data-part="control" data-disabled="{{pinInput.controlProps['data-disabled']}}">
    <block wx:for="{{pinInput.inputs}}" wx:key="index">
      <input
        id="{{item.inputProps.id}}"
        class="{{classes.input}}"
        data-scope="{{item.inputProps['data-scope']}}"
        data-part="{{item.inputProps['data-part']}}"
        data-index="{{item.inputProps['data-index']}}"
        data-state="{{item.inputProps['data-state']}}"
        data-focused="{{item.inputProps['data-focused']}}"
        data-disabled="{{item.inputProps['data-disabled']}}"
        data-readonly="{{item.inputProps['data-readonly']}}"
        data-complete="{{item.inputProps['data-complete']}}"
        value="{{item.inputProps.value}}"
        focus="{{item.inputProps.focus}}"
        disabled="{{item.inputProps.disabled}}"
        type="{{item.inputProps.type}}"
        password="{{item.inputProps.password}}"
        placeholder="{{item.inputProps.placeholder}}"
        maxlength="{{item.inputProps.maxlength}}"
        role="{{item.inputProps.role}}"
        aria-label="{{item.inputProps['aria-label']}}"
        bindinput="handleInput"
        bindfocus="handleFocus"
        bindblur="handleBlur"
      />
      <text
        wx:if="{{item.hasSeparator}}"
        id="{{item.separatorProps.id}}"
        class="{{classes.separator}}"
        data-scope="{{item.separatorProps['data-scope']}}"
        data-part="{{item.separatorProps['data-part']}}"
        aria-hidden="{{item.separatorProps['aria-hidden']}}"
      >{{item.separatorChar}}</text>
    </block>
    <input
      wx:if="{{name}}"
      id="{{pinInput.hiddenInputProps.id}}"
      name="{{name}}"
      value="{{pinInput.hiddenInputProps.value}}"
      disabled="{{pinInput.hiddenInputProps.disabled}}"
      aria-hidden="true"
      class="sr-only hidden"
    />
  </view>
</view>
