<root-portal wx:if="{{tour.visible}}" enable="{{portal}}">
  <view class="{{portal ? 'tw-root ' + themeMode : ''}}" style="{{portalStyle}}">
    <view id="{{tour.rootProps.id}}" class="{{classes.root}}" data-scope="tour" data-part="root" data-state="{{tour.state}}" data-step="{{tour.stepId || ''}}" data-type="{{tour.stepType}}">
      <block wx:if="{{tour.showBackdrop}}">
        <block wx:if="{{tour.showSpotlight}}">
          <view class="{{classes.backdrop}}" style="{{tour.backdropTopStyle}}" data-scope="tour" data-part="backdrop" data-state="{{tour.open ? 'open' : 'closed'}}" aria-hidden="{{true}}" catchtap="handleBackdropTap" catchtouchmove="noop" />
          <view class="{{classes.backdrop}}" style="{{tour.backdropBottomStyle}}" data-scope="tour" data-part="backdrop" data-state="{{tour.open ? 'open' : 'closed'}}" aria-hidden="{{true}}" catchtap="handleBackdropTap" catchtouchmove="noop" />
          <view class="{{classes.backdrop}}" style="{{tour.backdropLeftStyle}}" data-scope="tour" data-part="backdrop" data-state="{{tour.open ? 'open' : 'closed'}}" aria-hidden="{{true}}" catchtap="handleBackdropTap" catchtouchmove="noop" />
          <view class="{{classes.backdrop}}" style="{{tour.backdropRightStyle}}" data-scope="tour" data-part="backdrop" data-state="{{tour.open ? 'open' : 'closed'}}" aria-hidden="{{true}}" catchtap="handleBackdropTap" catchtouchmove="noop" />
        </block>
        <view wx:else id="{{tour.backdropProps.id}}" class="{{classes.backdrop}}" data-scope="tour" data-part="backdrop" data-state="{{tour.open ? 'open' : 'closed'}}" aria-hidden="{{true}}" catchtap="handleBackdropTap" catchtouchmove="noop" />
      </block>

      <view wx:if="{{tour.showSpotlight && tour.preventInteraction}}" id="{{tour.spotlightProps.id}}" class="{{classes.spotlight}}" style="{{tour.spotlightStyle}}" data-scope="tour" data-part="spotlight" data-state="{{tour.open ? 'open' : 'closed'}}" aria-hidden="{{true}}" catchtap="noop" catchtouchmove="noop" />
      <view wx:elif="{{tour.showSpotlight}}" id="{{tour.spotlightProps.id}}" class="{{classes.spotlight}}" style="{{tour.spotlightStyle}}" data-scope="tour" data-part="spotlight" data-state="{{tour.open ? 'open' : 'closed'}}" aria-hidden="{{true}}" />

      <view wx:if="{{tour.showCard}}" id="{{tour.positionerProps.id}}" class="{{classes.positioner}}" style="{{tour.positionerStyle}}" data-scope="tour" data-part="positioner" data-state="{{tour.state}}" data-type="{{tour.stepType}}" data-side="{{tour.resolvedSide}}">
        <view id="{{tour.contentProps.id}}" class="{{classes.content}}" data-scope="tour" data-part="content" data-state="{{tour.state}}" data-type="{{tour.stepType}}" data-side="{{tour.resolvedSide}}" aria-role="dialog" aria-modal="{{true}}" aria-hidden="{{!tour.open}}" catchtap="noop">
          <view wx:if="{{tour.showArrow}}" class="{{classes.arrow}}" style="{{tour.arrowStyle}}" data-scope="tour" data-part="arrow" data-side="{{tour.resolvedSide}}" aria-hidden="{{true}}" />

          <view wx:if="{{resolvedClose || slots.close}}" id="{{tour.closeTriggerProps.id}}" class="{{classes.closeTrigger}}" data-scope="tour" data-part="close-trigger">
            <view wx:if="{{slots.close}}" class="{{classes.closeButton}}" aria-role="button" aria-label="Close" catchtap="handleCloseTap">
              <slot name="close" />
            </view>
            <c-button wx:elif="{{resolvedClose}}" icon="{{resolvedClose.icon || ''}}" leading-icon="{{resolvedClose.leadingIcon || ''}}" trailing-icon="{{resolvedClose.trailingIcon || ''}}" label="{{resolvedClose.label || ''}}" loading="{{resolvedClose.loading || false}}" loading-icon="{{resolvedClose.loadingIcon || 'loading'}}" color="{{resolvedClose.color}}" variant="{{resolvedClose.variant}}" size="{{resolvedClose.size}}" disabled="{{resolvedClose.disabled || false}}" ui="{{resolvedClose.ui}}" className="{{resolvedClose.className}}" aria-label="Close" catch:tap="handleCloseTap" />
          </view>

          <view wx:if="{{slots.header || (tour.step && (tour.step.badge || tour.step.title || tour.step.description)) || slots.title || slots.description}}" class="{{classes.header}}" data-scope="tour" data-part="header">
            <slot wx:if="{{slots.header}}" name="header" />
            <view wx:else class="{{classes.wrapper}}" data-scope="tour" data-part="wrapper">
              <view wx:if="{{tour.step && tour.step.badge}}" class="{{classes.badge}}" data-scope="tour" data-part="badge">{{tour.step.badge}}</view>
              <view wx:if="{{tour.step && tour.step.title}}" class="{{classes.title}}" data-scope="tour" data-part="title">{{tour.step.title}}</view>
              <slot wx:else name="title" />
              <view wx:if="{{tour.step && tour.step.description}}" class="{{classes.description}}" data-scope="tour" data-part="description">{{tour.step.description}}</view>
              <slot wx:else name="description" />
            </view>
          </view>

          <view wx:if="{{slots.default}}" class="{{classes.body}}" data-scope="tour" data-part="body">
            <slot />
          </view>

          <view wx:if="{{slots.footer || (showProgress && tour.totalSteps > 1) || slots.progress || resolvedActions.length > 0 || slots.actions}}" class="{{classes.footer}}" data-scope="tour" data-part="footer">
            <slot wx:if="{{slots.footer}}" name="footer" />
            <block wx:else>
              <slot wx:if="{{slots.progress}}" name="progress" />
              <block wx:elif="{{showProgress && tour.totalSteps > 1}}">
                <view wx:if="{{progressVariant === 'text'}}" class="{{classes.progressText}}" data-scope="tour" data-part="progress-text">{{tour.progressText}}</view>
                <view wx:else class="{{classes.progress}}" data-scope="tour" data-part="progress" aria-label="{{tour.progressText}}">
                  <view wx:for="{{progressDots}}" wx:key="index" class="{{item.active ? classes.progressDotActive : classes.progressDot}}" />
                </view>
              </block>

              <view wx:if="{{slots.actions}}" class="{{classes.actions}}" data-scope="tour" data-part="actions">
                <slot name="actions" />
              </view>
              <view wx:elif="{{resolvedActions.length > 0}}" class="{{classes.actions}}" data-scope="tour" data-part="actions">
                <c-button wx:for="{{resolvedActions}}" wx:key="key" label="{{item.label}}" icon="{{item.icon}}" leading-icon="{{item.leadingIcon}}" trailing-icon="{{item.trailingIcon}}" color="{{item.color}}" variant="{{item.variant}}" size="{{item.size}}" disabled="{{item.disabled}}" data-action-type="{{item.actionType}}" data-action-index="{{item.actionIndex}}" catch:tap="handleActionTap" />
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>
  </view>
</root-portal>
