<view
  id="{{accordion.rootProps.id}}"
  class="cui-accordion {{classes.root}}"
  data-scope="accordion"
  data-part="root"
  data-disabled="{{disabled}}"
  data-size="{{size}}"
  data-variant="{{variant}}"
>
  <block wx:if="{{hasItems}}">
    <c-accordion-item
      wx:for="{{resolvedItems}}"
      wx:key="value"
      class="cui-accordion-item"
      id="{{item.itemProps.id}}"
      value="{{item.value}}"
      label="{{item.label}}"
      description="{{item.description}}"
      content="{{item.content}}"
      icon="{{item.icon}}"
      trailing-icon="{{item.trailingIcon}}"
      disabled="{{item.disabled}}"
      open="{{item.isOpen}}"
      collapsible="{{collapsible}}"
      size="{{size}}"
      variant="{{variant}}"
      ui="{{item.ui}}"
      data-value="{{item.value}}"
      bind:change="handleItemClick"
    />
  </block>
  <slot wx:else />
</view>

