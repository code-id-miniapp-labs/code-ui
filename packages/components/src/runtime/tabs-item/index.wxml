<!-- Trigger Mode: Tab trigger button within the tablist -->
<view
  wx:if="{{mode === 'trigger'}}"
  id="{{tabsItem.triggerProps.id}}"
  class="cui-tabs-trigger {{classes.trigger}}"
  aria-role="tab"
  aria-selected="{{tabsItem.isSelected}}"
  aria-disabled="{{tabsItem.disabled}}"
  data-scope="tabs"
  data-part="trigger"
  data-value="{{tabsItem.value}}"
  data-index="{{tabsItem.index}}"
  data-state="{{tabsItem.state}}"
  data-disabled="{{tabsItem.disabled}}"
  data-orientation="{{resolvedOrientation}}"
  bindtap="handleTap"
>
  <!-- Active Indicator (Pill background or Link underline) -->
  <view
    class="cui-tabs-indicator {{classes.indicator}}"
    data-scope="tabs"
    data-part="indicator"
    data-orientation="{{resolvedOrientation}}"
    data-state="{{tabsItem.state}}"
  />

  <view class="{{classes.triggerInner}}">
    <slot wx:if="{{icons.hasLeadingSlot}}" name="leading" />
    <c-icon wx:if="{{icons.leadingIconName}}" name="{{icons.leadingIconName}}" className="cui-tabs-leading {{classes.leading}}" />

    <!-- Label -->
    <text wx:if="{{label}}" class="cui-tabs-label {{classes.label}}">{{label}}</text>
    <slot wx:else name="label" />

    <!-- Trailing Slot & Trailing Icon -->
    <slot wx:if="{{icons.hasTrailingSlot}}" name="trailing" />
    <c-icon wx:if="{{icons.trailingIconName}}" name="{{icons.trailingIconName}}" className="cui-tabs-trailing {{classes.trailing}}" />
  </view>
</view>

<!-- Panel Mode / Auto: Tab content panel -->
<view
  wx:else
  id="{{tabsItem.contentProps.id}}"
  class="cui-tabs-item {{classes.root}}"
  aria-role="tabpanel"
  aria-labelledby="{{tabsItem.contentProps['aria-labelledby']}}"
  data-scope="tabs-item"
  data-part="root"
  data-value="{{tabsItem.value}}"
  data-state="{{tabsItem.state}}"
  data-disabled="{{tabsItem.disabled}}"
  hidden="{{!tabsItem.isSelected}}"
>
  <view class="cui-tabs-item-content {{classes.content}}">
    <slot wx:if="{{tabsItem.isSelected || !lazy}}" />
  </view>
</view>