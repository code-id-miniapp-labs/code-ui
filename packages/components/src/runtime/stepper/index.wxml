<view id="{{stepper.rootProps.id}}" class="{{classes.root}}" data-scope="stepper" data-part="root" data-orientation="{{stepper.orientation}}" data-disabled="{{stepper.disabled}}">
  <!-- Horizontal Orientation: Scrollable List with Auto-Slide Navigation -->
  <scroll-view wx:if="{{stepper.orientation !== 'vertical'}}" id="{{stepper.listProps.id}}" class="cui-stepper-list {{classes.list}}" role="tablist" scroll-x="{{stepper.listProps['scroll-x']}}" scroll-with-animation="{{stepper.listProps['scroll-with-animation']}}" scroll-left="{{stepper.scrollLeft}}" enhanced="{{stepper.listProps['enhanced']}}" show-scrollbar="{{stepper.listProps['show-scrollbar']}}" aria-orientation="horizontal" data-scope="stepper" data-part="list" data-orientation="horizontal">
    <view class="cui-stepper-header {{classes.header}}">
      <block wx:if="{{hasItems}}">
        <c-stepper-item wx:for="{{stepper.steps}}" wx:key="index" id="{{item.itemProps.id}}" index="{{item.index}}" title="{{item.title}}" description="{{item.description}}" icon="{{item.icon}}" completedIcon="{{item.completedIcon}}" status="{{item.status}}" disabled="{{item.isDisabled}}" value="{{item.value}}" isLast="{{item.isLast}}" orientation="{{stepper.orientation || orientation}}" color="{{stepper.color || color}}" size="{{stepper.size || size}}" ui="{{item.ui || ui}}" data-index="{{item.index}}" bind:tap="handleItemTap" />
      </block>
      <!-- Compound Mode: Declarative <c-stepper-item> children in default slot (hasItems is false) -->
      <slot wx:else />
    </view>
  </scroll-view>
  <!-- Vertical Orientation: Static List -->
  <view wx:else id="{{stepper.listProps.id}}" class="{{classes.list}}" role="tablist" aria-orientation="vertical" data-scope="stepper" data-part="list" data-orientation="vertical">
    <block wx:if="{{hasItems}}">
      <c-stepper-item wx:for="{{stepper.steps}}" wx:key="index" index="{{item.index}}" title="{{item.title}}" description="{{item.description}}" icon="{{item.icon}}" completedIcon="{{item.completedIcon}}" status="{{item.status}}" disabled="{{item.isDisabled}}" value="{{item.value}}" isLast="{{item.isLast}}" orientation="{{stepper.orientation || orientation}}" color="{{stepper.color || color}}" size="{{stepper.size || size}}" ui="{{item.ui || ui}}" data-index="{{item.index}}" bind:tap="handleItemTap" />
    </block>
    <!-- Compound Mode: Declarative <c-stepper-item> children in default slot (hasItems is false) -->
    <slot wx:else />
  </view>
  <!-- Step Content Panel -->
  <view wx:if="{{stepper.hasContent}}" id="{{stepper.contentProps.id}}" class="{{classes.content}}" role="tabpanel" data-scope="stepper" data-part="content">
    <slot name="content" />
  </view>
</view>