<view id="{{cRadio.rootProps.id}}" class="{{classes.root}}" data-scope="radio" data-part="root" data-state="{{cRadio.rootProps['data-state']}}" data-disabled="{{cRadio.rootProps['data-disabled']}}" data-readonly="{{cRadio.rootProps['data-readonly']}}" data-invalid="{{cRadio.rootProps['data-invalid']}}" bind:tap="handleTap">
  <view id="{{cRadio.baseProps.id}}" class="{{classes.base}}" data-scope="radio" data-part="base" data-state="{{cRadio.baseProps['data-state']}}" data-checked="{{cRadio.baseProps['data-checked']}}" data-disabled="{{cRadio.baseProps['data-disabled']}}" data-readonly="{{cRadio.baseProps['data-readonly']}}" data-invalid="{{cRadio.baseProps['data-invalid']}}" aria-role="radio" aria-checked="{{cRadio.baseProps['aria-checked']}}" aria-disabled="{{cRadio.disabled}}" aria-invalid="{{cRadio.invalid}}">
    <slot name="indicator" />
    <view wx:if="{{!slots.indicator}}" class="{{classes.indicator}}" data-scope="radio" data-part="indicator" data-state="{{cRadio.indicatorProps['data-state']}}" data-disabled="{{cRadio.indicatorProps['data-disabled']}}" />
  </view>
  <view wx:if="{{label || description || slots.label || slots.description}}" class="{{classes.wrapper}}">
    <view wx:if="{{label}}" class="{{classes.label}}">{{label}}</view>
    <slot wx:elif="{{slots.label}}" name="label" />
    <view wx:if="{{description}}" class="{{classes.description}}">
      {{description}}
    </view>
    <slot wx:elif="{{slots.description}}" name="description" />
  </view>
  <slot wx:else />
</view>