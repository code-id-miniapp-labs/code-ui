<view id="{{floatingMenu.rootProps.id}}" class="{{classes.root}}" data-scope="floating-menu" data-part="root" data-state="{{floatingMenu.state}}">
  <view id="{{floatingMenu.triggerProps.id}}" class="{{classes.trigger}}" data-scope="floating-menu" data-part="trigger" bindtap="handleTriggerTap">
    <slot name="trigger" />
  </view>
  <root-portal enable="{{portal}}">
    <view class="{{portal ? themeMode : ''}}" style="{{wrapperStyle}}" hidden="{{!floatingMenu.visible}}">
      <view id="{{floatingMenu.backdropProps.id}}" class="{{classes.backdrop}}" data-scope="floating-menu" data-part="backdrop" data-state="{{floatingMenu.open ? 'open' : 'closed'}}" aria-hidden="{{true}}" catchtap="handleBackdropTap" catchtouchmove="noop" />
      <view id="{{floatingMenu.positionerProps.id}}" class="{{classes.positioner}}" style="{{floatingMenu.positionerStyle}}" data-scope="floating-menu" data-part="positioner" data-side="{{floatingMenu.resolvedSide}}" data-align="{{floatingMenu.resolvedAlign}}" data-state="{{floatingMenu.state}}">
        <view id="{{floatingMenu.contentProps.id}}" class="{{classes.content}}" style="{{floatingMenu.contentStyle}}" data-scope="floating-menu" data-part="content" data-side="{{floatingMenu.resolvedSide}}" data-align="{{floatingMenu.resolvedAlign}}" data-state="{{floatingMenu.state}}" aria-hidden="{{!floatingMenu.open}}">
          <view wx:if="{{arrow}}" class="{{classes.arrow}}" style="{{floatingMenu.arrowStyle}}" data-scope="floating-menu" data-part="arrow" data-side="{{floatingMenu.resolvedSide}}" aria-hidden="{{true}}" />
          <view class="relative w-full overflow-hidden" style="max-height: inherit; border-radius: inherit; background-color: inherit;">
            <slot />
          </view>
        </view>
      </view>
    </view>
  </root-portal>
</view>
