<view id="{{cCheckbox.rootProps.id}}" class="{{classes.root}}" data-scope="checkbox" data-part="root" data-state="{{cCheckbox.rootProps['data-state']}}" data-checked="{{cCheckbox.rootProps['data-checked']}}" data-indeterminate="{{cCheckbox.rootProps['data-indeterminate']}}" data-disabled="{{cCheckbox.rootProps['data-disabled']}}" data-readonly="{{cCheckbox.rootProps['data-readonly']}}" data-invalid="{{cCheckbox.rootProps['data-invalid']}}" bind:tap="handleTap">
  <view id="{{cCheckbox.baseProps.id}}" class="{{classes.base}}" data-scope="checkbox" data-part="base" data-state="{{cCheckbox.baseProps['data-state']}}" data-checked="{{cCheckbox.baseProps['data-checked']}}" data-indeterminate="{{cCheckbox.baseProps['data-indeterminate']}}" data-disabled="{{cCheckbox.baseProps['data-disabled']}}" data-readonly="{{cCheckbox.baseProps['data-readonly']}}" data-invalid="{{cCheckbox.baseProps['data-invalid']}}" aria-role="checkbox" aria-checked="{{cCheckbox.baseProps['aria-checked']}}" aria-disabled="{{cCheckbox.disabled}}" aria-invalid="{{cCheckbox.invalid}}">
    <view class="{{classes.indicator}}" data-scope="checkbox" data-part="indicator" data-state="{{cCheckbox.indicatorProps['data-state']}}" data-disabled="{{cCheckbox.indicatorProps['data-disabled']}}">
      <slot name="indicator" />
      <block wx:if="{{!customIndicator}}">
        <block wx:if="{{cCheckbox.indeterminate}}">
          <c-icon name="{{indeterminateIcon || 'minus'}}" className="{{classes.icon}}" />
        </block>
        <block wx:elif="{{cCheckbox.checked}}">
          <c-icon name="{{icon || 'check'}}" className="{{classes.icon}}" />
        </block>
      </block>
    </view>
  </view>
  <view wx:if="{{label || description}}" class="{{classes.wrapper}}">
    <view wx:if="{{label}}" id="{{cCheckbox.labelProps.id}}" class="{{classes.label}}" user-select="{{false}}">
      {{label}}
    </view>
    <view wx:if="{{description}}" class="{{classes.description}}" user-select="{{false}}">
      {{description}}
    </view>
  </view>
  <slot wx:else />
</view>