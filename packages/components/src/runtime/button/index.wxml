<button id="{{button.rootProps.id}}" class="{{classes.root}}" data-scope="button" data-part="root" data-state="{{button.state}}" data-loading="{{button.rootProps['data-loading']}}" data-disabled="{{button.rootProps['data-disabled']}}" disabled="{{formType ? button.rootProps.disabled : false}}" aria-busy="{{button.loading}}" aria-disabled="{{button.disabled}}" open-type="{{openType}}" form-type="{{button.rootProps.formType}}" hover-class="{{hoverClass || (button.rootProps.disabled ? 'none' : '')}}" hover-start-time="{{hoverStartTime}}" hover-stay-time="{{hoverStayTime}}" hover-stop-propagation="{{hoverStopPropagation}}" lang="{{lang}}" session-from="{{sessionFrom}}" send-message-title="{{sendMessageTitle}}" send-message-path="{{sendMessagePath}}" send-message-img="{{sendMessageImg}}" show-message-card="{{showMessageCard}}" app-parameter="{{appParameter}}" catchtap="handleTap" bindgetphonenumber="handleGetPhoneNumber" bindchooseavatar="handleChooseAvatar" bindcontact="handleContact" binderror="handleError" bindopensetting="handleOpenSetting" bindlaunchapp="handleLaunchApp" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">
  <view class="{{classes.spinner}}" data-scope="button" data-part="spinner" aria-hidden="true" wx:if="{{icons.leadingLoading}}">
    <slot wx:if="{{icons.hasLoadingSlot}}" name="loadingIcon" />
    <c-icon wx:else name="{{icons.leadingIconName}}" className="{{classes.spinnerIcon}}" />
  </view>
  <view class="{{classes.icon}}" data-scope="button" data-part="icon" aria-hidden="true" wx:elif="{{icons.isLeading}}">
    <slot wx:if="{{slots.icon}}" name="icon" />
    <slot wx:elif="{{slots.leading}}" name="leading" />
    <c-icon wx:elif="{{icons.leadingIconName}}" name="{{icons.leadingIconName}}" className="{{classes.iconInner}}" />
  </view>
  <view wx:if="{{label || slots.default}}" class="{{classes.label}}" data-scope="button" data-part="label">
    <text wx:if="{{label}}">{{label}}</text>
    <slot wx:else />
  </view>
  <view class="{{classes.spinner}}" data-scope="button" data-part="spinner" aria-hidden="true" wx:if="{{icons.trailingLoading}}">
    <slot wx:if="{{icons.hasLoadingSlot}}" name="loadingIcon" />
    <c-icon wx:else name="{{icons.trailingIconName}}" className="{{classes.spinnerIcon}}" />
  </view>
  <view class="{{classes.icon}}" data-scope="button" data-part="trailing-icon" aria-hidden="true" wx:elif="{{!button.loading && icons.isTrailing}}">
    <slot wx:if="{{icons.hasTrailingSlot}}" name="trailing" />
    <c-icon wx:elif="{{icons.trailingIconName}}" name="{{icons.trailingIconName}}" className="{{classes.iconInner}}" />
  </view>
</button>