<view class="{{classes.root}}" data-scope="checkbox-group" data-part="root" aria-role="group" aria-disabled="{{cCheckboxGroup.disabled}}" aria-invalid="{{cCheckboxGroup.invalid}}" aria-required="{{required}}">
  <view wx:if="{{legend}}" class="{{classes.legend}}">
    {{legend}}
  </view>
  <slot wx:else name="legend" />
  <view class="{{classes.fieldset}}">
    <block wx:if="{{cCheckboxGroup.items && cCheckboxGroup.items.length > 0}}">
      <c-checkbox wx:for="{{cCheckboxGroup.items}}" wx:key="value" value="{{item.value}}" label="{{item.label}}" description="{{item.description}}" disabled="{{item.disabled}}" checked="{{item.checked}}" variant="{{item.variant || variant}}" color="{{item.color || color}}" size="{{cCheckboxGroup.size || size}}" ui="{{item.ui || ui}}" bind:change="handleItemTap" data-value="{{item.value}}" />
    </block>
    <slot />
  </view>
</view>