<view id="{{cCheckboxGroup.rootProps.id}}" class="{{classes.root}}" data-scope="checkbox-group" data-part="root" aria-role="group" aria-disabled="{{cCheckboxGroup.disabled}}" aria-invalid="{{cCheckboxGroup.invalid}}" aria-required="{{required}}">
  <view wx:if="{{legend}}" class="{{classes.legend}}">
    {{legend}}
  </view>
  <slot wx:else name="legend" />
  <view class="{{classes.fieldset}}">
    <block wx:if="{{resolvedItems.length > 0}}">
      <c-checkbox wx:for="{{resolvedItems}}" wx:key="value" value="{{item.value}}" label="{{item.label}}" description="{{item.description}}" disabled="{{item.disabled}}" checked="{{item.checked}}" variant="{{item.variant}}" color="{{item.color}}" size="{{item.size}}" ui="{{item.ui}}" bind:change="handleItemTap" />
    </block>
    <slot />
  </view>
</view>