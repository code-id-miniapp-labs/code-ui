<view
  id="{{progress.rootProps.id}}"
  class="{{classes.root}}"
  data-scope="progress"
  data-part="root"
  data-state="{{progress.progressState}}"
  data-orientation="{{orientation}}"
  data-type="{{type}}"
  aria-role="progressbar"
  aria-valuemin="{{progress.min}}"
  aria-valuemax="{{progress.max}}"
  aria-valuenow="{{progress.isIndeterminate ? undefined : progress.value}}"
  aria-valuetext="{{progress.valueAsString}}"
>
  <view wx:if="{{type !== 'circular' && (label || showValue || slots.label || slots.valueText)}}" class="{{classes.header}}">
    <text wx:if="{{label}}" id="{{progress.labelProps.id}}" class="{{classes.label}}" data-scope="progress" data-part="label">{{label}}</text>
    <slot wx:else name="label" />

    <text wx:if="{{showValue}}" class="{{classes.valueText}}" data-scope="progress" data-part="value-text">{{progress.valueAsString}}</text>
    <slot wx:else name="value-text" />
  </view>

  <block wx:if="{{type !== 'circular'}}">
    <view
      class="{{classes.track}}"
      data-scope="progress"
      data-part="track"
      data-state="{{progress.progressState}}"
      data-orientation="{{orientation}}"
    >
      <view
        class="{{classes.range}}"
        data-scope="progress"
        data-part="range"
        data-state="{{progress.progressState}}"
        data-orientation="{{orientation}}"
        style="{{rangeStyle}}"
      />
    </view>
  </block>

  <block wx:else>
    <view
      class="{{classes.view}}"
      data-scope="progress"
      data-part="view"
      data-state="{{progress.progressState}}"
    >
      <view
        class="cui-progress-circle {{classes.circle}} {{classes.circleRange}} {{inverted ? 'cui-progress-circle-inverted' : ''}} {{progress.isIndeterminate ? 'cui-progress-circle-indeterminate' : ''}}"
        data-scope="progress"
        data-part="circle"
        data-state="{{progress.progressState}}"
        style="{{circleStyle}}"
      />
      <view wx:if="{{showValue}}" class="{{classes.circleOverlay}}">
        <text class="{{classes.valueText}}" data-scope="progress" data-part="value-text">{{progress.valueAsString}}</text>
      </view>
      <view wx:else class="{{classes.circleContent}}">
        <slot />
      </view>
    </view>
  </block>

  <slot wx:if="{{type !== 'circular'}}" />
</view>
