<view
  id="{{cSwitch.rootProps.id}}"
  class="{{classes.root}}"
  data-scope="switch"
  data-part="root"
  data-state="{{cSwitch.state}}"
  data-checked="{{cSwitch.rootProps['data-checked']}}"
  data-disabled="{{cSwitch.rootProps['data-disabled']}}"
  data-readonly="{{cSwitch.rootProps['data-readonly']}}"
  data-loading="{{cSwitch.rootProps['data-loading']}}"
  data-invalid="{{cSwitch.rootProps['data-invalid']}}"
  role="group"
  aria-disabled="{{cSwitch.rootProps['aria-disabled']}}"
  aria-invalid="{{cSwitch.rootProps['aria-invalid']}}"
  catchtap="handleTap"
>
  <view
    id="{{cSwitch.containerProps.id}}"
    class="{{classes.container}}"
    data-scope="switch"
    data-part="container"
  >
    <view
      id="{{cSwitch.baseProps.id}}"
      class="{{classes.base}}"
      data-scope="switch"
      data-part="base"
      data-state="{{cSwitch.state}}"
      data-checked="{{cSwitch.baseProps['data-checked']}}"
      data-disabled="{{cSwitch.baseProps['data-disabled']}}"
      data-readonly="{{cSwitch.baseProps['data-readonly']}}"
      data-loading="{{cSwitch.baseProps['data-loading']}}"
      data-invalid="{{cSwitch.baseProps['data-invalid']}}"
      role="switch"
      aria-checked="{{cSwitch.baseProps['aria-checked']}}"
      aria-disabled="{{cSwitch.baseProps['aria-disabled']}}"
      aria-invalid="{{cSwitch.baseProps['aria-invalid']}}"
    >
      <view
        id="{{cSwitch.thumbProps.id}}"
        class="{{classes.thumb}}"
        data-scope="switch"
        data-part="thumb"
        data-state="{{cSwitch.state}}"
        data-checked="{{cSwitch.thumbProps['data-checked']}}"
        data-disabled="{{cSwitch.thumbProps['data-disabled']}}"
        data-loading="{{cSwitch.thumbProps['data-loading']}}"
        aria-hidden="true"
      >
        <view
          wx:if="{{loading}}"
          class="{{loadingIcon || 'w-2.5 h-2.5 rounded-full border-2 border-neutral-400 border-t-transparent animate-spin'}}"
        />
        <text
          wx:elif="{{cSwitch.checked && checkedIcon}}"
          class="{{classes.icon}} {{checkedIcon}}"
        />
        <text
          wx:elif="{{!cSwitch.checked && uncheckedIcon}}"
          class="{{classes.icon}} {{uncheckedIcon}}"
        />
        <slot wx:else name="thumb" />
      </view>
    </view>
  </view>

  <view
    wx:if="{{label || description}}"
    class="{{classes.wrapper}}"
    data-scope="switch"
    data-part="wrapper"
  >
    <text
      wx:if="{{label}}"
      id="{{cSwitch.labelProps.id}}"
      class="{{classes.label}}"
      data-scope="switch"
      data-part="label"
      data-disabled="{{cSwitch.labelProps['data-disabled']}}"
    >{{label}}</text>
    <text
      wx:if="{{description}}"
      id="{{cSwitch.descriptionProps.id}}"
      class="{{classes.description}}"
      data-scope="switch"
      data-part="description"
      data-disabled="{{cSwitch.descriptionProps['data-disabled']}}"
    >{{description}}</text>
  </view>

  <slot />
</view>
