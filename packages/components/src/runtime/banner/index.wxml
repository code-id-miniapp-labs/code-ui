<view wx:if="{{banner.visible}}" id="{{banner.rootProps.id}}" class="cui-banner-root {{classes.root}}" style="{{rootStyle}}" aria-role="region" aria-live="polite" data-scope="banner" data-part="root" data-id="{{banner.rootProps.id}}" data-state="{{banner.state}}" data-color="{{color}}" data-variant="{{variant}}" data-size="{{size}}" data-placement="{{placement}}" data-mode="{{mode}}" data-image-position="{{imagePosition}}" hover-class="{{hoverClass}}" bindtap="handleTap">
  <view class="cui-banner-background {{classes.background}}" data-scope="banner" data-part="background">
    <view class="cui-banner-body {{classes.body}}" data-scope="banner" data-part="body">
      <view wx:if="{{image && imagePosition === 'background'}}" class="cui-banner-image-area {{classes.imageArea}}" data-scope="banner" data-part="imageArea">
        <image class="{{classes.image}}" src="{{image}}" mode="{{imageMode}}" data-scope="banner" data-part="image" aria-hidden="true" />
      </view>
      <view wx:if="{{image && imagePosition === 'left'}}" class="cui-banner-image-area {{classes.imageArea}}" data-scope="banner" data-part="imageArea">
        <image class="{{classes.image}}" src="{{image}}" mode="{{imageMode}}" data-scope="banner" data-part="image" aria-hidden="true" />
      </view>
      <c-icon wx:if="{{icon}}" name="{{icon}}" className="{{classes.icon}}" />
      <slot wx:else name="leading" />
      <view class="cui-banner-content {{classes.content}}" data-scope="banner" data-part="content">
        <view wx:if="{{resolvedBadge}}" class="cui-banner-badge {{classes.badge}}" data-scope="banner" data-part="badge">
          <c-badge label="{{resolvedBadge.label}}" color="{{resolvedBadge.color}}" variant="{{resolvedBadge.variant}}" size="{{resolvedBadge.size}}" ui="{{resolvedBadge.ui}}" className="{{resolvedBadge.className}}" />
        </view>
        <slot wx:else name="badge" />
        <view wx:if="{{caption}}" class="{{classes.caption}}" data-scope="banner" data-part="caption">
          {{caption}}
        </view>
        <slot wx:else name="caption" />
        <view wx:if="{{title}}" class="{{classes.title}}" data-scope="banner" data-part="title">
          {{title}}
        </view>
        <slot wx:else name="title" />
        <view wx:if="{{description}}" class="{{classes.description}}" data-scope="banner" data-part="description">
          {{description}}
        </view>
        <slot wx:else name="description" />
        <slot />
      </view>
      <view wx:if="{{image && (imagePosition === 'right' || imagePosition === 'none')}}" class="cui-banner-image-area {{classes.imageArea}}" data-scope="banner" data-part="imageArea">
        <image class="{{classes.image}}" src="{{image}}" mode="{{imageMode}}" data-scope="banner" data-part="image" aria-hidden="true" />
      </view>
      <slot wx:else name="image" />
      <view wx:if="{{resolvedMore || resolvedClose || slots.close || slots.more}}" class="cui-banner-button-area {{classes.buttonArea}}" data-scope="banner" data-part="buttonArea">
        <view wx:if="{{slots.close}}" class="{{classes.close}}" data-scope="banner" data-part="close" aria-role="button" aria-label="Dismiss" catchtap="handleCloseTap">
          <slot name="close" />
        </view>
        <c-button wx:elif="{{resolvedClose}}" label="{{resolvedClose.label || ''}}" icon="{{resolvedClose.icon || ''}}" leading-icon="{{resolvedClose.leadingIcon || ''}}" trailing-icon="{{resolvedClose.trailingIcon || ''}}" loading="{{resolvedClose.loading || false}}" loading-icon="{{resolvedClose.loadingIcon || 'loading'}}" disabled="{{resolvedClose.disabled || false}}" color="{{resolvedClose.color}}" variant="{{resolvedClose.variant}}" size="{{resolvedClose.size}}" ui="{{resolvedClose.ui}}" className="{{resolvedClose.className}}" data-scope="banner" data-part="close" aria-label="Dismiss" catch:tap="handleCloseTap" />
        <view wx:if="{{slots.more}}" class="{{classes.more}}" data-scope="banner" data-part="more" aria-role="button" aria-label="More" catchtap="handleMoreTap">
          <slot name="more" />
        </view>
        <c-button wx:elif="{{resolvedMore}}" label="{{resolvedMore.label || ''}}" icon="{{resolvedMore.icon || ''}}" leading-icon="{{resolvedMore.leadingIcon || ''}}" trailing-icon="{{resolvedMore.trailingIcon || ''}}" loading="{{resolvedMore.loading || false}}" loading-icon="{{resolvedMore.loadingIcon || 'loading'}}" disabled="{{resolvedMore.disabled || false}}" color="{{resolvedMore.color}}" variant="{{resolvedMore.variant}}" size="{{resolvedMore.size}}" ui="{{resolvedMore.ui}}" className="{{resolvedMore.className}}" data-scope="banner" data-part="more" aria-label="More" catch:tap="handleMoreTap" />
      </view>
      <slot wx:else name="buttonArea" />
    </view>
    <view wx:if="{{resolvedActions.length > 0}}" class="{{classes.actions}}" data-scope="banner" data-part="actions">
      <block wx:for="{{resolvedActions}}" wx:key="index">
        <view class="{{classes.action}}" data-scope="banner" data-part="action">
          <c-button data-index="{{item.index}}" block="{{true}}" label="{{item.label}}" icon="{{item.icon || ''}}" leading-icon="{{item.leadingIcon || ''}}" trailing-icon="{{item.trailingIcon || ''}}" loading="{{item.loading}}" loading-icon="{{item.loadingIcon}}" disabled="{{item.disabled}}" variant="{{item.variant}}" color="{{item.color}}" size="{{item.size}}" ui="{{item.ui}}" className="{{item.className}}" catch:tap="handleActionTap" />
        </view>
      </block>
    </view>
    <slot wx:else name="actions" />
  </view>
</view>