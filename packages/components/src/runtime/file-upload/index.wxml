<view id="{{fileUpload.rootProps.id}}" class="{{classes.root}}" data-scope="file-upload" data-part="root" data-state="{{fileUpload.state}}" data-disabled="{{fileUpload.disabled}}" data-readonly="{{fileUpload.readOnly}}" data-invalid="{{fileUpload.invalid}}" data-max="{{fileUpload.isMaxFiles}}" aria-role="group" aria-disabled="{{fileUpload.disabled}}" aria-invalid="{{fileUpload.invalid}}">
  <!-- Dropzone Area -->
  <view wx:if="{{dropzone && !fileUpload.isMaxFiles}}" id="{{fileUpload.dropzoneProps.id}}" class="{{classes.dropzone}}" data-scope="file-upload" data-part="dropzone" data-state="{{fileUpload.state}}" data-disabled="{{fileUpload.disabled || fileUpload.isMaxFiles}}" data-readonly="{{fileUpload.readOnly}}" data-max="{{fileUpload.isMaxFiles}}" aria-role="button" aria-disabled="{{fileUpload.disabled || fileUpload.isMaxFiles}}" aria-busy="{{fileUpload.isUploading}}" aria-label="{{dropzoneAriaLabel}}" bindtap="handleDropzoneTap">
    <view class="{{classes.icon}}" data-scope="file-upload" data-part="icon" aria-hidden="true" wx:if="{{fileUpload.isUploading && loadingIcon}}">
      <c-icon name="{{loadingIcon}}" className="w-full h-full animate-spin" />
    </view>
    <view class="{{classes.icon}}" data-scope="file-upload" data-part="icon" aria-hidden="true" wx:elif="{{icon}}">
      <c-icon name="{{icon}}" className="w-full h-full" />
    </view>
    <slot name="icon" wx:else />
    <view class="{{classes.content}}" data-scope="file-upload" data-part="content">
      <view wx:if="{{title}}" class="{{classes.title}}" data-scope="file-upload" data-part="title">
        {{title}}
      </view>
      <slot name="title" wx:else />
      <view wx:if="{{description}}" class="{{classes.description}}" data-scope="file-upload" data-part="description">
        {{description}}
      </view>
      <slot name="description" wx:else />
    </view>
    <slot />
  </view>
  <!-- File List Area -->
  <view wx:if="{{fileUpload.hasFiles}}" id="{{fileUpload.fileListProps.id}}" class="{{classes.fileList}}" data-scope="file-upload" data-part="file-list" data-layout="{{layout || 'list'}}" aria-role="list" aria-label="Uploaded files">
    <block wx:for="{{fileUpload.files}}" wx:key="id">
      <view id="{{item.itemProps.id}}" class="{{classes.file}}" data-scope="file-upload" data-part="file" data-index="{{index}}" data-status="{{item.status}}" aria-role="listitem" bindtap="handleFileClick">
        <!-- File Leading: Image Thumbnail or Icon -->
        <view class="{{classes.fileLeading}}" data-scope="file-upload" data-part="file-leading" data-index="{{index}}" bindtap="handlePreview" aria-role="button" aria-label="Preview {{item.name}}">
          <image wx:if="{{item.fileType === 'image' && item.thumb}}" src="{{item.thumb}}" mode="aspectFill" class="w-full h-full rounded-lg object-cover" />
          <c-icon wx:elif="{{item.fileType === 'image' && imageIcon}}" name="{{imageIcon}}" className="{{classes.fileIcon}}" />
          <c-icon wx:elif="{{item.fileType === 'video' && videoIcon}}" name="{{videoIcon}}" className="{{classes.fileIcon}}" />
          <c-icon wx:elif="{{item.fileType === 'audio' && audioIcon}}" name="{{audioIcon}}" className="{{classes.fileIcon}}" />
          <c-icon wx:elif="{{fileIcon}}" name="{{fileIcon}}" className="{{classes.fileIcon}}" />
        </view>
        <!-- File Content: Name and Formatted Size -->
        <view class="{{classes.fileContent}}" data-scope="file-upload" data-part="file-content" data-index="{{index}}" bindtap="handlePreview">
          <view class="{{classes.fileName}}" data-scope="file-upload" data-part="file-name">
            {{item.name}}
          </view>
          <view class="{{classes.fileSize}}" data-scope="file-upload" data-part="file-size">
            {{item.formattedSize}}
          </view>
          <view wx:if="{{(fileUpload.isUploading || (item.progress !== null && item.progress !== undefined))}}" class="{{classes.fileProgress}}" data-scope="file-upload" data-part="file-progress">
            <c-progress value="{{item.progress != null ? item.progress : progress}}" size="2xs" color="{{color}}" />
          </view>
        </view>
        <view wx:if="{{!fileUpload.disabled && !fileUpload.readOnly}}" class="{{classes.fileTrailing}}" data-scope="file-upload" data-part="file-trailing">
          <view wx:if="{{deleteIcon}}" class="{{classes.fileRemove}}" data-scope="file-upload" data-part="file-remove" data-index="{{index}}" aria-role="button" aria-label="Remove {{item.name}}" catchtap="handleRemove">
            <c-icon name="{{deleteIcon}}" className="w-4 h-4" />
          </view>
        </view>
      </view>
    </block>
  </view>
</view>