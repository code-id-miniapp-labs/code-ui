@keyframes cui-modal-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@-webkit-keyframes cui-modal-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes cui-modal-pop-in {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(8px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@-webkit-keyframes cui-modal-pop-in {
  from {
    opacity: 0;
    -webkit-transform: scale(0.92) translateY(8px);
    transform: scale(0.92) translateY(8px);
  }
  to {
    opacity: 1;
    -webkit-transform: scale(1) translateY(0);
    transform: scale(1) translateY(0);
  }
}

@keyframes cui-modal-slide-up {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@-webkit-keyframes cui-modal-slide-up {
  from {
    opacity: 0;
    -webkit-transform: translateY(100%);
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    -webkit-transform: translateY(0);
    transform: translateY(0);
  }
}

.cui-modal-overlay-enter {
  -webkit-animation: cui-modal-fade-in 260ms ease-out;
  animation: cui-modal-fade-in 260ms ease-out;
}

.cui-modal-content-enter {
  -webkit-animation: cui-modal-pop-in 300ms cubic-bezier(0.32, 0.72, 0, 1);
  animation: cui-modal-pop-in 300ms cubic-bezier(0.32, 0.72, 0, 1);
}

.cui-modal-fullscreen-enter {
  -webkit-animation: cui-modal-slide-up 320ms cubic-bezier(0.32, 0.72, 0, 1);
  animation: cui-modal-slide-up 320ms cubic-bezier(0.32, 0.72, 0, 1);
}
