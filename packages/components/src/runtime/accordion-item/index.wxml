<view
  id="{{cAccordionItem.itemProps.id}}"
  class="cui-accordion-item {{classes.root}}"
  data-scope="accordion"
  data-part="item"
  data-value="{{cAccordionItem.resolvedValue}}"
  data-state="{{cAccordionItem.isOpen ? 'open' : 'closed'}}"
  data-disabled="{{cAccordionItem.disabled}}"
>
  <view class="{{classes.header}}" data-scope="accordion" data-part="header">
    <view
      id="{{cAccordionItem.triggerProps.id}}"
      class="{{classes.trigger}}"
      aria-role="button"
      aria-expanded="{{cAccordionItem.isOpen}}"
      aria-disabled="{{cAccordionItem.disabled}}"
      data-scope="accordion"
      data-part="trigger"
      data-value="{{cAccordionItem.resolvedValue}}"
      data-state="{{cAccordionItem.isOpen ? 'open' : 'closed'}}"
      data-disabled="{{cAccordionItem.disabled}}"
      bind:tap="handleTap"
    >
      <!-- Leading element / icon -->
      <view wx:if="{{icons.isLeading}}" class="{{classes.leading}}" data-scope="accordion" data-part="leading">
        <slot wx:if="{{icons.hasLeadingSlot}}" name="leading" />
        <c-icon wx:elif="{{icons.leadingIconName}}" name="{{icons.leadingIconName}}" className="{{classes.leadingIcon}}" />
      </view>

      <!-- Label / Title -->
      <view class="{{classes.label}}" data-scope="accordion" data-part="label">
        <view wx:if="{{label}}">{{label}}</view>
        <slot wx:else name="label" />
        <view wx:if="{{description}}" class="{{classes.description}}" data-scope="accordion" data-part="description">
          {{description}}
        </view>
        <slot wx:else name="description" />
      </view>

      <!-- Trailing icon / chevron -->
      <view class="{{classes.trailing}}" data-scope="accordion" data-part="trailing">
        <slot wx:if="{{icons.hasTrailingSlot}}" name="trailing" />
        <c-icon
          wx:elif="{{icons.trailingIconName}}"
          name="{{icons.trailingIconName}}"
          className="{{classes.trailingIcon}}"
        />
      </view>
    </view>
  </view>

  <!-- Content Panel -->
  <view
    id="{{cAccordionItem.contentProps.id}}"
    class="{{classes.content}}"
    style="{{cAccordionItem.contentStyle}}"
    aria-role="region"
    aria-labelledby="{{cAccordionItem.triggerProps.id}}"
    data-scope="accordion"
    data-part="content"
    data-value="{{cAccordionItem.resolvedValue}}"
    data-state="{{cAccordionItem.isOpen ? 'open' : 'closed'}}"
  >
    <view class="cui-accordion-body {{classes.body}}" data-scope="accordion" data-part="body">
      <block wx:if="{{content}}">
        {{content}}
      </block>
      <slot wx:else name="content" />
      <slot />
    </view>
  </view>
</view>

