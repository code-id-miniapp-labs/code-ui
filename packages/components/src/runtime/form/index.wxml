<form id="{{form.rootProps.id}}" class="{{classes.root}}" data-scope="form" data-part="root" data-state="{{form.state}}" data-valid="{{form.isValid}}" data-invalid="{{form.hasErrors}}" data-dirty="{{form.isDirty}}" data-touched="{{form.isTouched}}" data-validating="{{form.isValidating}}" data-submitting="{{form.isSubmitting}}" data-disabled="{{form.disabled}}" data-readonly="{{form.readOnly}}" aria-disabled="{{form.disabled}}" aria-invalid="{{form.hasErrors}}" bindsubmit="handleSubmit" bindreset="handleReset">
  <slot />
  <view wx:if="{{showErrors && form.hasErrors}}" class="{{classes.errors}}" data-scope="form" data-part="errors" data-invalid="{{form.hasErrors}}" aria-role="alert" aria-live="polite">
    <text wx:for="{{form.errorItems}}" wx:key="name" id="{{item.errorProps.id}}" class="{{classes.error}}" data-scope="form" data-part="error" data-field="{{item.name}}" aria-role="alert">
      {{item.message}}
    </text>
  </view>
</form>