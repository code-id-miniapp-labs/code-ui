<view id="{{tabs.rootProps.id}}" class="{{classes.root}}" data-scope="tabs" data-part="root" data-orientation="{{orientation}}" data-disabled="{{tabs.disabled}}">
  <!-- Horizontal Orientation: Scrollable Tablist -->
  <scroll-view
    wx:if="{{orientation !== 'vertical'}}"
    class="cui-tabs-scroll {{classes.scroll}}"
    scroll-x="{{true}}"
    scroll-with-animation="{{true}}"
    scroll-into-view="{{tabs.activeTriggerId}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view
      id="{{tabs.listProps.id}}"
      class="cui-tabs-list {{classes.list}}"
      aria-role="tablist"
      aria-orientation="horizontal"
      data-scope="tabs"
      data-part="list"
      data-orientation="horizontal"
    >
      <view
        wx:for="{{resolvedItems}}"
        wx:key="value"
        id="{{item.triggerProps.id}}"
        class="{{classes.itemWrapper}}"
      >
        <c-tabs-item
          mode="trigger"
          value="{{item.value}}"
          label="{{item.label}}"
          icon="{{item.icon}}"
          trailingIcon="{{item.trailingIcon}}"
          disabled="{{item.disabled}}"
          selected="{{item.isSelected}}"
          orientation="{{orientation}}"
          variant="{{variant}}"
          color="{{color}}"
          size="{{size}}"
          fitted="{{fitted}}"
          index="{{index}}"
          ui="{{item.ui}}"
          bind:select="handleItemSelect"
        >
          <slot name="leading-{{item.value}}" slot="leading" />
          <slot name="trailing-{{item.value}}" slot="trailing" />
        </c-tabs-item>
      </view>
      <slot name="list-trailing" />
    </view>
  </scroll-view>

  <!-- Vertical Orientation: Static Tablist -->
  <view
    wx:else
    id="{{tabs.listProps.id}}"
    class="cui-tabs-list {{classes.list}}"
    aria-role="tablist"
    aria-orientation="vertical"
    data-scope="tabs"
    data-part="list"
    data-orientation="vertical"
  >
    <c-tabs-item
      wx:for="{{resolvedItems}}"
      wx:key="value"
      mode="trigger"
      triggerId="{{item.triggerProps.id}}"
      value="{{item.value}}"
      label="{{item.label}}"
      icon="{{item.icon}}"
      trailingIcon="{{item.trailingIcon}}"
      disabled="{{item.disabled}}"
      selected="{{item.isSelected}}"
      orientation="{{orientation}}"
      variant="{{variant}}"
      color="{{color}}"
      size="{{size}}"
      fitted="{{fitted}}"
      index="{{index}}"
      ui="{{item.ui}}"
      bind:select="handleItemSelect"
    >
      <slot name="leading-{{item.value}}" slot="leading" />
      <slot name="trailing-{{item.value}}" slot="trailing" />
    </c-tabs-item>
    <slot name="list-trailing" />
  </view>

  <!-- Content Container -->
  <view class="cui-tabs-content {{classes.content}}">
    <!-- Items Mode: rendered when items prop is passed, calling c-tabs-item -->
    <block wx:if="{{hasItems}}">
      <c-tabs-item
        wx:for="{{resolvedItems}}"
        wx:key="value"
        mode="panel"
        value="{{item.value}}"
        label="{{item.label}}"
        icon="{{item.icon}}"
        trailingIcon="{{item.trailingIcon}}"
        disabled="{{item.disabled}}"
        selected="{{item.isSelected}}"
        orientation="{{orientation}}"
        variant="{{variant}}"
        color="{{color}}"
        size="{{size}}"
        fitted="{{fitted}}"
        index="{{index}}"
        ui="{{item.ui}}"
      >
        <text wx:if="{{item.content}}">{{item.content}}</text>
        <slot wx:else name="{{item.value}}" />
      </c-tabs-item>
    </block>
    <!-- Compound Mode: Declarative <c-tabs-item> children in default slot -->
    <slot wx:else />
  </view>
</view>
