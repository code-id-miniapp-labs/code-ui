<view class="{{ classes.root }}" style="{{ rootStyle }}" data-scope="app" data-part="root" data-locked="{{ locked }}" data-scaled="{{ scaled }}" data-safe-area="{{ safeArea || 'none' }}">
  <view id="cui-page-scale" class="{{ classes.scaleWrapper }}" style="{{ scaleWrapperStyle }}" data-part="scale-wrapper">
    <slot />
  </view>
  <slot name="overlay" />
  <!-- Injected Toast Stack -->
  <view wx:if="{{ toasts && toasts.length > 0 }}" class="{{ classes.toaster }}">
    <c-toast wx:for="{{ toasts }}" wx:key="id" id="{{ item.id }}" data-id="{{ item.id }}" index="{{ item.stackIndex !== undefined ? item.stackIndex : index }}" offset="{{ item.offset !== undefined ? item.offset : 0 }}" mode="{{ item.mode || 'default' }}" color="{{ item.color || 'neutral' }}" variant="{{ item.variant || 'outline' }}" orientation="{{ item.orientation || 'horizontal' }}" placement="{{ item.placement || 'top' }}" title="{{ item.title }}" description="{{ item.description }}" icon="{{ item.icon }}" duration="{{ item.duration !== undefined ? item.duration : 4000 }}" progress="{{ item.progress !== false }}" progress-position="{{ item.progressPosition || 'bottom' }}" open="{{ item.open }}" close="{{ item.close !== false }}" close-icon="{{ item.closeIcon }}" actions="{{ item.actions }}" ui="{{ item.ui }}" class-name="{{ item.className }}" bind:dismiss="handleToastDismiss" bind:action="handleToastAction" />
  </view>
</view>