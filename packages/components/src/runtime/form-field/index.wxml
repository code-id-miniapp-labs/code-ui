<view class="{{classes.root}}" id="{{formField.rootProps.id}}" data-scope="form-field" data-part="root" data-name="{{name}}" data-disabled="{{formField.disabled}}" data-invalid="{{formField.invalid}}">
  <view wx:if="{{label || description || hint}}" class="{{classes.wrapper}}" data-scope="form-field" data-part="wrapper">
    <view wx:if="{{label || hint}}" class="{{classes.labelWrapper}}" data-scope="form-field" data-part="label-wrapper">
      <view class="flex items-center gap-1">
        <slot name="label" />
        <text wx:if="{{label}}" class="{{classes.label}}" id="{{formField.labelProps.id}}" data-scope="form-field" data-part="label">{{label}}</text>
        <text wx:if="{{required}}" class="{{classes.required}}" data-scope="form-field" data-part="required" aria-hidden="true">*</text>
      </view>
      <slot name="hint" />
      <text wx:if="{{hint}}" class="{{classes.hint}}" data-scope="form-field" data-part="hint">{{hint}}</text>
    </view>
    <slot name="description" />
    <text wx:if="{{description}}" class="{{classes.description}}" data-scope="form-field" data-part="description">{{description}}</text>
  </view>

  <view class="{{classes.container}}" data-scope="form-field" data-part="container" data-invalid="{{formField.invalid}}">
    <slot />
  </view>

  <slot name="error" />
  <slot name="help" />
  <text wx:if="{{formField.displayError || displayError}}" class="{{classes.error}}" id="{{formField.errorProps.id}}" data-scope="form-field" data-part="error" aria-role="alert" aria-live="polite">{{formField.displayError || displayError}}</text>
  <text wx:elif="{{formField.displayHelp || displayHelp}}" class="{{classes.help}}" data-scope="form-field" data-part="help">{{formField.displayHelp || displayHelp}}</text>
</view>
