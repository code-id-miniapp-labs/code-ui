<view id="{{input.rootProps.id}}" class="{{classes.root}}" data-scope="input" data-part="root" data-state="{{input.state}}" data-empty="{{input.isEmpty}}" data-disabled="{{input.disabled}}" data-readonly="{{input.readOnly}}" data-invalid="{{input.invalid}}" aria-role="group" aria-disabled="{{input.disabled}}" aria-invalid="{{input.invalid}}">
  <view class="{{classes.base}}" data-scope="input" data-part="base" data-state="{{input.state}}" data-empty="{{input.isEmpty}}" data-focused="{{input.inputProps.focus}}" data-disabled="{{input.disabled}}" data-readonly="{{input.readOnly}}" data-invalid="{{input.invalid}}">
    <view wx:if="{{icons.isLeading}}" class="{{classes.leading}}" data-scope="input" data-part="leading" aria-hidden="true">
      <slot wx:if="{{icons.hasLeadingSlot}}" name="leading"></slot>
      <view wx:if="{{icons.leadingIconName && !icons.hasLeadingSlot}}" class="{{classes.leadingIcon}}">
        <c-icon name="{{icons.leadingIconName}}" className="{{classes.iconInner}}"></c-icon>
      </view>
    </view>
    <input id="{{input.inputProps.id}}" name="{{name}}" class="{{classes.nativeInput}}" value="{{input.value}}" focus="{{input.inputProps.focus}}" disabled="{{input.inputProps.disabled}}" type="{{type}}" password="{{password}}" placeholder="{{placeholder}}" placeholder-class="{{classes.placeholder}}" placeholder-style="{{placeholderStyle}}" maxlength="{{maxlength}}" cursor-spacing="{{cursorSpacing}}" confirm-type="{{confirmType}}" confirm-hold="{{confirmHold}}" cursor="{{cursor}}" selection-start="{{selectionStart}}" selection-end="{{selectionEnd}}" adjust-position="{{adjustPosition}}" hold-keyboard="{{holdKeyboard}}" aria-invalid="{{input.invalid}}" data-scope="input" data-part="native-input" data-state="{{input.state}}" data-empty="{{input.isEmpty}}" data-focused="{{input.inputProps.focus}}" data-disabled="{{input.disabled}}" data-readonly="{{input.readOnly}}" data-invalid="{{input.invalid}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" bindconfirm="handleConfirm" bindkeyboardheightchange="handleKeyboardHeightChange"></input>
    <view wx:if="{{icons.isTrailing || input.isClearable}}" class="{{classes.trailing}}" data-scope="input" data-part="trailing" aria-hidden="true">
      <view wx:if="{{icons.trailingLoading}}" class="{{classes.trailingIcon}}">
        <slot wx:if="{{icons.hasLoadingSlot}}" name="loadingIcon"></slot>
        <c-icon wx:else name="{{icons.trailingIconName}}" className="{{classes.loadingIcon}}"></c-icon>
      </view>
      <view wx:elif="{{input.isClearable}}" class="{{classes.trailingIcon}}" data-scope="input" data-part="clear" aria-role="button" aria-label="Clear input" catchtap="handleClear">
        <c-icon name="{{clearIcon}}" className="{{classes.iconInner}}"></c-icon>
      </view>
      <view wx:elif="{{icons.trailingIconName && !icons.hasTrailingSlot}}" class="{{classes.trailingIcon}}">
        <c-icon name="{{icons.trailingIconName}}" className="{{classes.iconInner}}"></c-icon>
      </view>
      <slot wx:if="{{icons.hasTrailingSlot}}" name="trailing"></slot>
    </view>
  </view>
</view>