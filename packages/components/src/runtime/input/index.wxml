<view
  id="{{input.rootProps.id}}"
  class="{{classes.root}}"
  data-scope="input"
  data-part="root"
  data-state="{{input.state}}"
  data-disabled="{{input.rootProps['data-disabled']}}"
  data-readonly="{{input.rootProps['data-readonly']}}"
  data-invalid="{{input.rootProps['data-invalid']}}"
  role="group"
  aria-disabled="{{input.rootProps['aria-disabled']}}"
  aria-invalid="{{input.rootProps['aria-invalid']}}"
>
  <view
    wx:if="{{leading || leadingIcon}}"
    id="{{input.leadingProps.id}}"
    class="{{classes.leading}}"
    data-scope="input"
    data-part="leading"
  >
    <slot name="leading" />
    <text wx:if="{{leadingIcon}}" class="{{classes.leadingIcon}} {{leadingIcon}}" />
  </view>

  <input
    id="{{input.inputProps.id}}"
    name="{{name}}"
    class="{{classes.base}}"
    data-scope="input"
    data-part="base"
    data-state="{{input.state}}"
    data-focused="{{input.inputProps['data-focused']}}"
    data-disabled="{{input.inputProps['data-disabled']}}"
    data-readonly="{{input.inputProps['data-readonly']}}"
    data-invalid="{{input.inputProps['data-invalid']}}"
    value="{{input.value}}"
    focus="{{input.inputProps.focus}}"
    disabled="{{input.inputProps.disabled}}"
    type="{{type}}"
    password="{{password}}"
    placeholder="{{placeholder}}"
    placeholder-class="{{placeholderClass}}"
    placeholder-style="{{placeholderStyle}}"
    maxlength="{{maxlength}}"
    cursor-spacing="{{cursorSpacing}}"
    confirm-type="{{confirmType}}"
    confirm-hold="{{confirmHold}}"
    cursor="{{cursor}}"
    selection-start="{{selectionStart}}"
    selection-end="{{selectionEnd}}"
    adjust-position="{{adjustPosition}}"
    hold-keyboard="{{holdKeyboard}}"
    aria-invalid="{{input.inputProps['aria-invalid']}}"
    bindinput="handleInput"
    bindfocus="handleFocus"
    bindblur="handleBlur"
    bindconfirm="handleConfirm"
    bindkeyboardheightchange="handleKeyboardHeightChange"
  />

  <view
    wx:if="{{trailing || trailingIcon || clearable || loading}}"
    id="{{input.trailingProps.id}}"
    class="{{classes.trailing}}"
    data-scope="input"
    data-part="trailing"
  >
    <view wx:if="{{loading}}" class="{{classes.trailingIcon}}">
      <view class="w-4 h-4 rounded-full border-2 border-current border-t-transparent animate-spin" />
    </view>
    <view
      wx:elif="{{clearable && input.isClearable}}"
      id="{{input.clearButtonProps.id}}"
      class="{{classes.clear}}"
      data-scope="input"
      data-part="clear"
      catchtap="handleClear"
    >
      <text class="{{clearIcon || 'text-sm font-bold leading-none'}}">✕</text>
    </view>
    <text wx:elif="{{trailingIcon}}" class="{{classes.trailingIcon}} {{trailingIcon}}" />
    <slot name="trailing" />
  </view>
</view>
