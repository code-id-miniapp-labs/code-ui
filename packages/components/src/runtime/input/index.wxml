<view id="{{input.rootProps.id}}" class="{{classes.root}}" data-scope="input" data-part="root" data-state="{{input.state}}" data-empty="{{input.isEmpty}}" data-disabled="{{input.disabled}}" data-readonly="{{input.readOnly}}" data-invalid="{{input.invalid}}" aria-role="group" aria-disabled="{{input.disabled}}" aria-invalid="{{input.invalid}}">
  <view wx:if="{{leading || leadingIcon}}" class="{{classes.leading}}" data-scope="input" data-part="leading" aria-hidden="true">
    <slot name="leading"></slot>
    <view wx:if="{{leadingIcon}}" class="{{classes.leadingIcon}}">
      <c-icon name="{{leadingIcon}}" className="w-full h-full block"></c-icon>
    </view>
  </view>
  <input id="{{input.inputProps.id}}" name="{{name}}" class="{{classes.base}}" value="{{input.value}}" focus="{{input.inputProps.focus}}" disabled="{{input.inputProps.disabled}}" type="{{type}}" password="{{password}}" placeholder="{{placeholder}}" placeholder-class="{{placeholderClass}}" placeholder-style="{{placeholderStyle}}" maxlength="{{maxlength}}" cursor-spacing="{{cursorSpacing}}" confirm-type="{{confirmType}}" confirm-hold="{{confirmHold}}" cursor="{{cursor}}" selection-start="{{selectionStart}}" selection-end="{{selectionEnd}}" adjust-position="{{adjustPosition}}" hold-keyboard="{{holdKeyboard}}" aria-invalid="{{input.invalid}}" data-scope="input" data-part="base" data-state="{{input.state}}" data-empty="{{input.isEmpty}}" data-focused="{{input.inputProps.focus}}" data-disabled="{{input.disabled}}" data-readonly="{{input.readOnly}}" data-invalid="{{input.invalid}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" bindconfirm="handleConfirm" bindkeyboardheightchange="handleKeyboardHeightChange"></input>
  <view wx:if="{{trailing || trailingIcon || input.isClearable || loading}}" class="{{classes.trailing}}" data-scope="input" data-part="trailing" aria-hidden="true">
    <view wx:if="{{loading}}" class="{{classes.trailingIcon}}">
      <c-icon name="{{loadingIcon}}" className="w-full h-full block animate-spin"></c-icon>
    </view>
    <view wx:elif="{{input.isClearable}}" class="{{classes.trailingIcon}}" data-scope="input" data-part="clear" aria-role="button" aria-label="Clear input" catchtap="handleClear">
      <c-icon name="{{clearIcon}}" className="w-full h-full block"></c-icon>
    </view>
    <view wx:elif="{{trailingIcon}}" class="{{classes.trailingIcon}}">
      <c-icon name="{{trailingIcon}}" className="w-full h-full block"></c-icon>
    </view>
    <slot name="trailing"></slot>
  </view>
</view>