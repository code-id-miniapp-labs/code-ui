@keyframes cui-drawer-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@-webkit-keyframes cui-drawer-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes cui-drawer-slide-up {
  from {
    transform: translate3d(0, 100%, 0);
  }
  to {
    transform: translate3d(0, 0, 0);
  }
}

@-webkit-keyframes cui-drawer-slide-up {
  from {
    -webkit-transform: translate3d(0, 100%, 0);
    transform: translate3d(0, 100%, 0);
  }
  to {
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }
}

@keyframes cui-drawer-slide-down {
  from {
    transform: translate3d(0, -100%, 0);
  }
  to {
    transform: translate3d(0, 0, 0);
  }
}

@-webkit-keyframes cui-drawer-slide-down {
  from {
    -webkit-transform: translate3d(0, -100%, 0);
    transform: translate3d(0, -100%, 0);
  }
  to {
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }
}

@keyframes cui-drawer-slide-right {
  from {
    transform: translate3d(-100%, 0, 0);
  }
  to {
    transform: translate3d(0, 0, 0);
  }
}

@-webkit-keyframes cui-drawer-slide-right {
  from {
    -webkit-transform: translate3d(-100%, 0, 0);
    transform: translate3d(-100%, 0, 0);
  }
  to {
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }
}

@keyframes cui-drawer-slide-left {
  from {
    transform: translate3d(100%, 0, 0);
  }
  to {
    transform: translate3d(0, 0, 0);
  }
}

@-webkit-keyframes cui-drawer-slide-left {
  from {
    -webkit-transform: translate3d(100%, 0, 0);
    transform: translate3d(100%, 0, 0);
  }
  to {
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }
}

.cui-drawer-backdrop-enter {
  -webkit-animation: cui-drawer-fade-in 300ms ease-out;
  animation: cui-drawer-fade-in 300ms ease-out;
}

.cui-drawer-open {
  -webkit-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
}

.cui-drawer-closed-bottom {
  -webkit-transform: translate3d(0, 100%, 0);
  transform: translate3d(0, 100%, 0);
}

.cui-drawer-closed-top {
  -webkit-transform: translate3d(0, -100%, 0);
  transform: translate3d(0, -100%, 0);
}

.cui-drawer-closed-left {
  -webkit-transform: translate3d(-100%, 0, 0);
  transform: translate3d(-100%, 0, 0);
}

.cui-drawer-closed-right {
  -webkit-transform: translate3d(100%, 0, 0);
  transform: translate3d(100%, 0, 0);
}

.cui-drawer-enter-bottom {
  -webkit-animation: cui-drawer-slide-up 300ms cubic-bezier(0.32, 0.72, 0, 1);
  animation: cui-drawer-slide-up 300ms cubic-bezier(0.32, 0.72, 0, 1);
}

.cui-drawer-enter-top {
  -webkit-animation: cui-drawer-slide-down 300ms cubic-bezier(0.32, 0.72, 0, 1);
  animation: cui-drawer-slide-down 300ms cubic-bezier(0.32, 0.72, 0, 1);
}

.cui-drawer-enter-left {
  -webkit-animation: cui-drawer-slide-right 300ms cubic-bezier(0.32, 0.72, 0, 1);
  animation: cui-drawer-slide-right 300ms cubic-bezier(0.32, 0.72, 0, 1);
}

.cui-drawer-enter-right {
  -webkit-animation: cui-drawer-slide-left 300ms cubic-bezier(0.32, 0.72, 0, 1);
  animation: cui-drawer-slide-left 300ms cubic-bezier(0.32, 0.72, 0, 1);
}
