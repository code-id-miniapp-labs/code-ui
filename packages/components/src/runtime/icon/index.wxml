<block>
  <image wx:if="{{isPath}}" class="{{classes.root}}" style="{{iconStyle}}" src="{{resolvedName}}" mode="aspectFit" data-scope="icon" data-part="root" />
  <view wx:elif="{{resolvedName}}" class="{{resolvedName}} {{classes.root}}" style="{{iconStyle}}" data-scope="icon" data-part="root" aria-hidden="true" />
</block>