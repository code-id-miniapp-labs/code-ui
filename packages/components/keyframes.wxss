/* Accordion expand & collapse keyframes using detected exact height */
@keyframes accordion-down {
  from {
    height: 0;
    opacity: 0;
  }
  to {
    height: var(--cui-accordion-content-height, auto);
    opacity: 1;
  }
}

@keyframes accordion-up {
  from {
    height: var(--cui-accordion-content-height, auto);
    opacity: 1;
  }
  to {
    height: 0;
    opacity: 0;
  }
}

@keyframes cui-accordion-down {
  from {
    height: 0;
    opacity: 0;
  }
  to {
    height: var(--cui-accordion-content-height, auto);
    opacity: 1;
  }
}

@keyframes cui-accordion-up {
  from {
    height: var(--cui-accordion-content-height, auto);
    opacity: 1;
  }
  to {
    height: 0;
    opacity: 0;
  }
}

/* Utility animation classes */
.animate-accordion-down,
.animate-cui-accordion-down {
  animation: accordion-down 200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.animate-accordion-up,
.animate-cui-accordion-up {
  animation: accordion-up 200ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* Progress indeterminate keyframes */
@keyframes progress-carousel {
  0% {
    transform: translateX(-100%);
    width: 50%;
  }
  50% {
    width: 60%;
  }
  100% {
    transform: translateX(200%);
    width: 50%;
  }
}

@keyframes progress-carousel-inverse {
  0% {
    transform: translateX(200%);
    width: 50%;
  }
  50% {
    width: 60%;
  }
  100% {
    transform: translateX(-100%);
    width: 50%;
  }
}

@keyframes progress-swing {
  0%, 100% {
    transform: translateX(-20%);
    width: 40%;
  }
  50% {
    transform: translateX(180%);
    width: 40%;
  }
}

@keyframes progress-elastic {
  0% {
    transform: translateX(-100%);
    width: 20%;
  }
  50% {
    transform: translateX(50%);
    width: 80%;
  }
  100% {
    transform: translateX(200%);
    width: 20%;
  }
}

/* Progress stripes animation */
@keyframes progress-stripes {
  from {
    background-position: 1rem 0;
  }
  to {
    background-position: 0 0;
  }
}
