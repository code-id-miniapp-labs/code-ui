<button
  id="{{button.rootProps.id}}"
  class="cui-btn cui-btn--{{button.variant || 'primary'}} cui-btn--{{button.size || 'md'}} {{button.loading ? 'cui-btn--loading' : ''}} {{button.disabled ? 'cui-btn--disabled' : ''}} {{button.ui.root || ''}}"
  data-scope="button"
  data-part="root"
  data-state="{{button.state}}"
  data-variant="{{button.variant || 'primary'}}"
  data-size="{{button.size || 'md'}}"
  data-loading="{{button.loading ? 'true' : 'false'}}"
  data-disabled="{{button.disabled ? 'true' : 'false'}}"
  disabled="{{button.disabled || button.loading}}"
  open-type="{{openType}}"
  form-type="{{formType}}"
  hover-class="{{hoverClass || (button.disabled || button.loading ? 'none' : 'cui-btn--hover')}}"
  hover-start-time="{{hoverStartTime}}"
  hover-stay-time="{{hoverStayTime}}"
  hover-stop-propagation="{{hoverStopPropagation}}"
  lang="{{lang}}"
  session-from="{{sessionFrom}}"
  send-message-title="{{sendMessageTitle}}"
  send-message-path="{{sendMessagePath}}"
  send-message-img="{{sendMessageImg}}"
  show-message-card="{{showMessageCard}}"
  app-parameter="{{appParameter}}"
  catchtap="handleTap"
  bindgetphonenumber="handleGetPhoneNumber"
  bindchooseavatar="handleChooseAvatar"
  bindcontact="handleContact"
  binderror="handleError"
  bindopensetting="handleOpenSetting"
  bindlaunchapp="handleLaunchApp"
  bindagreeprivacyauthorization="handleAgreePrivacyAuthorization"
>
  <view
    id="{{button.spinnerProps.id}}"
    class="cui-btn-spinner {{button.ui.spinner || ''}}"
    data-scope="button"
    data-part="spinner"
    wx:if="{{button.loading}}"
  >
    <view class="cui-btn-spinner-icon" />
  </view>

  <view
    id="{{button.iconProps.id}}"
    class="cui-btn-icon {{button.ui.icon || ''}}"
    data-scope="button"
    data-part="icon"
    wx:if="{{!button.loading}}"
  >
    <slot name="icon" />
  </view>

  <view
    id="{{button.labelProps.id}}"
    class="cui-btn-label {{button.ui.label || ''}}"
    data-scope="button"
    data-part="label"
  >
    <slot />
  </view>
</button>