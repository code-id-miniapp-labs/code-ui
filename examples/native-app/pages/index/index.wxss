/** pages/index/index.wxss **/
.page-container {
  padding: 32rpx;
  background-color: #090d16;
  min-height: 100vh;
}

/* Hero Section */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 40rpx;
  padding: 32rpx 16rpx;
}

.hero-badge {
  display: inline-flex;
  padding: 6rpx 20rpx;
  background: rgba(99, 102, 241, 0.15);
  border: 1rpx solid rgba(99, 102, 241, 0.3);
  border-radius: 9999rpx;
  margin-bottom: 20rpx;
}

.hero-badge-text {
  font-size: 24rpx;
  color: #818cf8;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.5;
  max-width: 600rpx;
}

/* Card Section */
.config-card {
  background: #111827;
  border: 1rpx solid #1f2937;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f8fafc;
  display: block;
  margin-bottom: 8rpx;
}

.model-desc {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.4;
  display: block;
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #cbd5e1;
  display: block;
  margin-bottom: 16rpx;
}

/* Button Rows */
.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
}

/* Placement Grid */
.placement-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.placement-pill {
  padding: 16rpx 8rpx;
  text-align: center;
  background: #1e293b;
  border: 1rpx solid #334155;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.placement-pill--active {
  background: #4f46e5;
  border-color: #6366f1;
}

.placement-text {
  font-size: 26rpx;
  color: #f8fafc;
  font-weight: 600;
  text-transform: capitalize;
}

/* Threshold options */
.threshold-options {
  display: flex;
  gap: 16rpx;
}

.threshold-btn {
  flex: 1;
  padding: 14rpx;
  text-align: center;
  background: #1e293b;
  border: 1rpx solid #334155;
  border-radius: 12rpx;
}

.threshold-btn--active {
  background: #4f46e5;
  border-color: #6366f1;
}

.threshold-text {
  font-size: 24rpx;
  color: #f8fafc;
  font-weight: 600;
}

/* Switch Row */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx solid #1f2937;
}

.switch-label {
  font-size: 26rpx;
  color: #cbd5e1;
}

/* Drawer Content Inner */
.drawer-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.drawer-body-content {
  padding: 16rpx 0;
}

.drawer-desc {
  font-size: 28rpx;
  color: #94a3b8;
  line-height: 1.5;
  margin-bottom: 24rpx;
  display: block;
}

.drawer-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.stat-item {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-bottom: 6rpx;
}

.stat-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #818cf8;
  text-transform: capitalize;
}

.drawer-footer-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  width: 100%;
}
