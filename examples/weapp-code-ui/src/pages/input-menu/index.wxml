<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header title="Input Menu" badge="Form" subtitle="Autocomplete combobox built on popover supporting live search, multiple tags, createItem & c-input-menu-item." />
  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Basic Searchable Combobox -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Searchable Combobox</text>
        <text class="block text-xs text-muted mt-0.5">Selected: {{ basicValue || 'None' }}</text>
      </view>
      <c-input-menu searchTerm="{{searchTerm}}" bind:searchTermChange="onSearchTermChange" value="{{ basicValue }}" items="{{ basicItems }}" placeholder="Search status..." clearable="{{ true }}" arrow="{{ true }}" bind:change="onBasicChange" />
      <c-input-menu items="{{ groupedItems }}" filter-fields="{{ ['label', 'description'] }}" placeholder="Search grouped items or descriptions..." />
    </view>
    <!-- 2. Multiple Selection with Removable Tags -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Multiple Selection (Tags)</text>
        <text class="block text-xs text-muted mt-0.5">
          Selected count: {{ multipleValue.length }}
        </text>
      </view>
      <c-input-menu multiple="{{ true }}" value="{{ multipleValue }}" items="{{ multipleItems }}" placeholder="Add fruits..." clearable="{{ true }}" leading-icon="i-lucide-tags" bind:change="onMultipleChange" />
    </view>
    <!-- 3. Create New Item (createItem) -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Create Item on the Fly</text>
        <text class="block text-xs text-muted mt-0.5">
          Type a new label to create and select it dynamically.
        </text>
      </view>
      <c-input-menu multiple="{{ true }}" value="{{ creatableValue }}" items="{{ creatableItems }}" create-item="always" create-icon="i-lucide-plus" placeholder="Search or create tag..." bind:change="onCreatableChange" bind:create="onCreateTag" />
    </view>
    <!-- 4. Custom c-input-menu-item Composition -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">
          Custom c-input-menu-item Slots
        </text>
        <text class="block text-xs text-muted mt-0.5">
          Declarative items filter automatically as you type.
        </text>
      </view>
      <c-input-menu value="{{ assigneeValue }}" placeholder="Search reviewer..." clearable="{{ true }}" bind:change="onAssigneeChange">
        <c-input-menu-item value="alice" label="Alice Wang" description="Design Systems">
          <c-avatar slot="leading" size="xs" text="Alice Wang" color="primary" />
        </c-input-menu-item>
        <c-input-menu-item value="bob" label="Bob Chen" description="Core Runtime">
          <c-avatar slot="leading" size="xs" text="Bob Chen" color="secondary" />
        </c-input-menu-item>
        <c-input-menu-item type="separator" />
        <c-input-menu-item value="charlie" label="Charlie Zhang" description="Compiler & Vite">
          <c-chip slot="leading" standalone="{{ true }}" color="success" size="sm" />
        </c-input-menu-item>
      </c-input-menu>
    </view>
    <!-- 5. Variants, Sizes & FormField -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">
          Variants, Sizes & FormField
        </text>
        <text class="block text-xs text-muted mt-0.5">
          Matches c-input visual tokens and FormField context.
        </text>
      </view>
      <view class="flex flex-col gap-2">
        <c-input-menu wx:for="{{ variants }}" wx:key="*this" variant="{{ item }}" items="{{ basicItems }}" placeholder="Variant: {{ item }}" />
      </view>
      <view class="flex flex-col gap-2 pt-2 border-t border-muted">
        <c-input-menu wx:for="{{ sizes }}" wx:key="*this" size="{{ item }}" items="{{ basicItems }}" placeholder="Size: {{ item }}" />
      </view>
      <view class="flex flex-col gap-2 pt-2 border-t border-muted">
        <c-input-menu loading="{{ true }}" items="{{ basicItems }}" value="Todo" />
        <c-input-menu disabled="{{ true }}" items="{{ basicItems }}" value="Backlog" />
        <c-form-field label="Primary Stack" hint="Required" required="{{ true }}" help="Search and select your primary framework">
          <c-input-menu items="{{ basicItems }}" placeholder="Search status..." />
        </c-form-field>
      </view>
    </view>
  </view>
</view>