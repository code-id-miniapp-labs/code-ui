<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Switch"
    badge="Form"
    subtitle="Binary toggle control with 7 colors, 5 sizes, checked/unchecked icons, loading, slots & FormField validation."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Controlled State -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled State & List Composition</text>
        <text class="block text-xs text-muted mt-0.5">Last event: {{ lastEvent }}</text>
      </view>
      <c-switch
        checked="{{ controlledChecked }}"
        label="Controlled Feature Flag"
        description="Synchronized between touch events and external toggle button."
        bind:change="onControlledChange"
      />
      <view class="flex gap-2">
        <c-button size="xs" color="primary" variant="soft" label="Toggle via Page" bind:tap="toggleControlled" />
      </view>

      <view class="flex flex-col divide-y divide-muted pt-2 border-t border-muted">
        <view class="py-2.5 flex items-center justify-between gap-3">
          <c-switch checked="{{ airplaneMode }}" label="Airplane Mode" description="Disable cellular & Wi-Fi radios" bind:change="onAirplaneModeChange" />
        </view>
        <view class="py-2.5 flex items-center justify-between gap-3">
          <c-switch checked="{{ wifiEnabled }}" color="info" label="Wi-Fi Network" description="Auto-join known hotspots" bind:change="onWifiChange" />
        </view>
        <view class="py-2.5 flex items-center justify-between gap-3">
          <c-switch checked="{{ notifications }}" color="success" label="Notifications" description="Receive status updates" bind:change="onNotificationsChange" />
        </view>
      </view>
    </view>

    <!-- 2. Icons, Loading & Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Checked/Unchecked Icons, Loading & Slots</text>
        <text class="block text-xs text-muted mt-0.5">Thumb icons, spinner state & custom label/description slots.</text>
      </view>
      <c-switch default-checked="{{ true }}" checked-icon="i-lucide-check" unchecked-icon="i-lucide-x" label="Confirm / Cancel Thumb Icons" />
      <c-switch default-checked="{{ true }}" checked-icon="i-lucide-moon" unchecked-icon="i-lucide-sun" color="secondary" label="Day / Night Theme Icons" />
      <c-switch checked="{{ true }}" loading="{{ true }}" color="primary" label="Loading State (Syncing...)" />
      <c-switch default-checked="{{ true }}" color="success">
        <view slot="label" class="flex items-center gap-1.5">
          <text class="text-sm font-medium text-highlighted">Two-Factor Security</text>
          <c-badge label="Recommended" size="xs" color="success" variant="soft" />
        </view>
        <text slot="description" class="text-xs text-muted">Rendered via custom label & description slots.</text>
      </c-switch>
    </view>

    <!-- 3. Semantic Colors & Sizes -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Semantic Colors & Size Scale</text>
        <text class="block text-xs text-muted mt-0.5">All 7 colors including secondary, and sizes xs through xl.</text>
      </view>
      <view class="flex flex-wrap gap-3">
        <view wx:for="{{ colors }}" wx:key="*this" class="flex items-center gap-1.5">
          <c-switch default-checked="{{ true }}" color="{{ item }}" size="sm" />
          <text class="text-xs text-muted">{{ item }}</text>
        </view>
      </view>
      <view class="flex flex-wrap items-center gap-4 pt-2 border-t border-muted">
        <view wx:for="{{ sizes }}" wx:key="*this" class="flex items-center gap-1.5">
          <c-switch default-checked="{{ true }}" size="{{ item }}" color="primary" />
          <text class="text-xs font-mono text-dimmed">{{ item }}</text>
        </view>
      </view>
    </view>

    <!-- 4. States & Form Validation -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Disabled, ReadOnly, Invalid & Form</text>
        <text class="block text-xs text-muted mt-0.5">States & required agreement validation inside c-form.</text>
      </view>
      <view class="flex flex-col gap-2">
        <c-switch disabled="{{ true }}" checked="{{ true }}" label="Disabled (Checked)" />
        <c-switch read-only="{{ true }}" checked="{{ false }}" label="Read-Only Switch" />
        <c-switch invalid="{{ true }}" required="{{ true }}" label="Invalid / Required Switch" />
      </view>

      <c-form id="switch-demo-form" bind:submit="handleSwitchFormSubmit" bind:error="handleSwitchFormError">
        <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
          <c-form-field name="emailNotifications">
            <c-switch checked="{{ formEmailNotifications }}" label="Email Digests" bind:change="onFormEmailNotificationsChange" />
          </c-form-field>
          <c-form-field name="agreement" required="{{ true }}" rules="{{ agreementRules }}">
            <c-switch default-checked="{{ false }}" label="Accept Release Terms *" />
          </c-form-field>
        </view>
      </c-form>

      <view class="flex flex-wrap gap-2">
        <c-button size="xs" color="primary" label="Submit" bind:tap="submitSwitchForm" />
        <c-button size="xs" color="secondary" variant="soft" label="Toggle Email Flag" bind:tap="toggleFormControlled" />
        <c-button size="xs" color="neutral" variant="outline" label="Reset" bind:tap="resetSwitchForm" />
      </view>
      <text wx:if="{{ switchFormStatus }}" class="text-xs text-muted">{{ switchFormStatus }}: {{ switchFormMessage }}</text>
    </view>
  </view>
</view>
