<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Use Component Ref"
    badge="Interaction"
    subtitle="Reactive useComponentRef() composable connecting page methods and live state snapshots to child FSM components."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Form Inputs Controlled via useComponentRef -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-4">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Direct FSM Control with useComponentRef()</text>
        <text class="block text-xs text-muted mt-0.5">Reads component snapshots reactively and calls api.clear() / api.clearValue() without prop boilerplate.</text>
      </view>

      <c-form-field label="Username (#userInput)" help="Snapshot value synced to page.data.user">
        <c-input id="userInput" placeholder="Enter handle..." leading-icon="i-lucide-user" clearable="{{ true }}" />
      </c-form-field>

      <c-pin-input id="otpInput" label="4-Digit Security OTP (#otpInput)" length="{{ 4 }}" highlight="{{ true }}" />

      <view class="flex flex-wrap gap-2">
        <c-button size="xs" color="primary" label="Verify & Submit" bind:tap="handleSubmit" />
        <c-button size="xs" color="neutral" variant="outline" label="clearValue()" bind:tap="handleClearUser" />
        <c-button size="xs" color="secondary" variant="soft" label="otp.clear()" bind:tap="handleClearOtp" />
      </view>

      <view wx:if="{{ submitResult }}" class="p-3 rounded-xl bg-success/10 border border-success/30 text-success text-xs font-medium">
        {{ submitResult }}
      </view>
    </view>

    <!-- 2. Live Reactive Snapshots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <text class="text-sm font-semibold text-highlighted">Live Reactive Snapshots</text>
      <view class="bg-muted border border-muted rounded-xl p-3 flex flex-col gap-2 font-mono text-[11px] text-toned">
        <view class="flex justify-between">
          <text class="text-dimmed">user.value:</text>
          <text class="text-highlighted">{{ user.value || '(empty)' }}</text>
        </view>
        <view class="flex justify-between">
          <text class="text-dimmed">otp.valueAsString:</text>
          <text class="text-highlighted">{{ otp.valueAsString || '(empty)' }}</text>
        </view>
        <view class="flex justify-between">
          <text class="text-dimmed">otp.isValueComplete:</text>
          <c-badge label="{{ otp.isValueComplete ? 'true' : 'false' }}" color="{{ otp.isValueComplete ? 'success' : 'neutral' }}" variant="soft" size="xs" />
        </view>
      </view>
    </view>
  </view>
</view>
