<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Drawer"
    badge="Feedback"
    subtitle="4-edge modal sheet with WXS drag-to-dismiss, scaleBackground coordination, nested scroll & Form support."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Placements -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Edge Placements</text>
        <text class="block text-xs text-muted mt-0.5">Open slide-over drawer from bottom, top, left or right edge.</text>
      </view>
      <view class="grid grid-cols-2 gap-2.5">
        <c-button size="sm" color="primary" label="Bottom Sheet" data-placement="bottom" bind:tap="openPlacement" />
        <c-button size="sm" color="primary" variant="soft" label="Top Sheet" data-placement="top" bind:tap="openPlacement" />
        <c-button size="sm" color="secondary" variant="outline" label="Left Menu" data-placement="left" bind:tap="openPlacement" />
        <c-button size="sm" color="neutral" variant="outline" label="Right Panel" data-placement="right" bind:tap="openPlacement" />
      </view>
    </view>

    <!-- 2. Scenarios: Scrollable, Non-dismissible Modal, Form -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Scenarios & Custom Close</text>
        <text class="block text-xs text-muted mt-0.5">Nested scroll locking, modal confirmation, and form sheet with custom close slot.</text>
      </view>
      <view class="flex flex-wrap gap-2">
        <c-button size="sm" color="primary" variant="outline" label="Scrollable Content" bind:tap="openScrollable" />
        <c-button size="sm" color="danger" variant="soft" label="Modal (Lock Backdrop)" bind:tap="openModal" />
        <c-button size="sm" color="secondary" variant="soft" label="Form + Close Slot" bind:tap="openFormDrawer" />
      </view>
    </view>

    <!-- 3. Settings & Background Scale -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Scale Background & Backdrop Settings</text>
        <text class="block text-xs text-muted mt-0.5">Matches Vaul/iOS card shrink animation via c-app behavior.</text>
      </view>
      <c-switch checked="{{ shouldScaleBackground }}" label="Enable Scale Background" bind:change="onScaleBackgroundChange" />
      <c-switch checked="{{ closeOnBackdropClick }}" label="Close on Backdrop Tap" bind:change="onBackdropCloseChange" />
      <view class="flex items-center gap-2 pt-1">
        <text class="text-xs text-muted">Backdrop:</text>
        <c-button size="xs" color="{{ scaleBackground === 'bg-black' ? 'primary' : 'neutral' }}" variant="{{ scaleBackground === 'bg-black' ? 'solid' : 'outline' }}" label="Black" data-color="bg-black" bind:tap="onSelectScaleColor" />
        <c-button size="xs" color="{{ scaleBackground === 'bg-neutral-900' ? 'primary' : 'neutral' }}" variant="{{ scaleBackground === 'bg-neutral-900' ? 'solid' : 'outline' }}" label="Neutral 900" data-color="bg-neutral-900" bind:tap="onSelectScaleColor" />
      </view>
    </view>

    <!-- 4. Lifecycle Event Log & Scroll Lock Preview -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-2">
      <text class="text-sm font-semibold text-highlighted">Open / Close Lifecycle Log</text>
      <view class="bg-muted rounded-xl p-3 flex flex-col gap-1 border border-muted">
        <text wx:for="{{ eventLogs }}" wx:key="*this" class="text-[11px] font-mono text-toned">• {{ item }}</text>
      </view>
      <view class="flex flex-col gap-2 pt-2">
        <view wx:for="{{ pageItems }}" wx:key="id" class="p-3 rounded-xl bg-muted border border-muted">
          <text class="block text-xs font-semibold text-highlighted">{{ item.title }}</text>
          <text class="block text-[11px] text-muted mt-0.5">{{ item.desc }}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- Active Drawer Instance (in c-app overlay slot so background scale transform never clips fixed sheets) -->
<c-drawer
  slot="overlay"
  open="{{ drawerOpen }}"
  placement="{{ placement }}"
  should-scale-background="{{ shouldScaleBackground }}"
  scale-background="{{ scaleBackground }}"
  scale-factor="{{ scaleFactor }}"
  close-on-backdrop-click="{{ closeOnBackdropClick }}"
  close="{{ scenario === 'modal' ? customCloseProps : true }}"
  bind:openChange="onOpenChange"
  bind:close="onDrawerClose"
>
  <view slot="header">
    <text class="block text-base font-bold text-highlighted">{{ drawerTitle }}</text>
    <text class="block text-xs text-muted mt-0.5">{{ drawerDescription }}</text>
  </view>

  <view wx:if="{{ useCustomCloseSlot }}" slot="close" class="px-2 py-1 rounded-full bg-elevated">
    <text class="text-xs font-medium text-muted">ESC</text>
  </view>

  <!-- Body Scenarios -->
  <view wx:if="{{ scenario === 'scrollable' }}" class="flex flex-col divide-y divide-muted">
    <view wx:for="{{ scrollItems }}" wx:key="id" class="py-3">
      <text class="block text-sm font-medium text-highlighted">{{ item.title }}</text>
      <text class="block text-xs text-muted mt-0.5">{{ item.desc }}</text>
    </view>
  </view>

  <view wx:elif="{{ scenario === 'form' }}" class="flex flex-col gap-3 py-1">
    <c-form id="drawer-form" bind:submit="onFormSubmit">
      <view class="flex flex-col gap-3">
        <c-form-field name="subject" label="Subject" required="{{ true }}">
          <c-input adjust-position="{{ false }}" placeholder="Enter short subject..." />
        </c-form-field>
        <c-form-field name="notes" label="Notes">
          <c-textarea adjust-position="{{ false }}" placeholder="Keyboard height auto-adjusts drawer padding..." count="{{ true }}" maxlength="{{ 140 }}" />
        </c-form-field>
        <c-button form-type="submit" block="{{ true }}" color="primary" label="Submit Feedback" />
      </view>
    </c-form>
  </view>

  <view wx:else class="py-2 flex flex-col gap-3">
    <view class="p-3.5 rounded-xl bg-muted border border-default">
      <text class="block text-xs font-semibold text-highlighted">Gesture & Safe-Area Support</text>
      <text class="block text-xs text-muted mt-1 leading-relaxed">
        All four edges (bottom, top, left, right) enable native WXS touch swipe gestures on the grabber handle for smooth resistance and velocity dismissal.
      </text>
    </view>
  </view>

  <view slot="footer" class="flex items-center justify-end gap-2 w-full">
    <c-button size="sm" variant="outline" color="neutral" label="Cancel" bind:tap="closeDrawer" />
    <c-button size="sm" color="primary" label="Confirm" bind:tap="onConfirmAction" />
  </view>
</c-drawer>
