<view class="min-h-screen bg-neutral-50 text-neutral-900 pb-16">
  <!-- Page Header -->
  <view class="px-6 pt-8 pb-5 bg-white border-b border-neutral-200 mb-6">
    <view class="text-xl font-extrabold text-neutral-950">Drawer</view>
    <view class="text-xs text-neutral-500 mt-1">
      Gesture-driven modal drawer with backdrop dimming and bottom/top/left/right placements.
    </view>
  </view>

  <view class="px-5 flex flex-col gap-6">
    <!-- Placements -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Placements</view>
      <view class="text-xs text-neutral-400 mb-4">Open drawer from different screen edges.</view>
      <view class="flex flex-wrap gap-2.5">
        <c-button color="primary" data-placement="bottom" bind:tap="openDrawer">
          Bottom Drawer
        </c-button>
        <c-button variant="outline" color="neutral" data-placement="top" bind:tap="openDrawer">
          Top Drawer
        </c-button>
        <c-button variant="outline" color="neutral" data-placement="left" bind:tap="openDrawer">
          Left Drawer
        </c-button>
        <c-button variant="outline" color="neutral" data-placement="right" bind:tap="openDrawer">
          Right Drawer
        </c-button>
      </view>
    </view>

    <!-- State Indicator -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Drawer State</view>
      <view class="text-xs text-neutral-500">
        Current status: <text class="font-bold text-neutral-800">{{drawerOpen ? 'Open (' + placement + ')' : 'Closed'}}</text>
      </view>
    </view>
  </view>

  <!-- The Drawer Instance -->
  <c-drawer
    open="{{drawerOpen}}"
    placement="{{placement}}"
    bind:close="onDrawerClose"
  >
    <view class="p-6 flex flex-col gap-4">
      <view class="flex items-center justify-between">
        <view class="text-base font-bold text-neutral-900">Drawer Title</view>
        <c-button size="xs" variant="ghost" color="neutral" bind:tap="closeDrawer">
          ✕
        </c-button>
      </view>
      <view class="text-xs text-neutral-600 leading-relaxed">
        This is a modal drawer rendered via Code UI's Zag-powered drawer machine.
        Swipe to dismiss, tap the backdrop, or click the close button.
      </view>
      <view class="pt-2 flex gap-2">
        <c-button block="{{true}}" color="primary" size="sm" bind:tap="closeDrawer">
          Confirm Action
        </c-button>
      </view>
    </view>
  </c-drawer>
</view>
