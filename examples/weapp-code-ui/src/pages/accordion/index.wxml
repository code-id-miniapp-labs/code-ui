<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Accordion"
    badge="Navigation"
    subtitle="Collapsible disclosure panels supporting 5 variants, single/multiple modes, disabled items, trailingIcon & programmatic toggle."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Interactive Compound Demo -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Interactive Compound Accordion</text>
        <text class="block text-xs text-muted mt-0.5">Active: {{ activeValue.length > 0 ? activeValue.join(', ') : '(none)' }}</text>
      </view>

      <view class="flex flex-wrap gap-1.5">
        <c-button
          wx:for="{{ variantOptions }}"
          wx:key="*this"
          size="xs"
          color="{{ variant === item ? 'primary' : 'neutral' }}"
          variant="{{ variant === item ? 'solid' : 'outline' }}"
          label="{{ item }}"
          data-variant="{{ item }}"
          bind:tap="selectVariant"
        />
      </view>

      <view class="flex flex-wrap items-center justify-between gap-2">
        <view class="flex gap-1.5">
          <c-button
            wx:for="{{ sizeOptions }}"
            wx:key="*this"
            size="xs"
            color="{{ size === item ? 'secondary' : 'neutral' }}"
            variant="{{ size === item ? 'solid' : 'outline' }}"
            label="{{ item }}"
            data-size="{{ item }}"
            bind:tap="selectSize"
          />
        </view>
        <view class="flex items-center gap-3">
          <view class="flex items-center gap-1.5">
            <text class="text-xs text-muted">Multiple</text>
            <c-switch checked="{{ multiple }}" size="xs" bind:change="toggleMultiple" />
          </view>
          <view class="flex items-center gap-1.5">
            <text class="text-xs text-muted">Collapsible</text>
            <c-switch checked="{{ collapsible }}" size="xs" bind:change="toggleCollapsible" />
          </view>
        </view>
      </view>

      <c-accordion
        id="interactive-accordion"
        value="{{ activeValue }}"
        multiple="{{ multiple }}"
        collapsible="{{ collapsible }}"
        variant="{{ variant }}"
        size="{{ size }}"
        bind:change="onAccordionChange"
      >
        <c-accordion-item value="getting-started" label="Getting Started" description="Installation and initial configuration" icon="i-lucide-rocket">
          <text class="text-xs text-muted leading-relaxed">Install @code-ui/components and wire codeUI() inside weapp-vite.config.ts.</text>
        </c-accordion-item>
        <c-accordion-item value="components" label="Custom Trailing Icon" description="Overrides trailing chevron with sparkles" icon="i-lucide-box" trailing-icon="i-lucide-sparkles">
          <text class="text-xs text-muted leading-relaxed">Supports custom leading/trailing icons as well as slot="content".</text>
        </c-accordion-item>
        <c-accordion-item value="theming" label="Runtime Theming" description="Light/Dark & hex color tokens" icon="i-lucide-palette">
          <text class="text-xs text-muted leading-relaxed">Toggle Dark/Light or pick a swatch in the header above to see live variable inheritance.</text>
        </c-accordion-item>
        <c-accordion-item value="locked" label="Disabled Accordion Item" description="Non-interactive locked item" icon="i-lucide-lock" disabled="{{ true }}">
          <text class="text-xs text-muted">Locked content.</text>
        </c-accordion-item>
      </c-accordion>

      <view class="flex flex-wrap gap-2 pt-1">
        <c-button size="xs" color="primary" variant="soft" label="toggle('getting-started')" bind:tap="programmaticToggleFirst" />
        <c-button size="xs" color="secondary" variant="soft" label="Expand All" bind:tap="expandAll" />
        <c-button size="xs" color="neutral" variant="outline" label="Collapse All" bind:tap="collapseAll" />
      </view>
    </view>

    <!-- 2. Data-Driven Items (Including Disabled Item) -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Data-Driven Items Array</text>
        <text class="block text-xs text-muted mt-0.5">Pass items array directly; supports disabled flags and custom icons per item.</text>
      </view>
      <c-accordion items="{{ dataItems }}" value="{{ dataValue }}" variant="subtle" bind:change="onDataAccordionChange" />
    </view>

    <!-- 3. Separated Cards & Custom Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Separated Variant & Custom Slots</text>
        <text class="block text-xs text-muted mt-0.5">Each panel styled as a standalone card with custom label/trailing slots.</text>
      </view>
      <c-accordion variant="separated" value="{{ separatedValue }}" multiple="{{ true }}" bind:change="onSeparatedChange">
        <c-accordion-item value="item-1" icon="i-lucide-shield-check">
          <view slot="label" class="flex items-center gap-2">
            <text class="text-sm font-semibold text-highlighted">Enterprise Security</text>
            <c-badge label="Verified" size="xs" color="success" variant="soft" />
          </view>
          <text class="text-xs text-muted">Role-based permissions and encrypted tokens.</text>
        </c-accordion-item>
        <c-accordion-item value="item-2" label="Custom Description & Status" icon="i-lucide-credit-card">
          <text slot="description" class="text-xs text-primary">Active billing plan enabled</text>
          <text class="text-xs text-muted">Manage invoices and team seats at any time.</text>
        </c-accordion-item>
      </c-accordion>
    </view>
  </view>
</view>
