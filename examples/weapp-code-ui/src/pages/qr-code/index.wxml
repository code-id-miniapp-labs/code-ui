<view class="min-h-screen bg-neutral-50 text-neutral-900 pb-16">
  <!-- Page Header -->
  <view class="px-6 pt-8 pb-5 bg-white border-b border-neutral-200 mb-6">
    <view class="text-xl font-extrabold text-neutral-950">QR Code</view>
    <view class="text-xs text-neutral-500 mt-1">
      Universal QR code generator powered by uqr, with SVG path rendering, custom error correction levels, sizes, colors, and center overlay logo.
    </view>
  </view>

  <view class="px-5 flex flex-col gap-6">
    <!-- 1. Interactive Demo -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Interactive QR Code</view>
      <view class="text-xs text-neutral-400 mb-4">
        Type custom payload text, choose error correction level, color, and quiet zone margin.
      </view>

      <view class="flex flex-col items-center justify-center p-6 bg-neutral-50/70 rounded-xl border border-neutral-200 mb-4">
        <c-qr-code
          value="{{textValue}}"
          ecc="{{ecc}}"
          size="{{size}}"
          color="{{color}}"
          border="{{border}}"
        />
        <view class="mt-3 text-xs text-neutral-500 max-w-xs truncate text-center font-mono">
          {{textValue || '(empty)'}}
        </view>
      </view>

      <!-- Input Controller -->
      <view class="flex flex-col gap-4">
        <c-input
          value="{{textValue}}"
          placeholder="Enter text or URL..."
          clearable="{{true}}"
          bind:change="onInputChange"
        />

        <!-- Preset URL Pills -->
        <view class="flex flex-wrap gap-2">
          <c-button
            size="xs"
            variant="outline"
            color="primary"
            data-preset="https://code-ui.dev"
            bind:tap="setPreset"
          >
            Code UI
          </c-button>
          <c-button
            size="xs"
            variant="outline"
            color="neutral"
            data-preset="https://github.com/unjs/uqr"
            bind:tap="setPreset"
          >
            unjs/uqr
          </c-button>
          <c-button
            size="xs"
            variant="outline"
            color="neutral"
            data-preset="WIFI:S:MyOfficeWiFi;T:WPA;P:SecretPass123;;"
            bind:tap="setPreset"
          >
            WiFi Config
          </c-button>
        </view>

        <!-- ECC Options -->
        <view class="flex flex-col gap-1.5">
          <text class="text-xs font-semibold text-neutral-600">Error Correction (ECC):</text>
          <view class="flex gap-2">
            <block wx:for="{{eccOptions}}" wx:key="*this">
              <c-button
                size="xs"
                variant="{{ecc === item ? 'solid' : 'outline'}}"
                color="{{ecc === item ? 'primary' : 'neutral'}}"
                data-ecc="{{item}}"
                bind:tap="selectEcc"
              >
                {{item}}
              </c-button>
            </block>
          </view>
        </view>

        <!-- Size Options -->
        <view class="flex flex-col gap-1.5">
          <text class="text-xs font-semibold text-neutral-600">Size Variant:</text>
          <view class="flex flex-wrap gap-2">
            <block wx:for="{{sizeOptions}}" wx:key="*this">
              <c-button
                size="xs"
                variant="{{size === item ? 'solid' : 'outline'}}"
                color="{{size === item ? 'primary' : 'neutral'}}"
                data-size="{{item}}"
                bind:tap="selectSize"
              >
                {{item}}
              </c-button>
            </block>
          </view>
        </view>

        <!-- Color Options -->
        <view class="flex flex-col gap-1.5">
          <text class="text-xs font-semibold text-neutral-600">Color Theme:</text>
          <view class="flex flex-wrap gap-2">
            <block wx:for="{{colorOptions}}" wx:key="*this">
              <c-button
                size="xs"
                variant="{{color === item ? 'solid' : 'outline'}}"
                color="{{item === 'neutral' ? 'neutral' : item}}"
                data-color="{{item}}"
                bind:tap="selectColor"
              >
                {{item}}
              </c-button>
            </block>
          </view>
        </view>

        <!-- Border Toggle -->
        <view class="flex items-center justify-between pt-2 border-t border-neutral-100">
          <text class="text-xs font-medium text-neutral-700">Quiet Zone Margin (Border: {{border}})</text>
          <c-button size="xs" variant="outline" color="neutral" bind:tap="toggleBorder">
            Toggle Border
          </c-button>
        </view>
      </view>
    </view>

    <!-- 2. Logo & Center Overlay -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Center Logo Overlay</view>
      <view class="text-xs text-neutral-400 mb-4">
        Supports brand logos or custom badges via overlaySrc prop or overlay named slot.
      </view>
      <view class="flex flex-wrap items-center justify-around gap-4 p-4 bg-neutral-50/70 rounded-xl border border-neutral-200">
        <!-- Overlay via overlaySrc -->
        <view class="flex flex-col items-center gap-2">
          <c-qr-code
            value="https://weixin.qq.com"
            ecc="H"
            size="md"
            overlaySrc="{{overlayLogo}}"
          />
          <text class="text-[11px] text-neutral-500 font-medium">overlaySrc prop</text>
        </view>

        <!-- Overlay via Slot -->
        <view class="flex flex-col items-center gap-2">
          <c-qr-code
            value="https://code-ui.dev"
            ecc="H"
            size="md"
            color="primary"
            showOverlay="{{true}}"
          >
            <view slot="overlay" class="w-full h-full flex items-center justify-center bg-primary text-white rounded-md text-[10px] font-bold">
              CUI
            </view>
          </c-qr-code>
          <text class="text-[11px] text-neutral-500 font-medium">named slot="overlay"</text>
        </view>
      </view>
    </view>

    <!-- 3. Size Variants -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Sizes Matrix</view>
      <view class="text-xs text-neutral-400 mb-4">xs, sm, md, lg</view>
      <view class="flex flex-wrap items-end justify-around gap-4 p-4 bg-neutral-50/70 rounded-xl border border-neutral-200">
        <view class="flex flex-col items-center gap-2">
          <c-qr-code value="https://code-ui.dev" size="xs" />
          <text class="text-[11px] text-neutral-500">xs (24×24)</text>
        </view>
        <view class="flex flex-col items-center gap-2">
          <c-qr-code value="https://code-ui.dev" size="sm" />
          <text class="text-[11px] text-neutral-500">sm (32×32)</text>
        </view>
        <view class="flex flex-col items-center gap-2">
          <c-qr-code value="https://code-ui.dev" size="md" />
          <text class="text-[11px] text-neutral-500">md (40×40)</text>
        </view>
        <view class="flex flex-col items-center gap-2">
          <c-qr-code value="https://code-ui.dev" size="lg" />
          <text class="text-[11px] text-neutral-500">lg (48×48)</text>
        </view>
      </view>
    </view>

    <!-- 4. Color Palettes -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Semantic Colors</view>
      <view class="text-xs text-neutral-400 mb-4">primary, success, warning, danger, info</view>
      <view class="flex flex-wrap items-center justify-around gap-4 p-4 bg-neutral-50/70 rounded-xl border border-neutral-200">
        <view class="flex flex-col items-center gap-2">
          <c-qr-code value="https://code-ui.dev" size="sm" color="primary" />
          <text class="text-[11px] text-primary font-medium">primary</text>
        </view>
        <view class="flex flex-col items-center gap-2">
          <c-qr-code value="https://code-ui.dev" size="sm" color="success" />
          <text class="text-[11px] text-success font-medium">success</text>
        </view>
        <view class="flex flex-col items-center gap-2">
          <c-qr-code value="https://code-ui.dev" size="sm" color="warning" />
          <text class="text-[11px] text-warning font-medium">warning</text>
        </view>
        <view class="flex flex-col items-center gap-2">
          <c-qr-code value="https://code-ui.dev" size="sm" color="danger" />
          <text class="text-[11px] text-danger font-medium">danger</text>
        </view>
        <view class="flex flex-col items-center gap-2">
          <c-qr-code value="https://code-ui.dev" size="sm" color="info" />
          <text class="text-[11px] text-info font-medium">info</text>
        </view>
      </view>
    </view>
  </view>
</view>
