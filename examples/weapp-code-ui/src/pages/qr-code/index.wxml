<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="QR Code"
    badge="Data Display"
    subtitle="SVG/Canvas QR generator supporting 5 sizes, 7 colors, ECC levels, center overlays & programmatic export."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Interactive Playground -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-4">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Live QR Playground</text>
        <text class="block text-xs text-muted mt-0.5">White frame preserves high scan contrast in both light and dark modes.</text>
      </view>

      <view class="flex items-center justify-center py-2">
        <view class="bg-white p-4 rounded-2xl border border-default shadow-xs">
          <c-qr-code
            id="demo-qr"
            value="{{ textValue }}"
            size="{{ size }}"
            ecc="{{ ecc }}"
            color="{{ color }}"
            border="{{ border }}"
            overlay="{{ showCustomOverlay ? overlayLogo : '' }}"
          />
        </view>
      </view>

      <c-input
        value="{{ textValue }}"
        placeholder="Enter URL or text..."
        clearable="{{ true }}"
        leading-icon="i-lucide-qr-code"
        bind:change="onInputChange"
      />

      <view class="flex flex-wrap gap-2">
        <c-button size="xs" variant="outline" color="primary" label="Code UI" data-preset="https://code-ui.dev" bind:tap="setPreset" />
        <c-button size="xs" variant="outline" color="neutral" label="unjs/uqr" data-preset="https://github.com/unjs/uqr" bind:tap="setPreset" />
        <c-button size="xs" variant="outline" color="neutral" label="WiFi Config" data-preset="WIFI:T:WPA;S:CodeUI_Guest;P:secret123;;" bind:tap="setPreset" />
      </view>

      <!-- Size & ECC Selectors -->
      <view class="flex flex-col gap-2 pt-2 border-t border-muted">
        <text class="text-[11px] font-mono uppercase text-dimmed">Size ({{ size }})</text>
        <view class="flex flex-wrap gap-1.5">
          <c-button
            wx:for="{{ sizeOptions }}"
            wx:key="*this"
            size="xs"
            color="{{ size === item ? 'primary' : 'neutral' }}"
            variant="{{ size === item ? 'solid' : 'outline' }}"
            label="{{ item }}"
            data-size="{{ item }}"
            bind:tap="selectSize"
          />
        </view>
      </view>

      <view class="flex flex-col gap-2">
        <text class="text-[11px] font-mono uppercase text-dimmed">Color ({{ color }})</text>
        <view class="flex flex-wrap gap-1.5">
          <c-button
            wx:for="{{ colorOptions }}"
            wx:key="*this"
            size="xs"
            color="{{ color === item ? item : 'neutral' }}"
            variant="{{ color === item ? 'solid' : 'outline' }}"
            label="{{ item }}"
            data-color="{{ item }}"
            bind:tap="selectColor"
          />
        </view>
      </view>

      <view class="flex flex-col gap-2">
        <text class="text-[11px] font-mono uppercase text-dimmed">Error Correction ({{ ecc }}) & Options</text>
        <view class="flex flex-wrap gap-1.5">
          <c-button
            wx:for="{{ eccOptions }}"
            wx:key="*this"
            size="xs"
            color="{{ ecc === item ? 'secondary' : 'neutral' }}"
            variant="{{ ecc === item ? 'solid' : 'outline' }}"
            label="ECC {{ item }}"
            data-ecc="{{ item }}"
            bind:tap="selectEcc"
          />
          <c-button size="xs" color="{{ border > 0 ? 'primary' : 'neutral' }}" variant="{{ border > 0 ? 'soft' : 'outline' }}" label="Quiet Zone: {{ border }}" bind:tap="toggleBorder" />
          <c-button size="xs" color="{{ showCustomOverlay ? 'primary' : 'neutral' }}" variant="{{ showCustomOverlay ? 'soft' : 'outline' }}" label="Overlay Logo" bind:tap="toggleCustomOverlay" />
        </view>
      </view>

      <!-- Programmatic Methods -->
      <view class="flex flex-col gap-2 pt-2 border-t border-muted">
        <text class="text-[11px] font-mono uppercase text-dimmed">Programmatic Methods</text>
        <view class="flex flex-wrap gap-2">
          <c-button size="xs" color="primary" variant="soft" label="setValue()" bind:tap="callSetValueMethod" />
          <c-button size="xs" color="secondary" variant="soft" label="getDataUrl('svg')" bind:tap="callGetDataUrlMethod" />
        </view>
        <text wx:if="{{ dataUrlPreview }}" class="text-[11px] font-mono text-muted break-all">{{ dataUrlPreview }}</text>
      </view>
    </view>

    <!-- 2. Custom UI Override Showcase -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Sizes & UI Slot Override</text>
        <text class="block text-xs text-muted mt-0.5">Comparing compact xs, secondary theme tint & custom container ui.</text>
      </view>
      <view class="flex flex-wrap items-center justify-around gap-4 py-2">
        <view class="bg-white p-2 rounded-xl border border-default">
          <c-qr-code value="https://code-ui.dev" size="xs" color="neutral" />
        </view>
        <c-qr-code value="https://code-ui.dev" size="sm" color="secondary" ui="{{ { root: 'bg-white p-3 rounded-2xl ring-2 ring-secondary/40' } }}" />
      </view>
    </view>
  </view>
</view>
