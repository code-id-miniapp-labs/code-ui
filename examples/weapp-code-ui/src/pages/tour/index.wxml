<c-app>
  <view class="min-h-screen bg-muted text-default pb-16">
    <demo-header title="Tour" badge="Overlay" subtitle="Guided spotlight walkthroughs with tooltip, dialog, floating, and interactive wait steps." />

    <view class="px-4 flex flex-col gap-4">
      <!-- Launch & Controls Card -->
      <view id="tour-hero-cta" class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
        <view class="flex items-center justify-between gap-2">
          <view class="min-w-0">
            <text class="block text-sm font-semibold text-highlighted">Guided Product Tour</text>
            <text class="block text-xs text-muted mt-0.5">
              Spotlight elements, auto-scroll off-screen targets, and flip placement cleanly.
            </text>
          </view>
          <c-badge label="{{ mainTourState.status }}" color="{{ mainTourState.status === 'completed' ? 'success' : mainTourState.status === 'started' ? 'primary' : 'neutral' }}" variant="soft" size="sm" />
        </view>

        <view class="flex flex-wrap gap-2">
          <c-button label="Start Full Tour" leading-icon="i-lucide-play" color="{{ tourColor }}" size="sm" bind:tap="startMainTour" />
          <c-button label="Start Once" variant="soft" color="primary" size="sm" bind:tap="startOnceTour" />
          <c-button wx:if="{{ mainTourState.completed }}" label="Reset Saved" variant="ghost" color="neutral" size="sm" bind:tap="resetTourStorage" />
          <c-button label="Jump to Stats" variant="outline" color="neutral" size="sm" bind:tap="startFromStats" />
          <c-button label="Interactive Wait Tour" variant="soft" color="info" size="sm" bind:tap="startWaitTour" />
        </view>

        <!-- Color & Option Toggles -->
        <view class="pt-2 border-t border-muted flex flex-col gap-2.5">
          <view class="flex flex-wrap items-center gap-1.5">
            <text class="text-xs text-muted mr-1">Color:</text>
            <c-button wx:for="{{ colorOptions }}" wx:key="*this" label="{{ item }}" size="xs" color="{{ item }}" variant="{{ tourColor === item ? 'solid' : 'soft' }}" data-color="{{ item }}" bind:tap="onSelectColor" />
          </view>
          <view class="flex flex-wrap gap-3">
            <c-switch checked="{{ progressVariant === 'text' }}" size="sm" label="Text progress (1 / N)" bind:change="onToggleProgressVariant" />
            <c-switch checked="{{ preventInteraction }}" size="sm" label="Lock spotlight target" bind:change="onTogglePreventInteraction" />
          </view>
        </view>
      </view>

      <!-- Target 2: Search Bar -->
      <view id="tour-search-box" class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-2.5">
        <text class="block text-sm font-semibold text-highlighted">Workspace Search</text>
        <text class="block text-xs text-muted">
          When preventInteraction is off, users can still interact directly with spotlighted controls.
        </text>
        <c-input value="{{ query }}" placeholder="Try searching components..." leading-icon="i-lucide-search" clearable="{{ true }}" bind:change="onQueryChange" bind:clear="onQueryClear" />
      </view>

      <!-- Target 3: Interactive Wait Action -->
      <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-2.5">
        <text class="block text-sm font-semibold text-highlighted">Interactive Wait Step Target</text>
        <text class="block text-xs text-muted">
          Launch the Interactive Wait Tour, then tap the highlighted button below to advance automatically.
        </text>
        <view id="tour-wait-btn" class="self-start">
          <c-button label="Tap Me to Continue ({{ tapCount }})" leading-icon="i-lucide-sparkles" color="info" variant="solid" size="sm" bind:tap="onWaitTargetTap" />
        </view>
      </view>

      <!-- Target 4: Stats Grid -->
      <view id="tour-quick-stats" class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
        <text class="block text-sm font-semibold text-highlighted">Live Metrics Overview</text>
        <view class="grid grid-cols-3 gap-2.5">
          <view class="p-3 rounded-xl bg-muted border border-muted flex flex-col gap-0.5">
            <text class="text-2xs text-muted">Steps</text>
            <text class="text-base font-bold text-highlighted">6</text>
          </view>
          <view class="p-3 rounded-xl bg-muted border border-muted flex flex-col gap-0.5">
            <text class="text-2xs text-muted">Modes</text>
            <text class="text-base font-bold text-highlighted">4</text>
          </view>
          <view class="p-3 rounded-xl bg-muted border border-muted flex flex-col gap-0.5">
            <text class="text-2xs text-muted">Renderer</text>
            <text class="text-base font-bold text-highlighted">Skyline</text>
          </view>
        </view>
      </view>

      <!-- Spacer to test autoScroll + bottom collision flip -->
      <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-2">
        <text class="block text-sm font-semibold text-highlighted">Scrollable Content Section</text>
        <text class="block text-xs text-muted leading-relaxed">
          Tours automatically scroll off-screen target elements into view using wx.pageScrollTo before snapping the spotlight cutout and directional tooltip card.
        </text>
        <view class="h-40 rounded-xl bg-muted border border-dashed border-default flex items-center justify-center">
          <text class="text-xs text-muted">Page content spacer</text>
        </view>
      </view>

      <!-- Target 5: Bottom Card (auto-scrolls and flips tooltip to top) -->
      <view id="tour-finish-card" class="bg-default border border-default rounded-2xl p-4 flex items-center justify-between gap-3">
        <view class="min-w-0">
          <text class="block text-sm font-semibold text-highlighted">Auto-Scroll &amp; Collision Flip</text>
          <text class="block text-xs text-muted mt-0.5">
            Near the bottom edge, the tooltip flips cleanly above this card.
          </text>
        </view>
        <c-badge label="Ready" color="success" variant="subtle" size="sm" />
      </view>
    </view>

    <!-- Main Guided Tour (driven by useTour) -->
    <c-tour
      id="main-tour"
      steps="{{ mainTourState.steps }}"
      color="{{ tourColor }}"
      progress-variant="{{ progressVariant }}"
      prevent-interaction="{{ preventInteraction }}"
      skip-label="Skip"
    />

    <!-- Interactive Wait Tour -->
    <c-tour
      id="wait-tour"
      steps="{{ waitSteps }}"
      color="info"
      close-on-interact-outside="{{ false }}"
    />
  </view>
</c-app>
