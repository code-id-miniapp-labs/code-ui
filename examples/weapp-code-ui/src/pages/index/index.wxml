<view class="min-h-screen bg-muted text-default pb-12 transition-colors duration-200">
  <!-- Hero Banner -->
  <view class="bg-default border-b border-default px-4 pt-4 pb-5">
    <view class="flex items-start justify-between gap-3">
      <view class="flex-1 min-w-0">
        <view class="flex items-center gap-2 flex-wrap">
          <text class="text-2xl font-bold text-highlighted tracking-tight">Code UI</text>
          <c-badge label="{{ totalCount }} Components" color="primary" variant="soft" size="sm" />
        </view>
        <text class="block text-sm text-muted mt-1 leading-relaxed">
          Headless + Nuxt UI v4-inspired WeChat MiniProgram component library with runtime theming & dark mode.
        </text>
      </view>

      <c-button
        size="sm"
        color="neutral"
        variant="outline"
        icon="{{ isDark ? 'i-lucide-sun' : 'i-lucide-moon' }}"
        label="{{ isDark ? 'Light' : 'Dark' }}"
        bind:tap="onSelectColorMode"
        data-mode="{{ isDark ? 'light' : 'dark' }}"
      />
    </view>
  </view>

  <view class="px-4 pt-4 flex flex-col gap-4">
    <!-- Runtime Theme Studio Card -->
    <c-card variant="outline">
      <view slot="header" class="flex items-center justify-between gap-2" bind:tap="toggleStudio">
        <view class="flex items-center gap-2">
          <view class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
            <c-icon name="i-lucide-palette" size="sm" color="primary" />
          </view>
          <view>
            <text class="block text-sm font-semibold text-highlighted">Runtime Theme Studio</text>
            <text class="block text-[11px] text-muted">
              Mode: {{ colorMode }} ({{ isDark ? 'Dark' : 'Light' }}) · Primary: {{ activePrimary }}
            </text>
          </view>
        </view>
        <view class="flex items-center gap-2">
          <c-badge wx:if="{{ hasCustomTheme }}" label="Custom" color="secondary" variant="soft" size="xs" />
          <c-icon
            name="{{ studioExpanded ? 'i-lucide-chevron-up' : 'i-lucide-chevron-down' }}"
            size="sm"
            color="neutral"
          />
        </view>
      </view>

      <view wx:if="{{ studioExpanded }}" class="flex flex-col gap-4">
        <!-- Color Mode Selector -->
        <view class="flex items-center justify-between gap-2 flex-wrap">
          <text class="text-xs font-semibold text-toned">Appearance</text>
          <view class="inline-flex items-center bg-elevated p-1 rounded-lg gap-1 border border-default">
            <view
              data-mode="light"
              bind:tap="onSelectColorMode"
              class="px-2.5 py-1 rounded-md text-xs font-medium flex items-center gap-1 transition-colors {{ colorMode === 'light' ? 'bg-default text-highlighted shadow-xs' : 'text-muted' }}"
            >
              <c-icon name="i-lucide-sun" size="xs" color="{{ colorMode === 'light' ? 'primary' : 'neutral' }}" />
              <text>Light</text>
            </view>
            <view
              data-mode="dark"
              bind:tap="onSelectColorMode"
              class="px-2.5 py-1 rounded-md text-xs font-medium flex items-center gap-1 transition-colors {{ colorMode === 'dark' ? 'bg-default text-highlighted shadow-xs' : 'text-muted' }}"
            >
              <c-icon name="i-lucide-moon" size="xs" color="{{ colorMode === 'dark' ? 'primary' : 'neutral' }}" />
              <text>Dark</text>
            </view>
            <view
              data-mode="system"
              bind:tap="onSelectColorMode"
              class="px-2.5 py-1 rounded-md text-xs font-medium flex items-center gap-1 transition-colors {{ colorMode === 'system' ? 'bg-default text-highlighted shadow-xs' : 'text-muted' }}"
            >
              <c-icon name="i-lucide-smartphone" size="xs" color="{{ colorMode === 'system' ? 'primary' : 'neutral' }}" />
              <text>System</text>
            </view>
          </view>
        </view>

        <!-- Primary Presets -->
        <view class="flex flex-col gap-2">
          <view class="flex items-center justify-between">
            <text class="text-xs font-semibold text-toned">Primary Palette</text>
            <text class="text-[11px] font-mono text-dimmed">{{ activePrimary }}</text>
          </view>
          <view class="flex flex-wrap gap-2">
            <view
              wx:for="{{ primaryPresets }}"
              wx:key="id"
              data-value="{{ item.value }}"
              bind:tap="onSelectPrimaryColor"
              class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border text-xs transition-all {{ activePrimary === item.value ? 'border-primary bg-primary/10 text-highlighted font-medium' : 'border-default bg-default text-muted' }}"
            >
              <view class="w-3.5 h-3.5 rounded-full shrink-0" style="background-color: {{ item.hex }};" />
              <text>{{ item.label }}</text>
            </view>
          </view>
        </view>

        <!-- Secondary Presets -->
        <view class="flex flex-col gap-2">
          <view class="flex items-center justify-between">
            <text class="text-xs font-semibold text-toned">Secondary Palette</text>
            <text class="text-[11px] font-mono text-dimmed">{{ activeSecondary }}</text>
          </view>
          <view class="flex flex-wrap gap-2">
            <view
              wx:for="{{ secondaryPresets }}"
              wx:key="id"
              data-value="{{ item.value }}"
              bind:tap="onSelectSecondaryColor"
              class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border text-xs transition-all {{ activeSecondary === item.value ? 'border-secondary bg-secondary/10 text-highlighted font-medium' : 'border-default bg-default text-muted' }}"
            >
              <view class="w-3.5 h-3.5 rounded-full shrink-0" style="background-color: {{ item.hex }};" />
              <text>{{ item.label }}</text>
            </view>
          </view>
        </view>

        <!-- Custom Hex / Runtime Color Input -->
        <view class="flex flex-col gap-2 pt-2 border-t border-muted">
          <view class="flex items-center justify-between gap-2">
            <text class="text-xs font-semibold text-toned">Custom Hex Color</text>
            <view class="inline-flex items-center bg-elevated rounded-md p-0.5 gap-0.5 border border-default">
              <view
                data-target="primary"
                bind:tap="onSelectCustomTarget"
                class="px-2 py-0.5 rounded text-[11px] font-medium {{ customTarget === 'primary' ? 'bg-default text-highlighted' : 'text-muted' }}"
              >
                <text>Primary</text>
              </view>
              <view
                data-target="secondary"
                bind:tap="onSelectCustomTarget"
                class="px-2 py-0.5 rounded text-[11px] font-medium {{ customTarget === 'secondary' ? 'bg-default text-highlighted' : 'text-muted' }}"
              >
                <text>Secondary</text>
              </view>
            </view>
          </view>

          <view class="flex items-center gap-2">
            <view class="flex-1 min-w-0">
              <c-input
                value="{{ customHex }}"
                placeholder="e.g. #8b5cf6 or emerald"
                size="sm"
                clearable="{{ true }}"
                leading-icon="i-lucide-hash"
                bind:change="onCustomHexChange"
                bind:clear="onCustomHexClear"
              />
            </view>
            <c-button size="sm" color="primary" label="Apply" bind:tap="onApplyCustomHex" />
            <c-button
              wx:if="{{ hasCustomTheme }}"
              size="sm"
              color="neutral"
              variant="outline"
              icon="i-lucide-rotate-ccw"
              bind:tap="onResetTheme"
            />
          </view>
          <text wx:if="{{ hexError }}" class="text-xs text-danger">{{ hexError }}</text>
        </view>

        <!-- Live Preview Strip -->
        <view class="rounded-xl bg-muted border border-muted p-3 flex flex-col gap-2.5">
          <text class="text-[11px] font-medium uppercase tracking-wider text-dimmed">Live Theme Preview</text>
          <view class="flex items-center flex-wrap gap-2">
            <c-button size="xs" color="primary" label="Primary" />
            <c-button size="xs" color="secondary" label="Secondary" />
            <c-badge label="Soft Badge" color="primary" variant="soft" size="sm" />
            <c-badge label="Secondary" color="secondary" variant="outline" size="sm" />
            <c-switch checked="{{ true }}" size="sm" color="primary" />
          </view>
          <c-progress value="{{ 68 }}" color="primary" size="sm" show-value="{{ true }}" />
        </view>
      </view>
    </c-card>

    <!-- Search & Category Filters -->
    <view class="flex flex-col gap-3">
      <c-input
        value="{{ searchQuery }}"
        placeholder="Search components, features, or tags..."
        size="md"
        clearable="{{ true }}"
        leading-icon="i-lucide-search"
        bind:change="onSearchChange"
        bind:clear="onSearchClear"
      />

      <view class="flex items-center flex-wrap gap-3 pt-1">
        <c-chip
          wx:for="{{ categories }}"
          wx:key="id"
          text="{{ item.count }}"
          size="md"
          color="{{ activeCategory === item.id ? 'primary' : 'neutral' }}"
        >
          <c-button
            size="sm"
            color="{{ activeCategory === item.id ? 'primary' : 'neutral' }}"
            variant="{{ activeCategory === item.id ? 'soft' : 'outline' }}"
            label="{{ item.label }}"
            data-category="{{ item.id }}"
            bind:tap="onSelectCategory"
          />
        </c-chip>
      </view>

      <view class="flex items-center justify-between px-0.5">
        <text class="text-xs font-medium text-dimmed">
          Showing {{ filteredComponents.length }} of {{ totalCount }} components
        </text>
        <text
          wx:if="{{ activeCategory !== 'all' || searchQuery }}"
          bind:tap="onResetFilters"
          class="text-xs font-medium text-primary"
        >
          Clear filter
        </text>
      </view>
    </view>

    <!-- Component Cards -->
    <view wx:if="{{ filteredComponents.length > 0 }}" class="flex flex-col gap-2.5">
      <view
        wx:for="{{ filteredComponents }}"
        wx:key="id"
        data-path="{{ item.path }}"
        bind:tap="navigateTo"
        class="bg-default border border-default rounded-xl p-3.5 active:bg-elevated transition-colors"
      >
        <view class="flex items-start gap-3">
          <view class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
            <c-icon name="{{ item.icon }}" size="md" color="primary" />
          </view>

          <view class="flex-1 min-w-0">
            <view class="flex items-center justify-between gap-2">
              <view class="flex items-center gap-2 min-w-0">
                <text class="text-base font-semibold text-highlighted">{{ item.name }}</text>
                <c-badge label="{{ item.categoryLabel }}" color="neutral" variant="soft" size="xs" />
              </view>
              <c-icon name="i-lucide-chevron-right" size="sm" color="neutral" ui="{{ { root: 'text-dimmed' } }}" />
            </view>

            <text class="block text-xs text-muted mt-1 leading-relaxed">{{ item.desc }}</text>

            <view class="flex items-center flex-wrap gap-1.5 mt-2">
              <view
                wx:for="{{ item.highlights }}"
                wx:for-item="tag"
                wx:key="*this"
                class="px-2 py-0.5 rounded bg-elevated text-[11px] font-mono text-toned"
              >
                <text>{{ tag }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Empty Filter State -->
    <view
      wx:else
      class="bg-default border border-default rounded-xl p-8 flex flex-col items-center justify-center gap-2 text-center"
    >
      <view class="w-10 h-10 rounded-full bg-elevated flex items-center justify-center">
        <c-icon name="i-lucide-search-x" size="md" color="neutral" />
      </view>
      <text class="text-sm font-semibold text-highlighted">No matching components</text>
      <text class="text-xs text-muted">Try another keyword or clear your active category filter.</text>
      <c-button size="xs" color="primary" variant="soft" label="Show All Components" bind:tap="onResetFilters" class="mt-1" />
    </view>
  </view>
</view>
