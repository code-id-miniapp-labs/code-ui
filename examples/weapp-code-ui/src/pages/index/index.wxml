<view class="min-h-screen bg-neutral-50 text-neutral-900 pb-16">
  <view class="px-6 pt-10 pb-6 bg-white border-b border-neutral-200">
    <view class="text-2xl font-extrabold tracking-tight text-neutral-950">Code UI</view>
    <view class="text-sm text-neutral-500 mt-1 leading-relaxed">Preview Code-ui</view>
  </view>
  <!-- Component Navigation Grid -->
  <view class="px-5 py-6 flex flex-col gap-4">
    <view class="text-xs font-bold text-neutral-400 uppercase tracking-wider px-1">Components</view>
    <block wx:for="{{components}}" wx:key="id">
      <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs hover:border-neutral-300 transition-all active:scale-[0.99] active:bg-neutral-50" data-path="{{item.path}}" bind:tap="navigateToComponent">
        <view class="flex items-center justify-between mb-1.5">
          <view class="text-base font-bold text-neutral-900">{{item.name}}</view>
          <view class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600">
            {{item.badge}}
          </view>
        </view>
        <view class="text-xs text-neutral-500 leading-relaxed">{{item.desc}}</view>
        <view class="mt-3 flex items-center gap-1 text-xs font-semibold text-emerald-600">
          <text>View Examples</text>
          <text class="text-sm">›</text>
        </view>
      </view>
    </block>
  </view>
</view>