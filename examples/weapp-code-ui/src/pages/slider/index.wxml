<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Slider"
    badge="Form"
    subtitle="WXS 60fps range & single-value slider with vertical mode, inverted tracks, marks, slots & FormField support."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Single & Range Controlled -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-4">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled Single & Range Sliders</text>
        <text class="block text-xs text-muted mt-0.5">Last event: {{ lastEvent }}</text>
      </view>

      <c-slider
        label="Brightness"
        show-value="{{ true }}"
        value="{{ singleValue }}"
        color="primary"
        bind:change="onSingleChange"
      />
      <view class="flex gap-2">
        <c-button size="xs" variant="soft" color="primary" label="Set to 70" bind:tap="setSingleTo70" />
      </view>

      <view class="pt-2 border-t border-muted">
        <c-slider
          label="Price Range ($)"
          show-value="{{ true }}"
          value="{{ rangeValue }}"
          min-steps-between-thumbs="{{ 10 }}"
          color="secondary"
          bind:change="onRangeChange"
        />
      </view>
    </view>

    <!-- 2. Steps, Marks, Custom Bounds & Inverted -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-4">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Steps, Scale Marks, Bounds & Inverted</text>
        <text class="block text-xs text-muted mt-0.5">Discrete steps with labeled marks, min=10/max=50 bounds & reversed fill.</text>
      </view>

      <c-slider label="Temperature" show-value="{{ true }}" default-value="{{ stepValue }}" step="{{ 25 }}" marks="{{ marks }}" color="warning" />
      <c-slider label="Bounded Range (10 to 50, step 5)" show-value="{{ true }}" min="{{ 10 }}" max="{{ 50 }}" step="{{ 5 }}" default-value="{{ 30 }}" color="info" />
      <c-slider label="Inverted Track (Right-to-Left)" show-value="{{ true }}" default-value="{{ invertedValue }}" inverted="{{ true }}" color="danger" />
    </view>

    <!-- 3. Vertical Orientation & Custom Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-4">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Vertical Orientation & Custom Slots</text>
        <text class="block text-xs text-muted mt-0.5">Vertical mixer channels plus label, value & thumb custom slots.</text>
      </view>

      <view class="flex items-center justify-around h-44 py-2">
        <view class="h-full flex flex-col items-center gap-2">
          <c-slider orientation="vertical" default-value="{{ 70 }}" color="primary" size="sm" />
          <text class="text-[11px] text-dimmed">Bass</text>
        </view>
        <view class="h-full flex flex-col items-center gap-2">
          <c-slider orientation="vertical" default-value="{{ 45 }}" color="secondary" size="md" />
          <text class="text-[11px] text-dimmed">Mid</text>
        </view>
        <view class="h-full flex flex-col items-center gap-2">
          <c-slider orientation="vertical" default-value="{{ 85 }}" color="success" size="lg" />
          <text class="text-[11px] text-dimmed">Master</text>
        </view>
      </view>

      <view class="pt-3 border-t border-muted">
        <c-slider default-value="{{ 60 }}" color="primary" size="lg">
          <view slot="label" class="flex items-center gap-1.5">
            <c-icon name="i-lucide-sliders" size="xs" color="primary" />
            <text class="text-xs font-semibold text-highlighted">Audio Gain</text>
          </view>
          <view slot="value">
            <c-badge label="Custom Slot" size="xs" color="secondary" variant="soft" />
          </view>
        </c-slider>
      </view>
    </view>

    <!-- 4. Colors, Sizes & States -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Colors, Sizes & States</text>
        <text class="block text-xs text-muted mt-0.5">All 7 colors, xs-xl sizes, disabled, readOnly & invalid states.</text>
      </view>
      <view class="flex flex-col gap-3">
        <c-slider wx:for="{{ colors }}" wx:key="*this" default-value="{{ 50 + index * 5 }}" color="{{ item }}" />
      </view>
      <view class="flex flex-col gap-3 pt-2 border-t border-muted">
        <c-slider wx:for="{{ sizes }}" wx:key="*this" default-value="{{ 65 }}" size="{{ item }}" color="primary" />
      </view>
      <view class="flex flex-col gap-3 pt-2 border-t border-muted">
        <c-slider label="Disabled" default-value="{{ 40 }}" disabled="{{ true }}" />
        <c-slider label="Read-Only" default-value="{{ 75 }}" read-only="{{ true }}" />
        <c-slider label="Invalid" default-value="{{ 20 }}" invalid="{{ true }}" />
      </view>
    </view>

    <!-- 5. Form Validation -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Form & Budget Validation</text>
        <text class="block text-xs text-muted mt-0.5">Requires minimum campaign budget of $40.</text>
      </view>
      <c-form id="slider-demo-form" bind:submit="handleFormSubmit" bind:error="handleFormError">
        <c-form-field name="budget" label="Daily Budget ($40 min)" required="{{ true }}" rules="{{ budgetRules }}">
          <c-slider value="{{ formBudgetValue }}" show-value="{{ true }}" bind:change="onFormBudgetChange" />
        </c-form-field>
      </c-form>
      <view class="flex flex-wrap gap-2">
        <c-button size="xs" color="primary" label="Submit" bind:tap="submitSliderForm" />
        <c-button size="xs" color="secondary" variant="soft" label="Set $80" bind:tap="setFormBudgetTo80" />
        <c-button size="xs" color="neutral" variant="outline" label="Reset" bind:tap="resetSliderForm" />
      </view>
      <text wx:if="{{ formStatus }}" class="text-xs text-muted">{{ formStatus }}: {{ formMessage }}</text>
    </view>
  </view>
</view>
