<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Pin Input"
    badge="Form"
    subtitle="Segmented OTP & authorization code boxes supporting 5 variants, 7 colors, 5 sizes, mask, separator & alphanumeric input."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Controlled State -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled State & Complete Event</text>
        <text class="block text-xs text-muted mt-0.5">Last complete: {{ pinCompleteValue || 'Waiting for 4 digits...' }}</text>
      </view>
      <c-pin-input
        label="Verification Code"
        value="{{ controlledPin }}"
        bind:change="onPinChange"
        bind:complete="onPinComplete"
      />
      <view class="flex gap-2">
        <c-button size="xs" variant="outline" color="primary" label="Fill 9876" bind:tap="fillPin" />
        <c-button size="xs" variant="outline" color="neutral" label="Clear" bind:tap="clearPin" />
      </view>
    </view>

    <!-- 2. Variants -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Variants</text>
        <text class="block text-xs text-muted mt-0.5">outline, soft, subtle, ghost & none.</text>
      </view>
      <view class="flex flex-col gap-3">
        <c-pin-input
          wx:for="{{ variants }}"
          wx:key="*this"
          label="{{ item }}"
          variant="{{ item }}"
          placeholder="0"
        />
      </view>
    </view>

    <!-- 3. Semantic Colors & Highlight -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Colors & Focus Highlight</text>
        <text class="block text-xs text-muted mt-0.5">Includes secondary & highlight active ring mode.</text>
      </view>
      <view class="flex flex-col gap-3">
        <c-pin-input
          wx:for="{{ colors }}"
          wx:key="*this"
          label="{{ item }} (highlight)"
          color="{{ item }}"
          variant="outline"
          highlight="{{ true }}"
          value="{{ ['1', '2', '', ''] }}"
        />
      </view>
    </view>

    <!-- 4. Sizes Scale -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Sizes (xs-xl)</text>
        <text class="block text-xs text-muted mt-0.5">Compact xs to prominent xl cell geometry.</text>
      </view>
      <view class="flex flex-col gap-3">
        <c-pin-input
          wx:for="{{ sizes }}"
          wx:key="*this"
          label="Size: {{ item }}"
          size="{{ item }}"
          value="{{ ['7', '4', '2', '9'] }}"
        />
      </view>
    </view>

    <!-- 5. Length, Separators, Alphanumeric & Mask -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">6-Digit Separators, Alphanumeric & Mask</text>
        <text class="block text-xs text-muted mt-0.5">Custom grouping, alphanumeric input & password masking.</text>
      </view>
      <c-pin-input label="Grouped (3-3) with Dot" length="{{ 6 }}" separator="{{ 3 }}" separator-char="·" />
      <c-pin-input label="Alphanumeric Invite Code" type="alphanumeric" value="{{ alphaPin }}" placeholder="A" bind:change="onAlphaChange" />
      <c-pin-input label="Masked PIN" mask="{{ true }}" placeholder="•" value="{{ ['4', '2', '9', '1'] }}" />
    </view>

    <!-- 6. States & FormField Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Validation States & Custom Label Slot</text>
        <text class="block text-xs text-muted mt-0.5">Invalid, disabled, readOnly, custom label slot & FormField integration.</text>
      </view>

      <c-pin-input invalid="{{ true }}" value="{{ ['1', '2', '3', '4'] }}">
        <view slot="label" class="flex items-center gap-1.5 mb-1.5">
          <c-icon name="i-lucide-shield-alert" size="xs" color="danger" />
          <text class="text-xs font-semibold text-danger">Invalid Code State</text>
        </view>
      </c-pin-input>

      <c-pin-input label="Disabled" disabled="{{ true }}" value="{{ ['5', '6', '7', '8'] }}" />
      <c-pin-input label="Read-Only" read-only="{{ true }}" value="{{ ['2', '0', '2', '6'] }}" />

      <c-form-field
        label="2FA Backup PIN"
        hint="Required"
        help="Wrapped inside c-form-field for aligned label/hint/error layout."
        required="{{ true }}"
      >
        <c-pin-input length="{{ 4 }}" variant="soft" />
      </c-form-field>
    </view>
  </view>
</view>
