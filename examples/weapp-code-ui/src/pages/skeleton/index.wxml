<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Skeleton"
    badge="Data Display"
    subtitle="Placeholder shimmer frames supporting pulse, shine & none variants across loaded states."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Interactive Loading State Transition -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view class="flex items-center justify-between gap-3">
        <view>
          <text class="block text-sm font-semibold text-highlighted">Loading State Toggle</text>
          <text class="block text-xs text-muted mt-0.5">Switch between skeleton wireframe and loaded UI.</text>
        </view>
        <view class="flex items-center gap-2">
          <text class="text-xs text-muted">{{ loading ? 'Loading' : 'Loaded' }}</text>
          <c-switch checked="{{ loading }}" size="sm" color="primary" bind:change="onToggleLoading" />
        </view>
      </view>

      <view class="flex items-center gap-1.5">
        <text class="text-xs text-dimmed mr-1">Variant:</text>
        <c-button
          wx:for="{{ variants }}"
          wx:key="*this"
          size="xs"
          color="{{ variant === item ? 'primary' : 'neutral' }}"
          variant="{{ variant === item ? 'solid' : 'outline' }}"
          label="{{ item }}"
          data-variant="{{ item }}"
          bind:tap="onSelectVariant"
        />
      </view>

      <view class="border border-muted rounded-xl p-3 bg-muted">
        <view wx:if="{{ loading }}" class="flex items-center gap-3">
          <c-skeleton variant="{{ variant }}" className="w-12 h-12 rounded-full shrink-0" />
          <view class="flex-1 flex flex-col gap-2">
            <c-skeleton variant="{{ variant }}" className="h-4 w-44 rounded-md" />
            <c-skeleton variant="{{ variant }}" className="h-3 w-28 rounded-md" />
          </view>
        </view>
        <view wx:else class="flex items-center gap-3">
          <c-avatar text="CU" size="lg" color="primary" />
          <view class="flex-1 min-w-0">
            <view class="flex items-center gap-2">
              <text class="text-sm font-semibold text-highlighted">Code UI Team</text>
              <c-badge label="Pro" color="primary" variant="soft" size="xs" />
            </view>
            <text class="block text-xs text-muted mt-0.5">Headless MiniProgram UI Kit</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 2. Animation Variants Comparison -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Animation Variants</text>
        <text class="block text-xs text-muted mt-0.5">Compare pulse, shine sweep & static (none) placeholders.</text>
      </view>

      <view class="flex flex-col gap-3">
        <view class="flex items-center gap-3">
          <text class="w-14 text-xs font-mono text-dimmed">pulse</text>
          <c-skeleton variant="pulse" className="h-8 flex-1 rounded-lg" />
        </view>
        <view class="flex items-center gap-3">
          <text class="w-14 text-xs font-mono text-dimmed">shine</text>
          <c-skeleton variant="shine" className="h-8 flex-1 rounded-lg" />
        </view>
        <view class="flex items-center gap-3">
          <text class="w-14 text-xs font-mono text-dimmed">none</text>
          <c-skeleton variant="none" className="h-8 flex-1 rounded-lg" />
        </view>
      </view>
    </view>

    <!-- 3. Feed Card & Dashboard Metrics Wireframe -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Rich Card & List Placeholders</text>
        <text class="block text-xs text-muted mt-0.5">Compose arbitrary layouts via className and ui slots.</text>
      </view>

      <view class="border border-muted rounded-xl p-3 flex flex-col gap-3">
        <c-skeleton variant="shine" className="h-32 w-full rounded-xl" />
        <view class="flex flex-col gap-2">
          <c-skeleton variant="pulse" className="h-4 w-3/4 rounded" />
          <c-skeleton variant="pulse" className="h-3 w-full rounded" />
          <c-skeleton variant="pulse" className="h-3 w-5/6 rounded" />
        </view>
        <view class="flex items-center justify-between pt-2 border-t border-muted">
          <c-skeleton variant="pulse" className="h-6 w-20 rounded-full" />
          <c-skeleton variant="pulse" className="h-6 w-16 rounded-md" />
        </view>
      </view>
    </view>
  </view>
</view>
