<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Avatar"
    badge="Data Display"
    subtitle="User image & initials avatars across 9 sizes (3xs-3xl), 7 colors, fallback slots, image mode & chip integration."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Size Scale (3xs - 3xl) -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Full Size Scale (3xs - 3xl)</text>
        <text class="block text-xs text-muted mt-0.5">All 9 sizes with proportional image & fallback typography.</text>
      </view>
      <view class="flex flex-wrap items-end gap-3">
        <view wx:for="{{ sizes }}" wx:key="*this" class="flex flex-col items-center gap-1">
          <c-avatar size="{{ item }}" src="https://api.dicebear.com/7.x/avataaars/svg?seed=Avatar{{ item }}" alt="User {{ item }}" />
          <text class="text-[10px] font-mono text-dimmed">{{ item }}</text>
        </view>
      </view>
    </view>

    <!-- 2. Initials, Semantic Colors & Fallbacks -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Fallbacks & Semantic Colors</text>
        <text class="block text-xs text-muted mt-0.5">Initials from alt/text plus icon fallback across all 7 colors.</text>
      </view>
      <view class="flex flex-wrap items-center gap-3">
        <view wx:for="{{ colors }}" wx:key="*this" class="flex flex-col items-center gap-1">
          <c-avatar color="{{ item }}" size="lg" alt="{{ item }} User" />
          <text class="text-[10px] text-dimmed">{{ item }}</text>
        </view>
      </view>
      <view class="flex flex-wrap items-center gap-3 pt-2 border-t border-muted">
        <c-avatar color="primary" size="lg" icon="i-lucide-user" />
        <c-avatar color="secondary" size="lg" text="VIP" />
        <c-avatar color="danger" size="lg" src="https://invalid.example/broken-img.png" alt="Error Fallback" />
        <c-chip color="success" position="bottom-right" inset="{{ true }}" size="sm">
          <c-avatar size="lg" src="{{ sampleImg }}" alt="Online User" />
        </c-chip>
      </view>
    </view>

    <!-- 3. Custom Slots & Image Modes -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Custom Slots & Image Crop Modes</text>
        <text class="block text-xs text-muted mt-0.5">Override icon/default slot or customize aspectFit vs aspectFill.</text>
      </view>
      <view class="flex flex-wrap items-center gap-4">
        <view class="flex flex-col items-center gap-1">
          <c-avatar size="xl" color="primary">
            <c-icon slot="icon" name="i-lucide-sparkles" size="md" color="primary" />
          </c-avatar>
          <text class="text-[10px] text-dimmed">slot="icon"</text>
        </view>
        <view class="flex flex-col items-center gap-1">
          <c-avatar size="xl" color="secondary" ui="{{ { root: 'rounded-xl ring-2 ring-secondary/40' } }}">
            <text class="text-xs font-bold">CU</text>
          </c-avatar>
          <text class="text-[10px] text-dimmed">default + ui</text>
        </view>
        <view class="flex flex-col items-center gap-1">
          <c-avatar size="xl" mode="aspectFill" src="{{ sampleImg }}" />
          <text class="text-[10px] text-dimmed">aspectFill</text>
        </view>
        <view class="flex flex-col items-center gap-1">
          <c-avatar size="xl" mode="aspectFit" color="neutral" src="{{ sampleImg }}" />
          <text class="text-[10px] text-dimmed">aspectFit</text>
        </view>
      </view>
    </view>
  </view>
</view>
