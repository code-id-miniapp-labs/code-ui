<view class="min-h-screen bg-neutral-50 text-neutral-900 pb-16">
  <!-- Page Header -->
  <view class="px-6 pt-8 pb-5 bg-white border-b border-neutral-200 mb-6">
    <view class="text-xl font-extrabold text-neutral-950">Avatar</view>
    <view class="text-xs text-neutral-500 mt-1">
      User profile representation with image, initials, and icon fallbacks.
    </view>
  </view>
  <view class="px-5 flex flex-col gap-6">
    <!-- Basic & Sizes -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Sizes</view>
      <view class="text-xs text-neutral-400 mb-5">Standard size options from 3xs to 3xl.</view>
      <view class="flex flex-wrap gap-6 items-center">
        <c-avatar size="3xs" src="https://api.dicebear.com/7.x/avataaars/svg?seed=1" />
        <c-avatar size="xs" src="https://api.dicebear.com/7.x/avataaars/svg?seed=2" />
        <c-avatar size="sm" src="https://api.dicebear.com/7.x/avataaars/svg?seed=3" />
        <c-avatar size="md" src="https://api.dicebear.com/7.x/avataaars/svg?seed=4" />
        <c-avatar size="lg" src="https://api.dicebear.com/7.x/avataaars/svg?seed=5" />
        <c-avatar size="xl" src="https://api.dicebear.com/7.x/avataaars/svg?seed=6" />
        <c-avatar size="2xl" src="https://api.dicebear.com/7.x/avataaars/svg?seed=7" />
        <c-avatar size="3xl" src="https://github.com/rdjanuar.png" />
      </view>
    </view>
    <!-- Colors & Fallbacks -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Colors & Fallbacks</view>
      <view class="text-xs text-neutral-400 mb-5">
        Semantic colors used when images are missing or fail to load.
      </view>
      <view class="flex flex-wrap gap-6 items-center">
        <!-- Initials from Alt -->
        <c-avatar color="primary" alt="Rizky Djanuar" />
        <c-avatar color="success" alt="Jane Doe" />
        <c-avatar color="warning" alt="John Smith" />
        <c-avatar color="danger" alt="Alex" />
        <c-avatar color="info" alt="Sarah Connor" />
        <c-avatar color="neutral" alt="Guest User" />
      </view>
    </view>
    <!-- Explicit Text -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Explicit Text</view>
      <view class="text-xs text-neutral-400 mb-5">
        Overriding the auto-generated initials with custom text.
      </view>
      <view class="flex flex-wrap gap-6 items-center">
        <c-avatar color="primary" text="ADMIN" size="lg" />
        <c-avatar color="neutral" text="USER" size="lg" />
      </view>
    </view>
    <!-- Custom Icons -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Custom Icons</view>
      <view class="text-xs text-neutral-400 mb-5">
        Using slots to render custom icons inside the avatar.
      </view>
      <view class="flex flex-wrap gap-6 items-center">
        <c-avatar color="neutral" size="lg" icon="i-lucide-user" />
        <c-avatar color="neutral" size="lg" icon="i-lucide-home" />
        <c-avatar color="neutral" size="lg" icon="i-lucide-eye" />
      </view>
    </view>
    <!-- Load Error Simulation -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Load Error Handling</view>
      <view class="text-xs text-neutral-400 mb-5">
        Automatically switching to fallback when image URL is broken.
      </view>
      <view class="flex flex-wrap gap-6 items-center">
        <c-avatar src="https://invalid-url.com/image.png" alt="Error User" color="danger" size="lg" />
        <c-avatar src="https://invalid-url.com/avatar.jpg" alt="Broken Image" color="warning" size="lg" />
      </view>
    </view>
  </view>
</view>