<view class="min-h-screen bg-neutral-50 text-neutral-900 pb-20">
  <!-- Page Header -->
  <view class="px-6 pt-8 pb-5 bg-white border-b border-neutral-200 mb-6">
    <view class="text-xl font-extrabold text-neutral-950">Checkbox & CheckboxGroup</view>
    <view class="text-xs text-neutral-500 mt-1">
      Accessible checkbox and multi-select groups with indeterminate state, card variants, min/max limits, zero-bloat icons, and Form validation.
    </view>
  </view>
  <view class="px-5 flex flex-col gap-6">
    <!-- 1. Standalone Controlled Checkbox -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">1. Controlled Standalone Checkbox</view>
      <view class="text-xs text-neutral-400 mb-3">
        Declarative two-way sync via checked prop and bind:change event.
      </view>
      <view class="flex flex-col gap-4">
        <c-checkbox checked="{{controlledChecked}}" label="Enable push notifications" description="Receive real-time alerts on your device" bind:change="onControlledChange" />
        <view class="flex items-center justify-between text-xs bg-neutral-50 p-3 rounded-xl border border-neutral-200">
          <text class="text-neutral-500">Checked Status:</text>
          <text class="font-bold {{controlledChecked ? 'text-primary' : 'text-neutral-400'}} font-mono">
            {{controlledChecked ? 'true' : 'false'}}
          </text>
        </view>
        <view class="flex flex-wrap gap-2 pt-1">
          <c-button size="sm" variant="outline" color="primary" bind:tap="setControlledTrue">
            Set True
          </c-button>
          <c-button size="sm" variant="outline" color="neutral" bind:tap="setControlledFalse">
            Set False
          </c-button>
          <c-button size="sm" variant="outline" color="neutral" bind:tap="toggleControlled">
            Toggle
          </c-button>
        </view>
      </view>
    </view>
    <!-- 2. Indeterminate State & Master Select-All -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">
        2. Indeterminate State (Master Select-All)
      </view>
      <view class="text-xs text-neutral-400 mb-3">
        Master checkbox shows minus indicator when some (not all) child options are selected.
      </view>
      <view class="flex flex-col gap-3">
        <view class="pb-3 border-b border-neutral-200 shrink-0">
          <c-checkbox checked="{{isAllNotificationsSelected}}" indeterminate="{{isSomeNotificationsSelected}}" label="Select All Channels" description="Toggle all notification methods at once" bind:change="onMasterNotificationToggle" />
        </view>
        <view class="pl-4 flex flex-col gap-2.5">
          <c-checkbox wx:for="{{notificationChannels}}" wx:key="id" checked="{{item.checked}}" label="{{item.label}}" data-id="{{item.id}}" bind:change="onNotificationChannelToggle" />
        </view>
        <view class="flex items-center justify-between text-xs bg-neutral-50 p-3 rounded-xl border border-neutral-200 mt-1">
          <text class="text-neutral-500">Master State:</text>
          <text class="font-bold text-neutral-900 font-mono">
            {{isAllNotificationsSelected ? 'checked' : (isSomeNotificationsSelected ? 'indeterminate' : 'unchecked')}}
          </text>
        </view>
      </view>
    </view>
    <!-- 3. Controlled Checkbox Group -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">3. Controlled Checkbox Group</view>
      <view class="text-xs text-neutral-400 mb-3">
        c-checkbox-group manages an array of values with automatic ancestor-descendant relation wiring.
      </view>
      <view class="flex flex-col gap-4">
        <c-checkbox-group value="{{selectedFruits}}" bind:change="onFruitsChange">
          <c-checkbox value="apple" label="Fresh Apple" description="Organic crisp red apple" />
          <c-checkbox value="banana" label="Cavendish Banana" description="Rich in natural potassium" />
          <c-checkbox value="cherry" label="Sweet Cherry" description="Imported seasonal cherries" />
          <c-checkbox value="mango" label="Alphonso Mango" description="Sweet and aromatic tropical fruit" />
        </c-checkbox-group>
        <view class="text-xs bg-neutral-50 p-3 rounded-xl border border-neutral-200 flex flex-col gap-1">
          <text class="text-neutral-500">Selected Values Array ({{selectedFruits.length}}):</text>
          <text class="font-bold text-primary font-mono break-all">{{selectedFruitsJson}}</text>
        </view>
        <view class="flex flex-wrap gap-2 pt-1">
          <c-button size="sm" variant="outline" color="primary" bind:tap="selectAllFruits">
            Select All
          </c-button>
          <c-button size="sm" variant="outline" color="neutral" bind:tap="setFavoriteFruits">
            Set ["apple", "cherry"]
          </c-button>
          <c-button size="sm" variant="outline" color="danger" bind:tap="clearFruits">
            Clear
          </c-button>
        </view>
      </view>
    </view>
    <!-- 4. Auto-rendered Items Prop -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">4. Auto-rendered (items Prop)</view>
      <view class="text-xs text-neutral-400 mb-3">
        Pass an array of options directly to c-checkbox-group without writing child tags.
      </view>
      <view class="flex flex-col gap-3">
        <c-checkbox-group value="{{selectedTechs}}" items="{{techOptions}}" bind:change="onTechsChange" />
        <view class="text-xs text-neutral-500 bg-neutral-50 p-2.5 rounded-xl border border-neutral-200 font-mono">
          Selected:
          <text class="font-bold text-neutral-900">{{selectedTechsJson}}</text>
        </view>
      </view>
    </view>
    <!-- 5. Min & Max Limits -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">5. Min & Max Selection Limits</view>
      <view class="text-xs text-neutral-400 mb-3">
        min="1" and max="2" boundaries prevent deselecting below 1 or selecting more than 2.
      </view>
      <view class="flex flex-col gap-3">
        <c-form-field help="Select between 1 and 2 project roles">
          <c-checkbox-group min="{{1}}" max="{{2}}" value="{{limitedRoles}}" items="{{roleOptions}}" bind:change="onRolesChange" />
        </c-form-field>
        <view class="flex items-center justify-between text-xs bg-neutral-50 p-2.5 rounded-xl border border-neutral-200">
          <text class="text-neutral-500">Active Count:</text>
          <text class="font-bold {{limitedRoles.length === 2 ? 'text-warning' : 'text-primary'}} font-mono">
            {{limitedRoles.length}} / 2 (min: 1)
          </text>
        </view>
      </view>
    </view>
    <!-- 6. Card Variant -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">6. Card Variant (variant="card")</view>
      <view class="text-xs text-neutral-400 mb-3">
        Selectable card containers with soft background, active border, and ring.
      </view>
      <view class="flex flex-col gap-3">
        <c-checkbox-group value="{{selectedAddons}}" variant="card" bind:change="onAddonsChange">
          <c-checkbox value="priority" variant="card" label="Priority Fulfillment" description="Guaranteed same-day packing & dispatch (+$4.99)" />
          <c-checkbox value="insurance" variant="card" label="Shipping Insurance" description="Full refund if lost, stolen, or damaged (+$2.50)" />
          <c-checkbox value="gift" variant="card" label="Gift Wrapping & Note" description="Eco-friendly festive wrap with personal card (+$3.00)" />
        </c-checkbox-group>
      </view>
    </view>
    <!-- 7. Horizontal Orientation -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">7. Horizontal Orientation</view>
      <view class="text-xs text-neutral-400 mb-3">
        orientation="horizontal" wraps items in a flex row.
      </view>
      <view class="flex flex-col gap-3">
        <c-checkbox-group orientation="horizontal" value="{{selectedTags}}" bind:change="onTagsChange">
          <c-checkbox value="react" label="React" />
          <c-checkbox value="vue" label="Vue" />
          <c-checkbox value="miniapp" label="MiniApp" />
          <c-checkbox value="tailwind" label="Tailwind" />
          <c-checkbox value="vite" label="Vite" />
        </c-checkbox-group>
      </view>
    </view>
    <!-- 8. Sizes -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">8. Sizes</view>
      <view class="text-xs text-neutral-400 mb-3">xs, sm, md, lg, xl</view>
      <view class="flex flex-col gap-3.5">
        <c-checkbox size="xs" defaultChecked label="Size xs (3.5 / 2.5)" />
        <c-checkbox size="sm" defaultChecked label="Size sm (4.0 / 3.0)" />
        <c-checkbox size="md" defaultChecked label="Size md (4.5 / 3.5 - Default)" />
        <c-checkbox size="lg" defaultChecked label="Size lg (5.0 / 4.0)" />
        <c-checkbox size="xl" defaultChecked label="Size xl (6.0 / 4.5)" />
      </view>
    </view>
    <!-- 9. Semantic Colors -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">9. Semantic Colors</view>
      <view class="text-xs text-neutral-400 mb-3">
        primary, success, warning, danger, info, neutral
      </view>
      <view class="grid grid-cols-2 gap-3">
        <c-checkbox color="primary" defaultChecked label="Primary" />
        <c-checkbox color="success" defaultChecked label="Success" />
        <c-checkbox color="warning" defaultChecked label="Warning" />
        <c-checkbox color="danger" defaultChecked label="Danger" />
        <c-checkbox color="info" defaultChecked label="Info" />
        <c-checkbox color="neutral" defaultChecked label="Neutral" />
      </view>
    </view>
    <!-- 10. Disabled & ReadOnly States -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">10. Disabled & ReadOnly States</view>
      <view class="text-xs text-neutral-400 mb-3">
        Disabled checkboxes prevent tap interaction and render muted styling.
      </view>
      <view class="flex flex-col gap-3">
        <c-checkbox disabled="{{true}}" label="Disabled (unchecked)" />
        <c-checkbox disabled="{{true}}" defaultChecked label="Disabled (checked)" />
        <c-checkbox readOnly="{{true}}" defaultChecked label="ReadOnly (locked to checked)" />
        <c-checkbox disabled="{{true}}" defaultIndeterminate label="Disabled (indeterminate)" />
      </view>
    </view>
    <!-- 11. Form & Validation Integration -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">11. Form & Validation Integration</view>
      <view class="text-xs text-neutral-400 mb-3">
        Connected with c-form and c-form-field. Validates required checkboxes and group arrays.
      </view>
      <c-form id="checkbox-demo-form" bind:submit="handleFormSubmit" bind:error="handleFormError">
        <!-- Form Field 1: Group Validation -->
        <c-form-field name="interests" label="Areas of Interest" required rules="{{interestRules}}" description="Choose at least 2 topics you want to follow">
          <c-checkbox-group name="interests" value="{{formInterests}}" variant="card" bind:change="onFormInterestsChange">
            <c-checkbox value="ai" variant="card" label="Artificial Intelligence" description="LLMs, neural networks, and agent frameworks" />
            <c-checkbox value="web" variant="card" label="Modern Web & MiniApp" description="Micro-frontends, Vite, and mobile runtimes" />
            <c-checkbox value="cloud" variant="card" label="Cloud Native Systems" description="Kubernetes, serverless, and distributed storage" />
          </c-checkbox-group>
        </c-form-field>
        <!-- Form Field 2: Single Required Agreement Checkbox -->
        <view class="mt-4">
          <c-form-field name="agreement" required rules="{{agreementRules}}">
            <c-checkbox name="agreement" checked="{{formAgreement}}" label="I accept the Terms of Service & Privacy Policy" bind:change="onFormAgreementChange" />
          </c-form-field>
        </view>
        <!-- Submit & Reset Buttons -->
        <view class="flex gap-2 pt-4">
          <c-button color="primary" bind:tap="submitForm">Submit Registration</c-button>
          <c-button variant="outline" color="neutral" bind:tap="resetForm">Reset</c-button>
        </view>
      </c-form>
      <!-- Form Submission Result Feedback -->
      <view wx:if="{{formStatus}}" class="mt-4 p-3 rounded-xl text-xs {{formStatus === 'Success' ? 'bg-success-50 text-success-700 border border-success-200' : 'bg-danger-50 text-danger-700 border border-danger-200'}}">
        <view class="font-bold">{{formStatus}}</view>
        <view class="mt-0.5 break-all font-mono">{{formMessage}}</view>
      </view>
    </view>
  </view>
</view>