<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Checkbox"
    badge="Form"
    subtitle="Single & group selection with indeterminate state, card variant, custom icons/slots, 7 colors & Form validation."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Standalone Controlled -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled Standalone Checkbox</text>
        <text class="block text-xs text-muted mt-0.5">State synchronized cleanly with page data: {{ controlledChecked }}</text>
      </view>
      <c-checkbox
        checked="{{ controlledChecked }}"
        disabled="{{ disabled }}"
        label="Enable automatic cloud backups"
        description="Syncs nightly to your workspace bucket."
        bind:change="onControlledChange"
      />
      <view class="flex flex-wrap items-center justify-between gap-2 pt-1">
        <view class="flex gap-2">
          <c-button size="xs" variant="soft" color="primary" label="Check" bind:tap="setControlledTrue" />
          <c-button size="xs" variant="outline" color="neutral" label="Uncheck" bind:tap="setControlledFalse" />
          <c-button size="xs" variant="outline" color="secondary" label="Toggle" bind:tap="toggleControlled" />
        </view>
        <c-switch checked="{{ disabled }}" size="sm" label="Disabled" bind:change="onToggleDisabled" />
      </view>
    </view>

    <!-- 2. Indeterminate State -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Indeterminate (Master Select-All)</text>
        <text class="block text-xs text-muted mt-0.5">Displays indeterminate icon when a subset of child channels is active.</text>
      </view>
      <c-checkbox
        checked="{{ isAllNotificationsSelected }}"
        indeterminate="{{ isSomeNotificationsSelected }}"
        label="All Notification Channels"
        bind:change="onMasterNotificationToggle"
      />
      <view class="pl-5 flex flex-col gap-2 pt-2 border-t border-muted">
        <c-checkbox
          wx:for="{{ notificationChannels }}"
          wx:key="id"
          data-id="{{ item.id }}"
          checked="{{ item.checked }}"
          label="{{ item.label }}"
          bind:change="onNotificationChannelToggle"
        />
      </view>
    </view>

    <!-- 3. Controlled & Items-Driven Groups -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled Group & Items Prop</text>
        <text class="block text-xs text-muted mt-0.5">Selected: {{ selectedFruitsJson }}</text>
      </view>
      <c-checkbox-group value="{{ selectedFruits }}" bind:change="onFruitsChange">
        <c-checkbox value="apple" label="Apple" />
        <c-checkbox value="banana" label="Banana" />
        <c-checkbox value="cherry" label="Cherry" />
        <c-checkbox value="mango" label="Mango" />
      </c-checkbox-group>
      <view class="flex gap-2">
        <c-button size="xs" variant="soft" color="primary" label="Select All" bind:tap="selectAllFruits" />
        <c-button size="xs" variant="outline" color="neutral" label="Favorites" bind:tap="setFavoriteFruits" />
        <c-button size="xs" variant="outline" color="neutral" label="Clear" bind:tap="clearFruits" />
      </view>

      <view class="pt-3 border-t border-muted flex flex-col gap-2">
        <text class="text-xs font-semibold text-toned">Data-Driven Stack ({{ selectedTechsJson }})</text>
        <c-checkbox-group items="{{ techOptions }}" value="{{ selectedTechs }}" bind:change="onTechsChange" />
      </view>
    </view>

    <!-- 4. Custom Icons, Slots & Card Variant -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Custom Icons, Slots & Card Variant</text>
        <text class="block text-xs text-muted mt-0.5">Override icon/indeterminateIcon props, custom slots, or use variant='card'.</text>
      </view>

      <view class="flex flex-col gap-2.5">
        <c-checkbox default-checked="{{ true }}" color="secondary" icon="i-lucide-heart" label="Custom Heart Icon Prop" />
        <c-checkbox indeterminate="{{ true }}" color="info" indeterminate-icon="i-lucide-sparkles" label="Custom Indeterminate Icon" />
        <c-checkbox default-checked="{{ true }}" color="success">
          <view slot="label" class="flex items-center gap-1.5">
            <text class="text-sm font-medium text-highlighted">Slot Label</text>
            <c-badge label="New" size="xs" color="success" variant="soft" />
          </view>
          <text slot="description" class="text-xs text-muted">Description rendered via slot="description".</text>
        </c-checkbox>
      </view>

      <view class="pt-3 border-t border-muted">
        <c-checkbox-group variant="card" value="{{ selectedAddons }}" bind:change="onAddonsChange">
          <c-checkbox value="priority" label="Priority Edge Support" description="24/7 response SLA within 15 minutes." />
          <c-checkbox value="audit" label="Compliance Audit Logs" description="Export immutable 365-day retention." />
        </c-checkbox-group>
      </view>
    </view>

    <!-- 5. Colors, Sizes, Limits & Validation States -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Colors, Sizes & States</text>
        <text class="block text-xs text-muted mt-0.5">All 7 colors including secondary, sizes xs-xl, invalid, required & min/max.</text>
      </view>

      <view class="flex flex-wrap gap-3">
        <c-checkbox wx:for="{{ colors }}" wx:key="*this" default-checked="{{ true }}" color="{{ item }}" label="{{ item }}" />
      </view>

      <view class="flex flex-wrap items-center gap-4 pt-2 border-t border-muted">
        <c-checkbox wx:for="{{ sizes }}" wx:key="*this" default-checked="{{ true }}" size="{{ item }}" label="{{ item }}" />
      </view>

      <view class="flex flex-col gap-2 pt-2 border-t border-muted">
        <c-checkbox invalid="{{ true }}" required="{{ true }}" label="Invalid + Required Standalone Checkbox" />
        <c-checkbox disabled="{{ true }}" checked="{{ true }}" label="Disabled Checked" />
        <c-checkbox read-only="{{ true }}" checked="{{ true }}" label="Read-Only Checked" />
      </view>

      <view class="pt-2 border-t border-muted">
        <text class="block text-xs font-medium text-muted mb-2">Horizontal Tags & Min=1 / Max=2 Limit</text>
        <c-checkbox-group orientation="horizontal" value="{{ selectedTags }}" bind:change="onTagsChange">
          <c-checkbox value="react" label="React" />
          <c-checkbox value="vite" label="Vite" />
          <c-checkbox value="ts" label="TypeScript" />
        </c-checkbox-group>
      </view>
    </view>

    <!-- 6. Form Validation -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Form & Validation Integration</text>
        <text class="block text-xs text-muted mt-0.5">Requires at least 2 interests + accepted agreement.</text>
      </view>
      <c-form id="checkbox-demo-form" bind:submit="handleFormSubmit" bind:error="handleFormError">
        <view class="flex flex-col gap-3">
          <c-form-field name="interests" label="Areas of Interest (Min 2)" required="{{ true }}" rules="{{ interestRules }}">
            <c-checkbox-group variant="card" value="{{ formInterests }}" bind:change="onFormInterestsChange">
              <c-checkbox value="ai" label="Artificial Intelligence" />
              <c-checkbox value="web" label="MiniProgram & Vite" />
              <c-checkbox value="cloud" label="Edge & Systems" />
            </c-checkbox-group>
          </c-form-field>
          <c-form-field name="agreement" required="{{ true }}" rules="{{ agreementRules }}">
            <c-checkbox checked="{{ formAgreement }}" label="I accept the terms of service" bind:change="onFormAgreementChange" />
          </c-form-field>
        </view>
      </c-form>
      <view class="flex gap-2">
        <c-button size="xs" color="primary" label="Submit" bind:tap="submitForm" />
        <c-button size="xs" color="neutral" variant="outline" label="Reset" bind:tap="resetForm" />
      </view>
      <text wx:if="{{ formStatus }}" class="text-xs text-muted">{{ formStatus }}: {{ formMessage }}</text>
    </view>
  </view>
</view>
