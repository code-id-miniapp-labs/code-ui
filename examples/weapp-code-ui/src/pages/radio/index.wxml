<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Radio"
    badge="Form"
    subtitle="Exclusive choice control & RadioGroup with useComponentRef control, card variant, slots, 7 colors & validation."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Controlled State -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled State</text>
        <text class="block text-xs text-muted mt-0.5">Selected: {{ controlledPlan || '(none)' }} · {{ lastEvent }}</text>
      </view>
      <c-radio-group value="{{ controlledPlan }}" bind:change="onControlledPlanChange">
        <c-radio value="free" label="Free Starter" description="Up to 3 projects" />
        <c-radio value="pro" label="Pro Workspace" description="Unlimited projects & team sharing" />
        <c-radio value="enterprise" label="Enterprise" description="Dedicated SLA & SSO" />
      </c-radio-group>
      <view class="flex flex-wrap gap-2">
        <c-button size="xs" variant="outline" color="primary" label="Set Free" bind:tap="setPlanFree" />
        <c-button size="xs" variant="soft" color="primary" label="Set Pro" bind:tap="setPlanPro" />
        <c-button size="xs" variant="outline" color="neutral" label="Clear" bind:tap="clearControlledPlan" />
      </view>
    </view>

    <!-- 2. Programmatic useComponentRef Control -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Programmatic useComponentRef() Control</text>
        <text class="block text-xs text-muted mt-0.5">API synced snapshot: {{ componentRefLastValue }}</text>
      </view>
      <c-radio-group id="programmatic-radio-group" default-value="pro">
        <c-radio value="starter" label="Starter" />
        <c-radio value="pro" label="Pro" />
        <c-radio value="enterprise" label="Enterprise" />
      </c-radio-group>
      <view class="flex flex-wrap gap-2">
        <c-button size="xs" variant="soft" color="primary" label="setValue('starter')" bind:tap="componentRefSetStarter" />
        <c-button size="xs" variant="soft" color="secondary" label="setValue('enterprise')" bind:tap="componentRefSetEnterprise" />
        <c-button size="xs" variant="outline" color="neutral" label="clear()" bind:tap="componentRefClear" />
      </view>
    </view>

    <!-- 3. Card Variant, Items Prop & Horizontal Orientation -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Card Variant, Items Array & Horizontal</text>
        <text class="block text-xs text-muted mt-0.5">Billing cycle: {{ selectedBilling }} · Delivery: {{ deliverySpeed }}</text>
      </view>

      <c-radio-group variant="card" value="{{ selectedBilling }}" bind:change="onBillingChange">
        <c-radio value="monthly" label="Monthly Billing" description="$19/month billed every 30 days" />
        <c-radio value="annual" label="Annual Billing (Save 20%)" description="$182/year billed once annually" />
      </c-radio-group>

      <view class="pt-3 border-t border-muted">
        <text class="block text-xs font-semibold text-toned mb-2">Auto-rendered Items Prop ({{ selectedFruit }})</text>
        <c-radio-group items="{{ fruitOptions }}" value="{{ selectedFruit }}" bind:change="onFruitChange" />
      </view>

      <view class="pt-3 border-t border-muted">
        <text class="block text-xs font-semibold text-toned mb-2">Horizontal Orientation</text>
        <c-radio-group orientation="horizontal" value="{{ deliverySpeed }}" bind:change="onDeliverySpeedChange">
          <c-radio value="standard" label="Standard" />
          <c-radio value="express" label="Express" />
          <c-radio value="overnight" label="Overnight" />
        </c-radio-group>
      </view>
    </view>

    <!-- 4. Colors, Sizes & Custom Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Semantic Colors, Sizes & Custom Slots</text>
        <text class="block text-xs text-muted mt-0.5">Includes secondary color, custom label/description/indicator slots & states.</text>
      </view>

      <view class="flex flex-wrap gap-3">
        <c-radio-group wx:for="{{ colors }}" wx:key="*this" color="{{ item }}" default-value="{{ item }}">
          <c-radio value="{{ item }}" label="{{ item }}" />
        </c-radio-group>
      </view>

      <view class="flex flex-wrap items-center gap-4 pt-2 border-t border-muted">
        <c-radio-group wx:for="{{ sizes }}" wx:key="*this" size="{{ item }}" default-value="{{ item }}">
          <c-radio value="{{ item }}" label="{{ item }}" />
        </c-radio-group>
      </view>

      <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
        <c-radio-group value="{{ customDelivery }}" bind:change="onCustomDeliveryChange">
          <c-radio value="delivery">
            <view slot="indicator" class="w-2.5 h-2.5 rounded-full {{ customDelivery === 'delivery' ? 'bg-primary' : 'bg-transparent' }}" />
            <view slot="label" class="flex items-center gap-1.5">
              <text class="text-sm font-medium text-highlighted">Home Courier</text>
              <c-badge label="Fast" size="xs" color="secondary" variant="soft" />
            </view>
            <text slot="description" class="text-xs text-muted">Rendered with indicator, label & description slots.</text>
          </c-radio>
          <c-radio value="pickup" label="Store Pickup" description="Ready within 1 hour">
            <view slot="indicator" class="w-2.5 h-2.5 rounded-full {{ customDelivery === 'pickup' ? 'bg-success' : 'bg-transparent' }}" />
          </c-radio>
        </c-radio-group>

        <view class="flex flex-wrap gap-3 pt-2 border-t border-muted">
          <c-radio-group default-value="" invalid="{{ true }}">
            <c-radio value="err" invalid="{{ true }}" label="Invalid" />
          </c-radio-group>
          <c-radio-group default-value="dis" disabled="{{ true }}">
            <c-radio value="dis" disabled="{{ true }}" label="Disabled" />
          </c-radio-group>
          <c-radio-group default-value="ro" read-only="{{ true }}">
            <c-radio value="ro" read-only="{{ true }}" label="Read-Only" />
          </c-radio-group>
        </view>
      </view>
    </view>

    <!-- 5. Form Validation -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Form & Validation</text>
        <text class="block text-xs text-muted mt-0.5">Required membership selection validated inside c-form.</text>
      </view>
      <c-form id="radio-demo-form" bind:submit="handleRadioFormSubmit" bind:error="handleRadioFormError">
        <c-form-field name="membership" label="Membership Tier" required="{{ true }}" rules="{{ membershipRules }}">
          <c-radio-group variant="card" value="{{ formMembership }}" bind:change="onFormMembershipChange">
            <c-radio value="basic" label="Basic Member" />
            <c-radio value="vip" label="VIP Club" />
          </c-radio-group>
        </c-form-field>
      </c-form>
      <view class="flex gap-2">
        <c-button size="xs" color="primary" label="Submit" bind:tap="submitRadioForm" />
        <c-button size="xs" color="neutral" variant="outline" label="Reset" bind:tap="resetRadioForm" />
      </view>
      <text wx:if="{{ formStatus }}" class="text-xs text-muted">{{ formStatus }}: {{ formMessage }}</text>
    </view>
  </view>
</view>
