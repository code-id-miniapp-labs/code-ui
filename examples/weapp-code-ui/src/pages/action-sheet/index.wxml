<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Action Sheet"
    badge="Feedback"
    subtitle="Contextual action drawer supporting item sublabels, destructive items, native openType buttons, custom slots & ui."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Scenarios Grid -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Action Sheet Scenarios</text>
        <text class="block text-xs text-muted mt-0.5">Tap any preset to inspect items, footer buttons, openType & slots.</text>
      </view>

      <view class="grid grid-cols-2 gap-2.5">
        <c-button size="sm" color="primary" label="Basic Options" bind:tap="openBasic" />
        <c-button size="sm" variant="outline" color="neutral" label="With Header & Icons" bind:tap="openWithHeader" />
        <c-button size="sm" variant="soft" color="danger" label="Status Variants" bind:tap="openStatusVariants" />
        <c-button size="sm" color="secondary" variant="soft" label="Footer Async Buttons" bind:tap="openFooterActionsVariety" />
        <c-button size="sm" variant="outline" color="warning" label="Modal + Close" bind:tap="openModalWithClose" />
        <c-button size="sm" variant="outline" color="primary" label="WeChat openType" bind:tap="openWeChatFeatures" />
        <c-button size="sm" variant="soft" color="primary" label="Custom Share Grid" bind:tap="openCustomSlot" />
        <c-button size="sm" variant="outline" color="neutral" label="Custom UI Theme" bind:tap="openCustomTheme" />
      </view>
    </view>

    <!-- 2. Event Inspector -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view class="flex items-center justify-between">
        <text class="text-sm font-semibold text-highlighted">Event Log</text>
        <c-button size="xs" variant="ghost" color="neutral" label="Clear" bind:tap="clearLog" />
      </view>
      <view class="bg-muted border border-muted rounded-xl p-3 flex flex-col gap-1">
        <text class="text-xs text-primary font-medium">{{ lastEvent }}</text>
        <view wx:if="{{ eventLog.length > 0 }}" class="flex flex-col gap-0.5 pt-1 border-t border-muted">
          <text wx:for="{{ eventLog }}" wx:key="*this" class="text-[11px] font-mono text-dimmed">{{ item }}</text>
        </view>
      </view>
    </view>
  </view>

  <c-action-sheet
    open="{{ isOpen }}"
    title="{{ title }}"
    description="{{ description }}"
    items="{{ items }}"
    actions="{{ actions }}"
    close="{{ close }}"
    closeOnItem="{{ closeOnItem }}"
    closeOnBackdropClick="{{ closeOnBackdropClick }}"
    ui="{{ ui }}"
    bind:select="onItemSelect"
    bind:action="onFooterAction"
    bind:close="onSheetClose"
    bind:backdropTap="onBackdropTap"
    bind:closeTriggerTap="onCloseTriggerTap"
    bind:chooseavatar="onChooseAvatar"
  >
    <view wx:if="{{ isCustomSlot }}" class="p-4 grid grid-cols-3 gap-3 bg-default">
      <block wx:for="{{ shareOptions }}" wx:key="id">
        <button
          class="flex flex-col items-center justify-center p-3 rounded-2xl bg-muted border-0 after:border-none m-0 leading-normal"
          open-type="{{ item.openType || '' }}"
          hover-class="opacity-70"
          data-item="{{ item }}"
          catchtap="onCustomShareItemTap"
        >
          <view class="w-12 h-12 rounded-2xl flex items-center justify-center mb-1.5 {{ item.bgClass }}">
            <c-icon name="{{ item.icon }}" className="w-6 h-6 {{ item.iconClass }}" />
          </view>
          <text class="text-xs font-medium text-highlighted text-center">{{ item.name }}</text>
        </button>
      </block>
    </view>
  </c-action-sheet>
</view>
