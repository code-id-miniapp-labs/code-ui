<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Form & FormField"
    badge="Form"
    subtitle="Full validation coordinator with FormField labels, hints, custom slots, validateOn, disabled mode & programmatic API."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Form Controls Showcase -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view class="flex items-start justify-between gap-2 flex-wrap">
        <view class="flex-1 min-w-0">
          <text class="block text-sm font-semibold text-highlighted">Full Registration Form</text>
          <text class="block text-xs text-muted mt-0.5">
            Combines Input, PinInput, Select, InputMenu, RadioGroup, CheckboxGroup, Slider, Switch & Checkbox.
          </text>
        </view>
        <view class="flex items-center gap-2">
          <text class="text-xs text-muted">Disable Form</text>
          <c-switch checked="{{ formDisabled }}" size="sm" bind:change="toggleFormDisabled" />
        </view>
      </view>

      <view class="flex items-center gap-2 pt-1">
        <text class="text-xs text-dimmed">validateOn:</text>
        <c-button size="xs" color="{{ validateOnMode === 'live' ? 'primary' : 'neutral' }}" variant="{{ validateOnMode === 'live' ? 'solid' : 'outline' }}" label="Live (input/blur)" data-mode="live" bind:tap="toggleValidateOn" />
        <c-button size="xs" color="{{ validateOnMode === 'submit' ? 'primary' : 'neutral' }}" variant="{{ validateOnMode === 'submit' ? 'solid' : 'outline' }}" label="Submit Only" data-mode="submit" bind:tap="toggleValidateOn" />
      </view>

      <c-form
        id="registration-form"
        disabled="{{ formDisabled }}"
        validate-on="{{ validateOn }}"
        bind:submit="handleRegistrationSubmit"
        bind:error="handleRegistrationError"
      >
        <view class="flex flex-col gap-3.5">
          <c-form-field name="username" label="Username" description="Your public display handle" hint="Min 3 chars" help="Letters, numbers, and underscores only" required="{{ true }}" rules="{{ usernameRules }}">
            <c-input placeholder="e.g. alice_w" leading-icon="i-lucide-user" />
          </c-form-field>

          <c-form-field name="email" label="Email Address" description="Account recovery notifications" required="{{ true }}" rules="{{ emailRules }}">
            <c-input placeholder="name@example.com" leading-icon="i-lucide-mail" />
          </c-form-field>

          <c-form-field name="pin" label="4-Digit Security PIN" description="Required for payout requests" required="{{ true }}" rules="{{ pinRules }}">
            <c-pin-input length="{{ 4 }}" mask="{{ true }}" placeholder="○" />
          </c-form-field>

          <c-form-field name="role" label="Workspace Role" required="{{ true }}" rules="{{ roleRules }}">
            <c-radio-group items="{{ roleItems }}" orientation="horizontal" default-value="developer" />
          </c-form-field>

          <c-form-field name="department" label="Department" description="Primary engineering group" required="{{ true }}" rules="{{ departmentRules }}">
            <c-select items="{{ departmentItems }}" placeholder="Select department..." leading-icon="i-lucide-building-2" clearable="{{ true }}" />
          </c-form-field>

          <c-form-field name="primaryStack" label="Primary Tech Stack (InputMenu)" description="Searchable combobox inside Form" required="{{ true }}" rules="{{ primaryStackRules }}">
            <c-input-menu items="{{ skillItems }}" placeholder="Search stack..." leading-icon="i-lucide-layers" clearable="{{ true }}" />
          </c-form-field>

          <c-form-field name="topics" label="Interests (Custom Rule)" required="{{ true }}" rules="{{ topicsRules }}">
            <c-checkbox-group items="{{ topicItems }}" default-value="{{ ['components'] }}" />
          </c-form-field>

          <c-form-field name="satisfaction" label="Experience Rating (Slider)" hint="0-100">
            <c-slider default-value="{{ 75 }}" min="{{ 0 }}" max="{{ 100 }}" show-value="{{ true }}" />
          </c-form-field>

          <c-form-field name="newsletter">
            <c-switch checked="{{ newsletterControlled }}" label="Subscribe to Newsletter" description="Controlled page state" bind:change="onNewsletterChange" />
          </c-form-field>

          <c-form-field name="terms" required="{{ true }}" rules="{{ termsRules }}">
            <c-checkbox label="I accept the Terms of Service & Privacy Policy" />
          </c-form-field>
        </view>
      </c-form>

      <view class="flex flex-wrap gap-2 pt-3 border-t border-muted">
        <c-button size="sm" color="primary" label="Submit" bind:tap="submitRegistration" />
        <c-button size="sm" color="secondary" variant="soft" label="Fill Valid Data" bind:tap="setPredefined" />
        <c-button size="sm" color="danger" variant="soft" label="Inject Errors" bind:tap="simulateServerError" />
        <c-button size="sm" color="neutral" variant="outline" label="Clear Errors" bind:tap="clearRegistrationErrors" />
        <c-button size="sm" color="neutral" variant="outline" label="Reset" bind:tap="resetRegistration" />
      </view>

      <view wx:if="{{ formStatus }}" class="rounded-xl p-3 border {{ formStatus === 'Success' ? 'bg-success/10 border-success/30 text-success' : 'bg-elevated border-default text-toned' }}">
        <text class="block text-xs font-bold">{{ formStatus }}</text>
        <text class="block text-xs mt-1 break-all">{{ formMessage }}</text>
      </view>
    </view>

    <!-- 2. FormField Sizes & Custom Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">FormField Sizes & Custom Slots</text>
        <text class="block text-xs text-muted mt-0.5">xs-xl inherited sizes plus custom label, hint, help & error slots.</text>
      </view>

      <view class="flex flex-col gap-3">
        <c-form-field
          wx:for="{{ fieldSizes }}"
          wx:key="*this"
          size="{{ item }}"
          label="Size {{ item }}"
          hint="Optional"
          help="Child c-input automatically inherits size='{{ item }}'."
        >
          <c-input placeholder="Inherits size {{ item }}" />
        </c-form-field>
      </view>

      <c-form-field className="pt-2 border-t border-muted" error="Token expired — request a fresh code.">
        <view slot="label" class="flex items-center gap-1.5">
          <c-icon name="i-lucide-sparkles" size="xs" color="secondary" />
          <text class="text-xs font-semibold text-highlighted">Custom Named Slots</text>
        </view>
        <view slot="hint">
          <c-badge label="Required" size="xs" color="secondary" variant="soft" />
        </view>
        <c-input placeholder="With custom label, hint & error UI" />
      </c-form-field>
    </view>

    <!-- 3. Standalone Form Examples -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Security PIN & Preferences Forms</text>
        <text class="block text-xs text-muted mt-0.5">Isolated multi-form coordination via id selectors.</text>
      </view>

      <c-form id="transfer-form" bind:submit="handleTransferSubmit" bind:error="handleTransferError">
        <c-form-field name="transferPin" label="6-Digit Transfer Authorization" required="{{ true }}" rules="{{ transferPinRules }}">
          <c-pin-input length="{{ 6 }}" separator="{{ 3 }}" separator-char="-" />
        </c-form-field>
      </c-form>
      <view class="flex gap-2">
        <c-button size="xs" color="primary" label="Authorize" bind:tap="submitTransfer" />
        <c-button size="xs" color="neutral" variant="outline" label="Clear" bind:tap="resetTransfer" />
      </view>
      <text wx:if="{{ transferStatus }}" class="text-xs text-muted">{{ transferStatus }}: {{ transferMessage }}</text>

      <view class="pt-3 border-t border-muted">
        <c-form id="preferences-form" bind:submit="handlePreferencesSubmit">
          <view class="flex flex-col divide-y divide-muted">
            <c-form-field name="notifications" className="py-2"><c-switch default-checked="{{ true }}" label="Push Notifications" /></c-form-field>
            <c-form-field name="biometrics" className="py-2"><c-switch default-checked="{{ false }}" label="Biometric Login" /></c-form-field>
            <c-form-field name="twoFactor" className="py-2"><c-switch default-checked="{{ true }}" label="2FA Recovery Prompts" /></c-form-field>
          </view>
        </c-form>
        <view class="flex flex-wrap gap-2 mt-2">
          <c-button size="xs" color="primary" label="Save Preferences" bind:tap="submitPreferences" />
          <c-button size="xs" color="secondary" variant="soft" label="High Security Preset" bind:tap="setHighSecurityPreferences" />
          <c-button size="xs" color="neutral" variant="outline" label="Reset" bind:tap="resetPreferences" />
        </view>
        <text wx:if="{{ preferencesStatus }}" class="block text-xs text-muted mt-2">{{ preferencesStatus }}: {{ preferencesMessage }}</text>
      </view>
    </view>

    <!-- 4. Select & Form Integration -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Select & Form Integration</text>
        <text class="block text-xs text-muted mt-0.5">
          Single dropdown, multi-select, and picker mode wired to Form validation, setValues, setErrors & reset.
        </text>
      </view>

      <c-form
        id="select-form"
        disabled="{{ formDisabled }}"
        validate-on="{{ validateOn }}"
        bind:submit="handleSelectFormSubmit"
        bind:error="handleSelectFormError"
      >
        <view class="flex flex-col gap-3.5">
          <c-form-field name="country" label="Country / Region" description="Required single dropdown selection" required="{{ true }}" rules="{{ countryRules }}">
            <c-select items="{{ countryItems }}" placeholder="Choose country..." leading-icon="i-lucide-globe" clearable="{{ true }}" />
          </c-form-field>

          <c-form-field name="skills" label="Core Skills (Min 2)" description="Multiple selection with custom validator" hint="Select >= 2" required="{{ true }}" rules="{{ skillsRules }}">
            <c-select multiple="{{ true }}" items="{{ skillItems }}" placeholder="Pick at least 2 skills..." leading-icon="i-lucide-tags" clearable="{{ true }}" />
          </c-form-field>

          <c-form-field name="city" label="Office City (Picker Mode)" description="WeChat picker-view bottom sheet inside Form" required="{{ true }}" rules="{{ cityRules }}">
            <c-select mode="picker" title="Select City" items="{{ cityItems }}" placeholder="Choose city..." leading-icon="i-lucide-map-pin" />
          </c-form-field>
        </view>
      </c-form>

      <view class="flex flex-wrap gap-2 pt-3 border-t border-muted">
        <c-button size="sm" color="primary" label="Submit" bind:tap="submitSelectForm" />
        <c-button size="sm" color="secondary" variant="soft" label="Fill Sample" bind:tap="fillSelectForm" />
        <c-button size="sm" color="danger" variant="soft" label="Inject Errors" bind:tap="injectSelectFormErrors" />
        <c-button size="sm" color="neutral" variant="outline" label="Clear Errors" bind:tap="clearSelectFormErrors" />
        <c-button size="sm" color="neutral" variant="outline" label="Reset" bind:tap="resetSelectForm" />
      </view>

      <view wx:if="{{ selectFormStatus }}" class="rounded-xl p-3 border {{ selectFormStatus === 'Success' ? 'bg-success/10 border-success/30 text-success' : 'bg-elevated border-default text-toned' }}">
        <text class="block text-xs font-bold">{{ selectFormStatus }}</text>
        <text class="block text-xs mt-1 break-all">{{ selectFormMessage }}</text>
      </view>
    </view>

    <!-- 5. InputMenu & Form Integration -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">InputMenu & Form Integration</text>
        <text class="block text-xs text-muted mt-0.5">
          Searchable single combobox, multi-tag selection with createItem, and custom c-input-menu-item wired to Form validation, setValues, setErrors & reset.
        </text>
      </view>

      <c-form
        id="input-menu-form"
        disabled="{{ formDisabled }}"
        validate-on="{{ validateOn }}"
        bind:submit="handleInputMenuFormSubmit"
        bind:error="handleInputMenuFormError"
      >
        <view class="flex flex-col gap-3.5">
          <c-form-field name="framework" label="Target Framework" description="Searchable single-select combobox" required="{{ true }}" rules="{{ frameworkRules }}">
            <c-input-menu items="{{ frameworkItems }}" placeholder="Search framework..." leading-icon="i-lucide-code" clearable="{{ true }}" />
          </c-form-field>

          <c-form-field name="labels" label="Issue Labels (Min 2, Creatable)" description="Search or create new tags on the fly" hint="Select >= 2" required="{{ true }}" rules="{{ labelsRules }}">
            <c-input-menu id="input-menu-labels" multiple="{{ true }}" items="{{ labelItems }}" create-item="always" create-icon="i-lucide-plus" placeholder="Search or create labels..." leading-icon="i-lucide-tags" clearable="{{ true }}" bind:create="onCreateFormLabel" />
          </c-form-field>

          <c-form-field name="reviewer" label="Code Reviewer" description="Declarative c-input-menu-item children" required="{{ true }}" rules="{{ reviewerRules }}">
            <c-input-menu placeholder="Search reviewer..." leading-icon="i-lucide-user-check" clearable="{{ true }}">
              <c-input-menu-item value="alice" label="Alice Wang" description="Design Systems">
                <c-avatar slot="leading" size="xs" text="Alice Wang" color="primary" />
              </c-input-menu-item>
              <c-input-menu-item value="bob" label="Bob Chen" description="Core Runtime">
                <c-avatar slot="leading" size="xs" text="Bob Chen" color="secondary" />
              </c-input-menu-item>
              <c-input-menu-item value="charlie" label="Charlie Zhang" description="Compiler & Vite">
                <c-avatar slot="leading" size="xs" text="Charlie Zhang" color="success" />
              </c-input-menu-item>
            </c-input-menu>
          </c-form-field>
        </view>
      </c-form>

      <view class="flex flex-wrap gap-2 pt-3 border-t border-muted">
        <c-button size="sm" color="primary" label="Submit" bind:tap="submitInputMenuForm" />
        <c-button size="sm" color="secondary" variant="soft" label="Fill Sample" bind:tap="fillInputMenuForm" />
        <c-button size="sm" color="danger" variant="soft" label="Inject Errors" bind:tap="injectInputMenuFormErrors" />
        <c-button size="sm" color="neutral" variant="outline" label="Clear Errors" bind:tap="clearInputMenuFormErrors" />
        <c-button size="sm" color="neutral" variant="outline" label="Reset" bind:tap="resetInputMenuForm" />
      </view>

      <view wx:if="{{ inputMenuFormStatus }}" class="rounded-xl p-3 border {{ inputMenuFormStatus === 'Success' ? 'bg-success/10 border-success/30 text-success' : 'bg-elevated border-default text-toned' }}">
        <text class="block text-xs font-bold">{{ inputMenuFormStatus }}</text>
        <text class="block text-xs mt-1 break-all">{{ inputMenuFormMessage }}</text>
      </view>
    </view>

    <!-- 6. Dynamic & Conditional Complex Form -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Dynamic &amp; Conditional Form</text>
        <text class="block text-xs text-muted mt-0.5">
          Conditional fields (wx:if), cascading options, toggle-revealed validation, repeatable rows (wx:for), and async loadingAuto submit.
        </text>
      </view>

      <c-form
        id="dynamic-form"
        disabled="{{ formDisabled }}"
        validateOn="{{ validateOn }}"
        bind:submit="handleDynamicFormSubmit"
        bind:error="handleDynamicFormError"
      >
        <view class="flex flex-col gap-3.5">
          <!-- Account Type switches between Personal & Business fields -->
          <c-form-field name="accountType" label="Account Type" required="{{ true }}" rules="{{ accountTypeRules }}">
            <c-radio-group
              items="{{ accountTypeItems }}"
              orientation="horizontal"
              defaultValue="personal"
              bind:change="onDynamicAccountTypeChange"
            />
          </c-form-field>

          <!-- Personal Branch -->
          <c-form-field
            wx:if="{{ dynamicAccountType === 'personal' }}"
            name="fullName"
            label="Full Name"
            required="{{ true }}"
            rules="{{ fullNameRules }}"
          >
            <c-input placeholder="e.g. Jane Doe" leadingIcon="i-lucide-user" />
          </c-form-field>

          <!-- Business Branch -->
          <block wx:if="{{ dynamicAccountType === 'business' }}">
            <c-form-field name="companyName" label="Company Name" required="{{ true }}" rules="{{ companyNameRules }}">
              <c-input placeholder="e.g. Acme Corp" leadingIcon="i-lucide-building-2" />
            </c-form-field>

            <c-form-field name="taxId" label="Tax ID / VAT" hint="Min 10 chars" required="{{ true }}" rules="{{ taxIdRules }}">
              <c-input placeholder="e.g. 0123456789" leadingIcon="i-lucide-file-text" />
            </c-form-field>

            <c-form-field name="companySize" label="Company Size" required="{{ true }}" rules="{{ companySizeRules }}">
              <c-select items="{{ companySizeItems }}" placeholder="Select team size..." clearable="{{ true }}" />
            </c-form-field>
          </block>

          <!-- Fulfillment Method switches between Delivery & Pickup -->
          <c-form-field name="fulfillment" label="Fulfillment Method" required="{{ true }}" rules="{{ fulfillmentRules }}">
            <c-radio-group
              items="{{ fulfillmentItems }}"
              orientation="horizontal"
              defaultValue="delivery"
              bind:change="onDynamicFulfillmentChange"
            />
          </c-form-field>

          <block wx:if="{{ dynamicFulfillment === 'delivery' }}">
            <c-form-field name="shippingAddress" label="Shipping Address" hint="Min 10 chars" required="{{ true }}" rules="{{ shippingAddressRules }}">
              <c-textarea placeholder="Street, building, floor, postal code..." rows="{{ 3 }}" />
            </c-form-field>

            <c-form-field name="deliverySpeed" label="Delivery Priority" required="{{ true }}" rules="{{ deliverySpeedRules }}">
              <c-select items="{{ deliverySpeedItems }}" placeholder="Choose speed..." />
            </c-form-field>
          </block>

          <c-form-field
            wx:if="{{ dynamicFulfillment === 'pickup' }}"
            name="pickupStore"
            label="Pickup Location"
            required="{{ true }}"
            rules="{{ pickupStoreRules }}"
          >
            <c-select items="{{ pickupStoreItems }}" placeholder="Choose store branch..." leadingIcon="i-lucide-map-pin" />
          </c-form-field>

          <!-- Toggle-revealed Invoice Email -->
          <c-form-field name="needInvoice">
            <c-switch
              checked="{{ dynamicNeedInvoice }}"
              label="Send Electronic Invoice"
              description="Adds a required billing email field when enabled"
              bind:change="onDynamicInvoiceChange"
            />
          </c-form-field>

          <c-form-field
            wx:if="{{ dynamicNeedInvoice }}"
            name="invoiceEmail"
            label="Billing Email"
            required="{{ true }}"
            rules="{{ emailRules }}"
          >
            <c-input placeholder="billing@company.com" leadingIcon="i-lucide-mail" />
          </c-form-field>

          <!-- Dynamic Repeatable Recipients -->
          <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
            <view class="flex items-center justify-between">
              <view>
                <text class="block text-xs font-semibold text-highlighted">Notification Recipients ({{ dynamicRecipients.length }}/3)</text>
                <text class="block text-xs text-muted">Dynamically add or remove validated fields.</text>
              </view>
              <c-button
                size="xs"
                color="secondary"
                variant="soft"
                label="+ Add"
                disabled="{{ dynamicRecipients.length >= 3 }}"
                bind:tap="addDynamicRecipient"
              />
            </view>

            <view
              wx:for="{{ dynamicRecipients }}"
              wx:key="id"
              class="flex items-start gap-2"
            >
              <view class="flex-1 min-w-0">
                <c-form-field
                  name="{{ 'recipient_' + item.id }}"
                  label="Recipient #{{ index + 1 }}"
                  required="{{ true }}"
                  rules="{{ emailRules }}"
                >
                  <c-input placeholder="recipient@example.com" leadingIcon="i-lucide-at-sign" />
                </c-form-field>
              </view>
              <view class="pt-6">
                <c-button
                  size="xs"
                  color="danger"
                  variant="ghost"
                  label="Remove"
                  data-id="{{ item.id }}"
                  bind:tap="removeDynamicRecipient"
                />
              </view>
            </view>
          </view>

          <!-- Async Submit inside c-form (inherits loadingAuto) -->
          <view class="flex flex-wrap gap-2 pt-3 border-t border-muted">
            <c-button size="sm" color="primary" label="Submit (Async)" formType="submit" loadingAuto="{{ true }}" />
            <c-button size="sm" color="neutral" variant="outline" label="Reset" bind:tap="resetDynamicForm" />
          </view>
        </view>
      </c-form>

      <view wx:if="{{ dynamicFormStatus }}" class="rounded-xl p-3 border {{ dynamicFormStatus === 'Success' ? 'bg-success/10 border-success/30 text-success' : 'bg-elevated border-default text-toned' }}">
        <text class="block text-xs font-bold">{{ dynamicFormStatus }}</text>
        <text class="block text-xs mt-1 break-all">{{ dynamicFormMessage }}</text>
      </view>
    </view>
  </view>
</view>
