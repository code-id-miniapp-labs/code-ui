<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Avatar Group"
    badge="Data Display"
    subtitle="Stack avatars with shared size context, overlapping negative margins & automatic +N overflow indicator."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Basic & Max Overflow -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Max Display & Overflow (+N)</text>
        <text class="block text-xs text-muted mt-0.5">Truncates excess children into a ring-bordered counter badge.</text>
      </view>

      <view class="flex flex-col divide-y divide-muted">
        <view class="py-2.5 flex items-center justify-between">
          <text class="text-xs font-medium text-muted">Unbounded</text>
          <c-avatar-group>
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Felix" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" alt="Aneka" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Milo" alt="Milo" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Bella" alt="Bella" />
          </c-avatar-group>
        </view>

        <view class="py-2.5 flex items-center justify-between">
          <text class="text-xs font-medium text-muted">max="3" (5 items)</text>
          <c-avatar-group max="{{ 3 }}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Felix" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" alt="Aneka" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Milo" alt="Milo" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Bella" alt="Bella" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Oliver" alt="Oliver" />
          </c-avatar-group>
        </view>

        <view class="py-2.5 flex items-center justify-between">
          <text class="text-xs font-medium text-muted">max="1" (4 items)</text>
          <c-avatar-group max="{{ 1 }}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Felix" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" alt="Aneka" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Milo" alt="Milo" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Bella" alt="Bella" />
          </c-avatar-group>
        </view>
      </view>
    </view>

    <!-- 2. Interactive Playground -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Interactive Playground</text>
        <text class="block text-xs text-muted mt-0.5">Adjust max threshold and add or remove children dynamically.</text>
      </view>

      <view class="bg-muted p-4 rounded-xl border border-muted flex flex-col items-center gap-2">
        <c-avatar-group max="{{ interactiveMax }}" size="lg">
          <c-avatar wx:for="{{ interactiveAvatars }}" wx:key="id" src="{{ item.src }}" alt="{{ item.alt }}" />
        </c-avatar-group>
        <text class="text-xs text-muted mt-1">
          Count: <text class="font-bold text-highlighted">{{ interactiveAvatars.length }}</text> ·
          Max: <text class="font-bold text-highlighted">{{ interactiveMax === 0 ? 'All (0)' : interactiveMax }}</text>
        </text>
      </view>

      <view class="flex items-center justify-between gap-2 flex-wrap">
        <text class="text-xs text-muted">Preset max:</text>
        <view class="flex flex-wrap gap-1.5">
          <c-button
            wx:for="{{ [0, 1, 2, 3, 4, 5] }}"
            wx:key="*this"
            size="xs"
            color="{{ interactiveMax === item ? 'primary' : 'neutral' }}"
            variant="{{ interactiveMax === item ? 'solid' : 'outline' }}"
            label="{{ item === 0 ? 'All' : '' + item }}"
            data-max="{{ item }}"
            bind:tap="setPresetMax"
          />
        </view>
      </view>

      <view class="flex items-center justify-between pt-2 border-t border-muted">
        <text class="text-xs text-muted">Mutate children:</text>
        <view class="flex gap-2">
          <c-button size="xs" variant="outline" color="neutral" label="- Remove" bind:tap="removeAvatar" />
          <c-button size="xs" variant="soft" color="primary" label="+ Add" bind:tap="addAvatar" />
        </view>
      </view>
    </view>

    <!-- 3. Full Size Variants (3xs - 3xl) -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Shared Sizes (3xs - 3xl)</text>
        <text class="block text-xs text-muted mt-0.5">Group distributes size and overlap ring scale to every child.</text>
      </view>
      <view class="flex flex-col gap-3">
        <view wx:for="{{ ['3xs', '2xs', 'xs', 'sm', 'md', 'lg', 'xl', '2xl', '3xl'] }}" wx:key="*this" class="flex items-center justify-between gap-3">
          <text class="text-xs font-mono text-dimmed w-10">{{ item }}</text>
          <c-avatar-group size="{{ item }}" max="{{ 3 }}">
            <c-avatar color="primary" alt="Alice" />
            <c-avatar color="secondary" alt="Bob" />
            <c-avatar color="success" alt="Clara" />
            <c-avatar color="info" alt="Dan" />
          </c-avatar-group>
        </view>
      </view>
    </view>

    <!-- 4. Mixed Content & Custom UI Spacing -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Mixed Content & Custom UI Spacing</text>
        <text class="block text-xs text-muted mt-0.5">Images, initials, icons & custom ui base spacing.</text>
      </view>
      <view class="flex items-center justify-between flex-wrap gap-3">
        <c-avatar-group size="lg" max="{{ 4 }}" ui="{{ { root: 'gap-0.5' } }}">
          <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" />
          <c-avatar color="primary" alt="John Doe" />
          <c-avatar color="secondary" text="VIP" />
          <c-avatar color="warning" icon="i-lucide-user" />
          <c-avatar color="danger" alt="Sarah Connor" />
        </c-avatar-group>
      </view>
    </view>
  </view>
</view>
