<view class="min-h-screen bg-neutral-50 text-neutral-900 pb-20">
  <!-- Page Header -->
  <view class="px-6 pt-8 pb-5 bg-white border-b border-neutral-200 mb-6">
    <view class="text-xl font-extrabold text-neutral-950">AvatarGroup</view>
    <view class="text-xs text-neutral-500 mt-1">
      Stack multiple avatars together with border rings, size scaling, and overflow counter (+N).
    </view>
  </view>

  <view class="px-5 flex flex-col gap-6">
    <!-- 1. Basic Stacking -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">1. Basic Stacking</view>
      <view class="text-xs text-neutral-400 mb-4">
        Avatars stacked together with negative margins and white separation rings.
      </view>
      <view class="py-2">
        <c-avatar-group>
          <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Felix" />
          <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" alt="Aneka" />
          <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Milo" alt="Milo" />
          <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Bella" alt="Bella" />
        </c-avatar-group>
      </view>
    </view>

    <!-- 2. Max Display & Counter (+N) -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">2. Max Limit & Overflow (+N Counter)</view>
      <view class="text-xs text-neutral-400 mb-4">
        Limits the number of visible avatars. The rest are truncated into an overflow counter.
      </view>
      <view class="flex flex-col gap-4">
        <view class="flex items-center justify-between border-b border-neutral-100 pb-3">
          <view class="flex flex-col">
            <text class="text-xs font-semibold text-neutral-700">max="2"</text>
            <text class="text-[11px] text-neutral-400">4 total avatars -> 2 shown, +2</text>
          </view>
          <c-avatar-group max="{{2}}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Felix" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" alt="Aneka" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Milo" alt="Milo" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Bella" alt="Bella" />
          </c-avatar-group>
        </view>

        <view class="flex items-center justify-between border-b border-neutral-100 pb-3">
          <view class="flex flex-col">
            <text class="text-xs font-semibold text-neutral-700">max="3"</text>
            <text class="text-[11px] text-neutral-400">5 total avatars -> 3 shown, +2</text>
          </view>
          <c-avatar-group max="{{3}}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Felix" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" alt="Aneka" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Milo" alt="Milo" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Bella" alt="Bella" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Oliver" alt="Oliver" />
          </c-avatar-group>
        </view>

        <view class="flex items-center justify-between">
          <view class="flex flex-col">
            <text class="text-xs font-semibold text-neutral-700">max="1"</text>
            <text class="text-[11px] text-neutral-400">4 total avatars -> 1 shown, +3</text>
          </view>
          <c-avatar-group max="{{1}}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Felix" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" alt="Aneka" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Milo" alt="Milo" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Bella" alt="Bella" />
          </c-avatar-group>
        </view>
      </view>
    </view>

    <!-- 3. Interactive Playground -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">3. Interactive Playground</view>
      <view class="text-xs text-neutral-400 mb-4">
        Dynamically adjust the max limit and add or remove avatars in real time.
      </view>

      <view class="bg-neutral-50 p-4 rounded-xl border border-neutral-200 flex flex-col items-center justify-center gap-2 mb-4">
        <c-avatar-group max="{{interactiveMax}}" size="lg">
          <c-avatar wx:for="{{interactiveAvatars}}" wx:key="id" src="{{item.src}}" alt="{{item.alt}}" />
        </c-avatar-group>
        <view class="text-xs text-neutral-500 mt-2">
          Total avatars: <text class="font-bold text-neutral-900">{{interactiveAvatars.length}}</text> |
          Max prop: <text class="font-bold text-neutral-900">{{interactiveMax === 0 ? 'All (0)' : interactiveMax}}</text>
        </view>
      </view>

      <!-- Controls -->
      <view class="flex flex-col gap-3">
        <view class="flex items-center justify-between">
          <text class="text-xs font-medium text-neutral-600">Max limit:</text>
          <view class="flex items-center gap-1.5">
            <view
              wx:for="{{[0, 1, 2, 3, 4, 5]}}"
              wx:key="*this"
              data-max="{{item}}"
              bind:tap="setPresetMax"
              class="px-2.5 py-1 text-xs rounded-lg font-medium border transition-colors {{interactiveMax === item ? 'bg-neutral-900 text-white border-neutral-900' : 'bg-white text-neutral-700 border-neutral-200'}}"
            >
              {{item === 0 ? 'All' : item}}
            </view>
          </view>
        </view>

        <view class="flex items-center justify-between pt-1">
          <text class="text-xs font-medium text-neutral-600">Avatar count:</text>
          <view class="flex items-center gap-2">
            <c-button size="xs" variant="outline" color="neutral" bind:tap="removeAvatar">
              - Remove
            </c-button>
            <c-button size="xs" variant="outline" color="primary" bind:tap="addAvatar">
              + Add
            </c-button>
          </view>
        </view>
      </view>
    </view>

    <!-- 4. Size Variants -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">4. Size Variants</view>
      <view class="text-xs text-neutral-400 mb-4">
        Size is inherited by all children and adjusts border ring thickness and overlapping offset.
      </view>

      <view class="flex flex-col gap-4">
        <view class="flex items-center justify-between">
          <text class="text-xs text-neutral-500">xs (size-6)</text>
          <c-avatar-group size="xs" max="{{3}}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=1" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=2" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=3" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=4" />
          </c-avatar-group>
        </view>

        <view class="flex items-center justify-between">
          <text class="text-xs text-neutral-500">sm (size-7)</text>
          <c-avatar-group size="sm" max="{{3}}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=1" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=2" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=3" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=4" />
          </c-avatar-group>
        </view>

        <view class="flex items-center justify-between">
          <text class="text-xs text-neutral-500">md (size-8 - Default)</text>
          <c-avatar-group size="md" max="{{3}}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=1" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=2" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=3" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=4" />
          </c-avatar-group>
        </view>

        <view class="flex items-center justify-between">
          <text class="text-xs text-neutral-500">lg (size-9)</text>
          <c-avatar-group size="lg" max="{{3}}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=1" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=2" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=3" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=4" />
          </c-avatar-group>
        </view>

        <view class="flex items-center justify-between">
          <text class="text-xs text-neutral-500">xl (size-10)</text>
          <c-avatar-group size="xl" max="{{3}}">
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=1" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=2" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=3" />
            <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=4" />
          </c-avatar-group>
        </view>
      </view>
    </view>

    <!-- 5. Mixed Content Fallbacks -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">5. Mixed Content & Fallbacks</view>
      <view class="text-xs text-neutral-400 mb-4">
        Images, initial letter fallbacks, and icon avatars work seamlessly together inside a group.
      </view>
      <view class="py-2">
        <c-avatar-group size="lg" max="{{4}}">
          <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" />
          <c-avatar color="primary" alt="John Doe" />
          <c-avatar color="success" text="VIP" />
          <c-avatar color="warning" icon="i-lucide-user" />
          <c-avatar color="danger" alt="Sarah Connor" />
          <c-avatar src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" />
        </c-avatar-group>
      </view>
    </view>
  </view>
</view>

