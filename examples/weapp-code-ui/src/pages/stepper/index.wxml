<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Stepper"
    badge="Navigation"
    subtitle="Multi-step workflow tracker with horizontal/vertical layout, linear guard, 7 colors, 5 sizes & custom completedIcon."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Interactive Compound Stepper -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Interactive Stepper & Linear Guard</text>
        <text class="block text-xs text-muted mt-0.5">Active Step: {{ activeStep + 1 }} · useComponentRef synced step: {{ stepper.step !== undefined ? stepper.step + 1 : 1 }}</text>
      </view>

      <view class="flex flex-wrap gap-1.5">
        <c-button
          wx:for="{{ colorOptions }}"
          wx:key="*this"
          size="xs"
          color="{{ color === item ? item : 'neutral' }}"
          variant="{{ color === item ? 'solid' : 'outline' }}"
          label="{{ item }}"
          data-color="{{ item }}"
          bind:tap="selectColor"
        />
      </view>

      <view class="flex items-center justify-between gap-2 flex-wrap">
        <view class="flex gap-1.5">
          <c-button
            wx:for="{{ sizeOptions }}"
            wx:key="*this"
            size="xs"
            color="{{ size === item ? 'secondary' : 'neutral' }}"
            variant="{{ size === item ? 'solid' : 'outline' }}"
            label="{{ item }}"
            data-size="{{ item }}"
            bind:tap="selectSize"
          />
        </view>
        <view class="flex items-center gap-1.5">
          <text class="text-xs text-muted">Linear</text>
          <c-switch checked="{{ linear }}" size="xs" bind:change="toggleLinear" />
        </view>
      </view>

      <c-stepper
        id="stepper-controlled"
        value="{{ activeStep }}"
        linear="{{ linear }}"
        color="{{ color }}"
        size="{{ size }}"
        bind:change="onStepChange"
      >
        <c-stepper-item title="Cart" description="Review items" icon="i-lucide-shopping-cart" completed-icon="i-lucide-check" />
        <c-stepper-item title="Shipping" description="Address info" icon="i-lucide-truck" completed-icon="i-lucide-sparkles" />
        <c-stepper-item title="Payment" description="Method & billing" icon="i-lucide-credit-card" />
        <c-stepper-item title="Locked Step" description="Disabled step" icon="i-lucide-lock" disabled="{{ true }}" />
      </c-stepper>

      <view class="flex flex-wrap gap-2 pt-2 border-t border-muted">
        <c-button size="xs" variant="outline" color="neutral" label="Prev" disabled="{{ !stepper.hasPrev }}" bind:tap="prevStep" />
        <c-button size="xs" color="primary" label="Next" disabled="{{ stepper.hasNext === false }}" bind:tap="nextStep" />
        <c-button size="xs" variant="soft" color="secondary" label="api.setStep(2)" bind:tap="jumpToStepTwo" />
        <c-button size="xs" variant="outline" color="neutral" label="Reset" bind:tap="resetStep" />
      </view>
    </view>

    <!-- 2. Data-Driven Steps Array -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Data-Driven Items Array</text>
        <text class="block text-xs text-muted mt-0.5">Configured with custom icon & completedIcon per step object.</text>
      </view>
      <c-stepper items="{{ stepsData }}" value="{{ dataStep }}" color="secondary" bind:change="onDataStepChange" />
    </view>

    <!-- 3. Vertical Order Tracking -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Vertical Orientation & Custom Slots</text>
        <text class="block text-xs text-muted mt-0.5">Vertical order tracking timeline with panel descriptions.</text>
      </view>
      <c-stepper orientation="vertical" value="{{ orderStep }}" color="success" bind:change="onOrderStepChange">
        <c-stepper-item title="Order Confirmed" description="Received at 09:12 AM" icon="i-lucide-circle-check" />
        <c-stepper-item title="Prepared at Fulfillment" description="Packed & labeled" icon="i-lucide-box" />
        <c-stepper-item title="Out for Delivery" description="Arriving today by 6 PM" icon="i-lucide-compass">
          <view slot="default" class="p-2.5 mt-1 rounded-lg bg-muted border border-default">
            <text class="text-xs text-muted">Live courier ETA updated dynamically via step content slot.</text>
          </view>
        </c-stepper-item>
        <c-stepper-item title="Delivered" description="Signed by recipient" icon="i-lucide-home" />
      </c-stepper>
    </view>
  </view>
</view>
