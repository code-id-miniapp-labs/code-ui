<view class="min-h-screen bg-neutral-50 text-neutral-900 pb-16">
  <!-- Page Header -->
  <view class="px-6 pt-8 pb-5 bg-white border-b border-neutral-200 mb-6">
    <view class="text-xl font-extrabold text-neutral-950">FileUpload</view>
    <view class="text-xs text-neutral-500 mt-1">
      WeChat media & file selector supporting preview, progress, validation, grid/list layouts & Form link.
    </view>
  </view>
  <view class="px-5 flex flex-col gap-6">
    <!-- 1. Controlled Component & Statuses -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Controlled Upload & File Statuses</view>
      <view class="text-xs text-neutral-400 mb-4">
        Syncs state with page data. Shows uploading progress bars, success marks, error badges, and remove actions.
      </view>
      <view class="flex flex-col gap-4">
        <c-file-upload value="{{controlledFiles}}" label="Drop files or tap to browse" description="Supports photos, videos, and documents up to 50MB" bind:change="onControlledChange" bind:accept="onFileAccept" bind:reject="onFileReject" bind:remove="onFileRemove" bind:preview="onFilePreview" bind:fileClick="onFileClick" />
        <!-- Event & State Inspector -->
        <view class="flex flex-col gap-1.5 text-xs bg-neutral-50 p-3 rounded-xl border border-neutral-200">
          <view class="flex items-center justify-between">
            <text class="text-neutral-500">Files Count:</text>
            <text class="font-bold text-neutral-900">{{controlledFiles.length}} file(s)</text>
          </view>
          <view class="flex items-center justify-between">
            <text class="text-neutral-500">Last Action:</text>
            <text class="font-mono text-neutral-700 truncate max-w-[400rpx]">{{lastEvent}}</text>
          </view>
        </view>
        <!-- Interactive Quick Actions -->
        <view class="flex flex-wrap gap-2">
          <c-button size="sm" variant="outline" color="primary" bind:tap="addMockImage">
            + Image
          </c-button>
          <c-button size="sm" variant="outline" color="neutral" bind:tap="addMockVideo">
            + Video
          </c-button>
          <c-button size="sm" variant="outline" color="neutral" bind:tap="addMockAudio">
            + Audio
          </c-button>
          <c-button size="sm" variant="outline" color="neutral" bind:tap="addMockDoc">
            + Document
          </c-button>
          <c-button size="sm" variant="soft" color="warning" bind:tap="toggleUploadSimulation">
            Toggle Progress
          </c-button>
          <c-button size="sm" variant="soft" color="danger" bind:tap="clearControlledFiles">
            Clear Files
          </c-button>
        </view>
      </view>
    </view>
    <!-- 2. Grid Layout -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Grid Layout</view>
      <view class="text-xs text-neutral-400 mb-4">
        Displays selected items in a responsive 2-column grid layout, perfect for photo albums and image galleries.
      </view>
      <c-file-upload layout="grid" defaultValue="{{sampleGridFiles}}" label="Photo Gallery Upload" description="Grid display with aspectFill image thumbnails" />
    </view>
    <!-- 3. Media Filtering & Selection Modes -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Media Filters & Selection Modes</view>
      <view class="text-xs text-neutral-400 mb-4">
        Filter by images only, videos only, or open WeChat chat files picker.
      </view>
      <view class="flex flex-col gap-4">
        <view>
          <view class="text-xs font-semibold text-neutral-700 mb-1.5">
            Images Only (Album & Camera)
          </view>
          <c-file-upload mediaType="{{['image']}}" accept="image/*" label="Upload Photos" description="JPG, PNG, WebP image formats only" />
        </view>
        <view>
          <view class="text-xs font-semibold text-neutral-700 mb-1.5">Videos Only</view>
          <c-file-upload mediaType="{{['video']}}" accept="video/*" label="Upload Video Clip" description="MP4, MOV videos up to 60s" />
        </view>
        <view>
          <view class="text-xs font-semibold text-neutral-700 mb-1.5">Audio Only (Chat / Message Files)</view>
          <c-file-upload mode="messageFile" accept=".mp3,.wav,.m4a,.aac,.flac" label="Upload Audio Files" description="MP3, WAV, AAC audio tracks from WeChat chats" />
        </view>
        <view>
          <view class="text-xs font-semibold text-neutral-700 mb-1.5">
            Chat Documents (Message Files)
          </view>
          <c-file-upload mode="messageFile" accept=".pdf,.doc,.docx,.xls,.xlsx,.zip" label="Select Chat Documents" description="Choose PDF, Word, or Excel files directly from WeChat chats" bind:reject="onHandleReject" />
        </view>
      </view>
    </view>
    <!-- 4. Constraints & Rejection Handling -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Constraints & Rejection Handling</view>
      <view class="text-xs text-neutral-400 mb-4">
        Fires bind:reject when file size, file type, or maxFiles constraints are violated.
      </view>
      <c-file-upload
        id="reject-demo"
        maxFiles="{{2}}"
        maxSize="{{102400}}"
        accept=".pdf"
        label="Strict Rules (Max 2 Files, Max 100KB, PDF only)"
        description="Try picking any file > 100KB, non-PDF, or tap the test buttons below"
        bind:reject="onHandleReject"
        bind:accept="onFileAccept"
      />
      <view class="flex flex-wrap gap-2 mt-3">
        <c-button size="xs" variant="soft" color="danger" bind:tap="triggerRejectSize">
          Reject Test: Size &gt; 100KB
        </c-button>
        <c-button size="xs" variant="soft" color="warning" bind:tap="triggerRejectType">
          Reject Test: Non-PDF (.mp3)
        </c-button>
        <c-button size="xs" variant="soft" color="neutral" bind:tap="triggerRejectMaxFiles">
          Reject Test: Max Limit (&gt;2)
        </c-button>
      </view>
    </view>
    <!-- 5. Visual Variants -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Variants</view>
      <view class="text-xs text-neutral-400 mb-4">outline, soft, subtle, none</view>
      <view class="flex flex-col gap-4">
        <c-file-upload variant="outline" label="Outline (Default)" description="Neutral dashed border" />
        <c-file-upload variant="soft" label="Soft Variant" description="Subtle filled container" />
        <c-file-upload variant="subtle" label="Subtle Variant" description="Light border with muted tint" />
        <c-file-upload variant="none" label="None Variant" description="Clean borderless dropzone" />
      </view>
    </view>
    <!-- 6. Sizes -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Sizes</view>
      <view class="text-xs text-neutral-400 mb-4">sm, md, lg, xl</view>
      <view class="flex flex-col gap-4">
        <c-file-upload size="sm" label="Small (sm)" description="Compact padding and typography" />
        <c-file-upload size="md" label="Medium (md)" description="Default comfortable size" />
        <c-file-upload size="lg" label="Large (lg)" description="Prominent dropzone area" />
        <c-file-upload size="xl" label="Extra Large (xl)" description="Heroic banner size dropzone" />
      </view>
    </view>
    <!-- 7. Disabled & ReadOnly -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Disabled & ReadOnly</view>
      <view class="text-xs text-neutral-400 mb-4">
        Disabled prevents all interactions. ReadOnly permits viewing/previewing while disabling deletion and picker.
      </view>
      <view class="flex flex-col gap-4">
        <view>
          <view class="text-xs font-semibold text-neutral-700 mb-1.5">Disabled State</view>
          <c-file-upload disabled="{{true}}" defaultValue="{{sampleDisabledFiles}}" label="Upload Disabled" description="Interactions are blocked" />
        </view>
        <view>
          <view class="text-xs font-semibold text-neutral-700 mb-1.5">ReadOnly State</view>
          <c-file-upload readOnly="{{true}}" defaultValue="{{sampleReadOnlyFiles}}" label="Upload Read-Only" description="Viewing allowed, deletions locked" />
        </view>
      </view>
    </view>
    <!-- 8. Custom Dropzone Slot -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Custom Dropzone Slot</view>
      <view class="text-xs text-neutral-400 mb-4">
        Inject custom markup, banners, or action buttons inside the dropzone area.
      </view>
      <c-file-upload icon="" label="" description="" variant="soft">
        <view class="flex flex-col items-center justify-center py-2 text-center">
          <view class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mb-2">
            <c-icon name="i-lucide-cloud-upload" className="w-6 h-6" />
          </view>
          <view class="text-sm font-bold text-neutral-900">Upload Project Deliverables</view>
          <view class="text-xs text-neutral-500 mt-1">Tap to browse files from device or chat</view>
          <view class="mt-3 px-3 py-1 rounded-full text-[11px] font-medium bg-white text-blue-600 border border-blue-200 shadow-2xs">
            Browse Files
          </view>
        </view>
      </c-file-upload>
    </view>
    <!-- 9. Form Integration & Validation -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Form Integration & Validation</view>
      <view class="text-xs text-neutral-400 mb-4">
        Connects with &lt;c-form&gt; and &lt;c-form-field&gt; for automatic validation before submission.
      </view>
      <c-form id="upload-form" focusOnError="{{true}}" showErrors="{{true}}" bind:submit="handleFormSubmit" bind:error="handleFormError">
        <view class="flex flex-col gap-4">
          <c-form-field name="proof" label="Proof of Identity" description="Please attach a valid identification document" rules="{{fileRules}}" required="{{true}}">
            <c-file-upload name="proof" maxFiles="{{1}}" label="Select Identification Document" description="PNG, JPG or PDF up to 10MB" />
          </c-form-field>
          <view wx:if="{{formStatus === 'success'}}" class="p-3 rounded-xl text-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
            {{formMessage}}
          </view>
          <view wx:elif="{{formStatus === 'error'}}" class="p-3 rounded-xl text-xs bg-red-50 text-red-800 border border-red-200">
            {{formMessage}}
          </view>
          <view class="flex gap-2 pt-1">
            <c-button variant="solid" color="primary" size="sm" bind:tap="submitForm">
              Submit Form
            </c-button>
            <c-button variant="outline" color="neutral" size="sm" bind:tap="resetForm">
              Reset Form
            </c-button>
          </view>
        </view>
      </c-form>
    </view>
  </view>
</view>