<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="File Upload"
    badge="Form"
    subtitle="Media & document uploader with grid/list layouts, progress tracking, dropzone=false button mode & validation."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Controlled Upload & Progress Simulation -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled Upload & File Statuses</text>
        <text class="block text-xs text-muted mt-0.5">Files: {{ controlledFiles.length }} · Last event: {{ lastEvent }}</text>
      </view>
      <c-file-upload
        value="{{ controlledFiles }}"
        label="Drop files or tap to browse"
        description="Supports photos, videos, audio & documents"
        bind:change="onControlledChange"
        bind:accept="onFileAccept"
        bind:reject="onFileReject"
        bind:remove="onFileRemove"
        bind:preview="onFilePreview"
        bind:fileClick="onFileClick"
      />
      <view class="flex flex-wrap gap-2 pt-1">
        <c-button size="xs" variant="outline" color="primary" label="+ Image" bind:tap="addMockImage" />
        <c-button size="xs" variant="outline" color="neutral" label="+ Video" bind:tap="addMockVideo" />
        <c-button size="xs" variant="outline" color="neutral" label="+ Audio" bind:tap="addMockAudio" />
        <c-button size="xs" variant="outline" color="neutral" label="+ Doc" bind:tap="addMockDoc" />
        <c-button size="xs" variant="soft" color="warning" label="Toggle Progress" bind:tap="toggleUploadSimulation" />
        <c-button size="xs" variant="soft" color="danger" label="Clear" bind:tap="clearControlledFiles" />
      </view>
    </view>

    <!-- 2. Button Mode (dropzone=false) & Secondary Color -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Compact Button Mode (dropzone=false) & Colors</text>
        <text class="block text-xs text-muted mt-0.5">Trigger picker with a compact trigger button and secondary accent.</text>
      </view>
      <c-file-upload dropzone="{{ false }}" color="secondary" label="Attach Receipt" />
      <c-file-upload variant="soft" color="secondary" label="Secondary Dropzone Area" description="Soft dropzone tinted with active secondary color." />
    </view>

    <!-- 3. Grid Layout & Media Filters -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Grid Layout & Media Filtering</text>
        <text class="block text-xs text-muted mt-0.5">2-column thumbnail grid plus image/video/messageFile filters.</text>
      </view>
      <c-file-upload layout="grid" default-value="{{ sampleGridFiles }}" label="Photo Gallery Grid" description="Thumbnails arranged in responsive grid" />
      <view class="flex flex-col gap-3 pt-3 border-t border-muted">
        <c-file-upload media-type="{{ ['image'] }}" accept="image/*" label="Images Only (Album & Camera)" />
        <c-file-upload mode="messageFile" accept=".pdf,.doc,.docx,.xls,.xlsx,.zip" label="WeChat Chat Documents" bind:reject="onHandleReject" />
      </view>
    </view>

    <!-- 4. Constraints & Rejection Handling -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Constraints & Rejection Handling</text>
        <text class="block text-xs text-muted mt-0.5">Max 2 files, 100KB limit, PDF-only validation.</text>
      </view>
      <c-file-upload
        id="reject-demo"
        max-files="{{ 2 }}"
        max-size="{{ 102400 }}"
        accept=".pdf"
        label="Strict Rules (Max 2, 100KB, .pdf)"
        description="Try triggering rejection rules below"
        bind:reject="onHandleReject"
        bind:accept="onFileAccept"
      />
      <view class="flex flex-wrap gap-2">
        <c-button size="xs" variant="soft" color="danger" label="Test Size > 100KB" bind:tap="triggerRejectSize" />
        <c-button size="xs" variant="soft" color="warning" label="Test Non-PDF" bind:tap="triggerRejectType" />
        <c-button size="xs" variant="soft" color="neutral" label="Test Max > 2" bind:tap="triggerRejectMaxFiles" />
      </view>
    </view>

    <!-- 5. Variants, Sizes, States & Custom Slot -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Variants, Sizes, States & Custom Slot</text>
        <text class="block text-xs text-muted mt-0.5">outline, soft, subtle, none; sizes sm-xl; disabled, readOnly & ui.</text>
      </view>
      <view class="flex flex-col gap-2.5">
        <c-file-upload variant="outline" size="sm" label="Outline · sm" />
        <c-file-upload variant="soft" size="md" label="Soft · md" />
        <c-file-upload variant="subtle" size="lg" label="Subtle · lg" />
        <c-file-upload variant="none" size="sm" label="None · Borderless" />
      </view>

      <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
        <c-file-upload disabled="{{ true }}" default-value="{{ sampleDisabledFiles }}" label="Disabled Uploader" />
        <c-file-upload read-only="{{ true }}" default-value="{{ sampleReadOnlyFiles }}" label="Read-Only Previewer" />
        <c-file-upload variant="soft" ui="{{ { dropzone: 'border-dashed border-2 border-primary/40 bg-primary/5' } }}">
          <view class="flex flex-col items-center py-2 text-center">
            <view class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center mb-1.5">
              <c-icon name="i-lucide-cloud-upload" size="md" color="primary" />
            </view>
            <text class="text-sm font-semibold text-highlighted">Custom Dropzone UI</text>
            <text class="text-xs text-muted mt-0.5">Styled via default slot & ui overrides.</text>
          </view>
        </c-file-upload>
      </view>
    </view>

    <!-- 6. Form Integration -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Form Validation Integration</text>
        <text class="block text-xs text-muted mt-0.5">Validates required attachment inside c-form.</text>
      </view>
      <c-form id="upload-form" focus-on-error="{{ true }}" bind:submit="handleFormSubmit" bind:error="handleFormError">
        <c-form-field name="proof" label="Proof of Identity" rules="{{ fileRules }}" required="{{ true }}">
          <c-file-upload name="proof" max-files="{{ 1 }}" label="Attach ID Document" description="PNG, JPG or PDF" />
        </c-form-field>
      </c-form>
      <view wx:if="{{ formStatus }}" class="p-2.5 rounded-xl text-xs bg-elevated border border-default text-toned">
        {{ formStatus }}: {{ formMessage }}
      </view>
      <view class="flex gap-2">
        <c-button size="xs" color="primary" label="Submit" bind:tap="submitForm" />
        <c-button size="xs" color="neutral" variant="outline" label="Reset" bind:tap="resetForm" />
      </view>
    </view>
  </view>
</view>
