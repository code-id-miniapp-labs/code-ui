<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Input"
    badge="Form"
    subtitle="Single-line text field supporting 5 variants, 7 colors, 5 sizes, icons, clearable, password, loading & FormField."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Controlled State & Events -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled State & Events</text>
        <text class="block text-xs text-muted mt-0.5">Event: {{ lastEvent }}</text>
      </view>
      <c-input
        value="{{ controlledValue }}"
        placeholder="Type something..."
        bind:change="onControlledInput"
        bind:focus="onInputFocus"
        bind:blur="onInputBlur"
      />
      <view class="flex gap-2">
        <c-button size="xs" variant="outline" color="primary" label="Set Predefined" bind:tap="setControlledPredefined" />
        <c-button size="xs" variant="outline" color="neutral" label="Clear" bind:tap="clearControlled" />
      </view>
    </view>

    <!-- 2. Leading/Trailing Icons, Clearable & Loading -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Icons, Clearable, Password & Loading</text>
        <text class="block text-xs text-muted mt-0.5">Built-in leadingIcon, trailingIcon, clearable, password & loading spinner.</text>
      </view>
      <c-input leading-icon="i-lucide-search" placeholder="Search documentation..." clearable="{{ true }}" confirm-type="search" />
      <c-input leading-icon="i-lucide-mail" trailing-icon="i-lucide-check-circle" color="success" highlight="{{ true }}" placeholder="you@domain.com" />
      <c-input value="{{ clearableValue }}" clearable="{{ true }}" placeholder="Clearable field" bind:change="onClearableChange" bind:clear="onInputClear" />
      <c-input value="{{ passwordValue }}" password="{{ true }}" leading-icon="i-lucide-lock" placeholder="Password" />
      <c-input loading="{{ true }}" leading-icon="i-lucide-globe" value="Checking domain availability..." />
    </view>

    <!-- 3. Custom Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Leading & Trailing Custom Slots</text>
        <text class="block text-xs text-muted mt-0.5">Compose URL prefixes, currencies or inline badges via slots.</text>
      </view>
      <c-input placeholder="example.dev">
        <text slot="leading" class="text-xs font-mono text-dimmed">https://</text>
        <c-badge slot="trailing" label="Live" size="xs" color="success" variant="soft" />
      </c-input>
      <c-input placeholder="workspace-name" value="engineering-platform">
        <text slot="leading" class="text-xs font-medium text-dimmed">https://app.code-ui.dev/</text>
        <text slot="trailing" class="text-xs text-muted">.internal</text>
      </c-input>
    </view>

    <!-- 4. Input Types & Confirm Key -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Native Keyboard Types & ConfirmType</text>
        <text class="block text-xs text-muted mt-0.5">type='number' / 'digit' / 'idcard' and confirm-type='send' / 'search'.</text>
      </view>
      <c-input type="number" placeholder="Quantity (numeric keypad)" />
      <c-input type="digit" placeholder="Amount with decimals (0.00)" />
      <c-input confirm-type="send" placeholder="Quick reply (Send key on keyboard)" trailing-icon="i-lucide-send" />
    </view>

    <!-- 5. Variants & Colors -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Variants & Semantic Colors</text>
        <text class="block text-xs text-muted mt-0.5">All 5 variants plus secondary & highlight focus ring.</text>
      </view>
      <view class="flex flex-col gap-2.5">
        <c-input wx:for="{{ variants }}" wx:key="*this" variant="{{ item }}" placeholder="Variant: {{ item }}" />
      </view>
      <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
        <c-input wx:for="{{ colors }}" wx:key="*this" color="{{ item }}" highlight="{{ true }}" placeholder="Color: {{ item }} (highlight)" />
      </view>
    </view>

    <!-- 6. Sizes, States & FormField -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Sizes (xs-xl), States & FormField</text>
        <text class="block text-xs text-muted mt-0.5">Disabled, readOnly, invalid & wrapped FormField helper layout.</text>
      </view>
      <view class="flex flex-col gap-2.5">
        <c-input wx:for="{{ sizes }}" wx:key="*this" size="{{ item }}" placeholder="Size: {{ item }}" />
      </view>
      <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
        <c-input disabled="{{ true }}" value="Disabled input value" />
        <c-input read-only="{{ true }}" value="Read-only preset value" />
        <c-input invalid="{{ true }}" value="Invalid value" trailing-icon="i-lucide-alert-circle" />
        <c-form-field label="Workspace Slug" hint="Required" help="Lowercase letters and hyphens only" required="{{ true }}">
          <c-input placeholder="acme-corp" leading-icon="i-lucide-layers" />
        </c-form-field>
      </view>
    </view>
  </view>
</view>
