<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Presence"
    badge="Overlay & Lifecycle"
    subtitle="Declarative mount/unmount animations with <c-presence> and parent-level true unmounting for custom <c-drawer>, <c-modal>, and <c-action-sheet> wrappers."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Live Instance Counters -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Active Overlay Component Instances</text>
        <text class="block text-xs text-muted mt-0.5">
          Notice each custom component stays at 0 when closed — truly detached once bind:exitcomplete fires.
        </text>
      </view>
      <view class="grid grid-cols-2 gap-2.5">
        <view class="p-3 rounded-xl bg-muted border border-default flex flex-col gap-1">
          <text class="text-[11px] text-muted">filter-drawer (c-drawer)</text>
          <view class="flex items-center justify-between">
            <text class="text-lg font-bold text-highlighted">{{ drawerInstances }}</text>
            <c-badge
              label="{{ filterDrawer.state || 'unmounted' }}"
              color="{{ filterDrawer.open ? 'success' : filterDrawer.mounted ? 'warning' : 'neutral' }}"
              variant="soft"
              size="xs"
            />
          </view>
        </view>
        <view class="p-3 rounded-xl bg-muted border border-default flex flex-col gap-1">
          <text class="text-[11px] text-muted">confirm-modal (c-modal)</text>
          <view class="flex items-center justify-between">
            <text class="text-lg font-bold text-highlighted">{{ modalInstances }}</text>
            <c-badge
              label="{{ confirmModal.state || 'unmounted' }}"
              color="{{ confirmModal.open ? 'success' : confirmModal.mounted ? 'warning' : 'neutral' }}"
              variant="soft"
              size="xs"
            />
          </view>
        </view>
      </view>
    </view>

    <!-- 2. Custom Component Overlays with usePresence -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Custom Components Extending Overlays</text>
        <text class="block text-xs text-muted mt-0.5">
          Pair wx:if with usePresence() and bind:exitcomplete so heavy custom drawers, modals, and action sheets unmount completely after exit animations.
        </text>
      </view>
      <view class="flex flex-wrap gap-2">
        <c-button size="sm" color="primary" label="Open Filter Drawer" bind:tap="openFilterDrawer" />
        <c-button size="sm" color="danger" variant="soft" label="Open Confirm Modal" bind:tap="openConfirmModal" />
        <c-button size="sm" color="secondary" variant="outline" label="Open Action Sheet" bind:tap="openActionSheet" />
      </view>
      <c-button
        size="xs"
        variant="ghost"
        color="neutral"
        label="Test Rapid Open → Close → Reopen (Drawer)"
        bind:tap="testRapidInterrupt"
      />
    </view>

    <!-- 3. Declarative <c-presence> -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view class="flex items-center justify-between">
        <view>
          <text class="block text-sm font-semibold text-highlighted">Declarative &lt;c-presence&gt;</text>
          <text class="block text-xs text-muted mt-0.5">
            Controls data-state="open|closed" with lazyMount &amp; unmountOnExit.
          </text>
        </view>
        <c-button
          size="xs"
          color="{{ panelPresent ? 'neutral' : 'primary' }}"
          variant="{{ panelPresent ? 'outline' : 'solid' }}"
          label="{{ panelPresent ? 'Hide Panel' : 'Show Panel' }}"
          bind:tap="togglePanel"
        />
      </view>

      <c-switch
        checked="{{ unmountOnExit }}"
        label="Unmount on Exit (unmount-on-exit)"
        bind:change="onUnmountOnExitChange"
      />

      <c-presence
        present="{{ panelPresent }}"
        lazy-mount="{{ true }}"
        unmount-on-exit="{{ unmountOnExit }}"
        duration="{{ 250 }}"
        className="block transition-all duration-250 ease-out"
        ui="{{ { root: panelPresent ? 'opacity-100 translate-y-0 scale-100' : 'opacity-0 -translate-y-2 scale-95' } }}"
        bind:exitcomplete="onPanelExitComplete"
      >
        <view class="p-3.5 rounded-xl bg-primary/10 border border-primary/25">
          <text class="block text-xs font-semibold text-primary">Animated Presence Panel</text>
          <text class="block text-xs text-toned mt-1 leading-relaxed">
            Stays mounted during the 250ms exit animation, then fires bind:exitcomplete and unmounts cleanly.
          </text>
        </view>
      </c-presence>
    </view>

    <!-- 4. Lifecycle Event Log -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-2">
      <view class="flex items-center justify-between">
        <text class="text-sm font-semibold text-highlighted">Lifecycle Event Log</text>
        <c-button size="xs" variant="ghost" color="neutral" label="Clear" bind:tap="clearLogs" />
      </view>
      <view class="bg-muted rounded-xl p-3 flex flex-col gap-1 border border-muted">
        <text wx:for="{{ logs }}" wx:key="*this" class="text-[11px] font-mono text-toned">• {{ item }}</text>
      </view>
    </view>
  </view>
</view>

<!-- Custom Component extending <c-drawer>: truly mounted/unmounted via wx:if + bind:exitcomplete -->
<filter-drawer
  wx:if="{{ filterDrawer.mounted }}"
  open="{{ filterDrawer.open }}"
  bind:close="closeFilterDrawer"
  bind:exitcomplete="onFilterDrawerExitComplete"
  bind:apply="onFilterApply"
  bind:attached="onFilterDrawerAttached"
  bind:detached="onFilterDrawerDetached"
/>

<!-- Custom Component extending <c-modal>: truly mounted/unmounted via wx:if + bind:exitcomplete -->
<confirm-modal
  wx:if="{{ confirmModal.mounted }}"
  open="{{ confirmModal.open }}"
  title="Delete Draft?"
  bind:close="closeConfirmModal"
  bind:exitcomplete="onConfirmModalExitComplete"
  bind:confirm="onConfirmAction"
  bind:attached="onConfirmModalAttached"
  bind:detached="onConfirmModalDetached"
/>

<!-- Direct <c-action-sheet> with usePresence -->
<c-action-sheet
  wx:if="{{ actionSheet.mounted }}"
  open="{{ actionSheet.open }}"
  title="Quick Share"
  description="Mounted lazily and detached after exitcomplete."
  items="{{ sheetItems }}"
  actions="{{ sheetActions }}"
  bind:close="closeActionSheet"
  bind:exitcomplete="onActionSheetExitComplete"
/>
