<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Divider"
    badge="Navigation"
    subtitle="Horizontal & vertical section separators with solid/dashed/dotted styles, icons, labels, 7 colors & sizes."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Styles & Orientation -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Border Styles & Vertical Orientation</text>
        <text class="block text-xs text-muted mt-0.5">solid, dashed & dotted lines plus inline vertical splitters.</text>
      </view>
      <view class="flex flex-col gap-3">
        <c-divider type="solid" label="Solid (Default)" />
        <c-divider type="dashed" label="Dashed Line" />
        <c-divider type="dotted" label="Dotted Line" />
      </view>
      <view class="flex items-center justify-center gap-4 h-8 pt-2 border-t border-muted">
        <text class="text-xs text-muted">Overview</text>
        <c-divider orientation="vertical" />
        <text class="text-xs text-muted">Analytics</text>
        <c-divider orientation="vertical" type="dashed" color="primary" />
        <text class="text-xs text-muted">Settings</text>
      </view>
    </view>

    <!-- 2. Label Positions, Icons & Custom Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Positions, Icons & Custom Content</text>
        <text class="block text-xs text-muted mt-0.5">Align labels start/center/end or combine leading/trailing icons and avatar slots.</text>
      </view>
      <view class="flex flex-col gap-3">
        <c-divider label="Start Label" position="start" />
        <c-divider label="Centered (Default)" position="center" />
        <c-divider label="End Label" position="end" />
        <c-divider leading-icon="i-lucide-sparkles" label="Leading Icon" color="primary" />
        <c-divider trailing-icon="i-lucide-arrow-right" label="Trailing Prop" position="end" color="secondary" />
        <c-divider leading-icon="i-lucide-shield-check" trailing-icon="i-lucide-chevron-right" label="Security Verified" color="success" />
        <c-divider>
          <c-avatar size="2xs" color="primary" text="CU" />
        </c-divider>
      </view>
    </view>

    <!-- 3. Semantic Colors & Stroke Weights -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Colors & Stroke Weights (xs - lg)</text>
        <text class="block text-xs text-muted mt-0.5">All 7 color tokens including secondary & line thickness scale.</text>
      </view>
      <view class="flex flex-col gap-2.5">
        <c-divider wx:for="{{ colors }}" wx:key="*this" color="{{ item }}" label="{{ item }}" />
      </view>
      <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
        <c-divider wx:for="{{ sizes }}" wx:key="*this" size="{{ item }}" color="primary" label="size={{ item }}" />
      </view>
    </view>
  </view>
</view>
