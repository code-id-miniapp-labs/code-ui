<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Chip"
    badge="Data Display"
    subtitle="Corner status dot & counter indicators supporting 9 sizes, 4 positions, inset alignment, content slot & visibility toggle."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Interactive Show Toggle & Content Slot -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view class="flex items-center justify-between gap-2">
        <view>
          <text class="block text-sm font-semibold text-highlighted">Show Toggle, Counter & Custom Slot</text>
          <text class="block text-xs text-muted mt-0.5">Dynamically show/hide or replace dot text via slot="content".</text>
        </view>
        <c-switch checked="{{ showUnread }}" size="sm" color="primary" bind:change="toggleShow" />
      </view>

      <view class="flex flex-wrap items-center gap-6 py-2">
        <c-chip show="{{ showUnread }}" text="{{ unreadCount }}" color="danger" size="lg">
          <c-button size="sm" color="neutral" variant="soft" leading-icon="i-lucide-bell" label="Inbox" bind:tap="bumpCount" />
        </c-chip>

        <c-chip show="{{ showUnread }}" color="primary" inset="{{ true }}" size="md">
          <view slot="content">
            <c-icon name="i-lucide-sparkles" size="xs" color="neutral" />
          </view>
          <c-avatar size="lg" color="secondary" text="CU" />
        </c-chip>

        <c-chip show="{{ showUnread }}" color="success" size="md" ui="{{ { base: 'animate-pulse ring-2 ring-success/40' } }}">
          <c-avatar size="lg" text="ON" color="neutral" />
        </c-chip>
      </view>
    </view>

    <!-- 2. Semantic Colors -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Semantic Colors & Standalone</text>
        <text class="block text-xs text-muted mt-0.5">All 7 semantic tokens including secondary in overlay & inline standalone mode.</text>
      </view>
      <view class="flex flex-wrap items-center gap-4 py-1">
        <c-chip wx:for="{{ colors }}" wx:key="*this" color="{{ item }}" size="md">
          <c-button size="xs" variant="outline" color="neutral" icon="i-lucide-mail" />
        </c-chip>
      </view>
      <view class="flex flex-wrap items-center gap-3 pt-2 border-t border-muted">
        <text class="text-xs text-muted mr-1">Standalone:</text>
        <c-chip wx:for="{{ colors }}" wx:key="*this" standalone="{{ true }}" color="{{ item }}" size="lg" />
      </view>
    </view>

    <!-- 3. Positions & Inset -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Positions & Inset Corner Alignment</text>
        <text class="block text-xs text-muted mt-0.5">Four corner anchors with optional inset offset for circular avatars.</text>
      </view>
      <view class="flex flex-wrap items-center gap-5 py-1">
        <view wx:for="{{ positions }}" wx:key="*this" class="flex flex-col items-center gap-1.5">
          <c-chip position="{{ item }}" inset="{{ true }}" color="primary" size="md">
            <c-avatar size="lg" src="https://api.dicebear.com/7.x/avataaars/svg?seed=Pos{{ item }}" />
          </c-chip>
          <text class="text-[10px] font-mono text-dimmed">{{ item }}</text>
        </view>
      </view>
    </view>

    <!-- 4. All 9 Sizes (3xs - 3xl) -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Size Scale (3xs - 3xl)</text>
        <text class="block text-xs text-muted mt-0.5">All 9 dot and text chip sizes.</text>
      </view>
      <view class="flex flex-wrap items-center gap-4 py-1">
        <view wx:for="{{ sizes }}" wx:key="*this" class="flex flex-col items-center gap-1.5">
          <c-chip size="{{ item }}" color="secondary" text="{{ index > 3 ? item : '' }}">
            <c-button size="xs" variant="outline" color="neutral" icon="i-lucide-box" />
          </c-chip>
          <text class="text-[10px] font-mono text-dimmed">{{ item }}</text>
        </view>
      </view>
    </view>
  </view>
</view>
