<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Card"
    badge="Data Display"
    subtitle="Surface containers supporting outline, soft, subtle & solid variants with header, default, footer & ui slots."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. All 4 Variants -->
    <view class="flex flex-col gap-3">
      <text class="text-xs font-semibold uppercase tracking-wider text-dimmed px-1">Card Variants</text>

      <c-card variant="outline">
        <view slot="header" class="flex items-center justify-between">
          <text class="text-sm font-semibold text-highlighted">Outline Variant</text>
          <c-badge label="Default" color="primary" variant="soft" size="xs" />
        </view>
        <text class="text-xs text-muted">Standard elevated surface with clean 1px border and semantic dividers.</text>
      </c-card>

      <c-card variant="soft">
        <view slot="header">
          <text class="text-sm font-semibold text-highlighted">Soft Variant</text>
        </view>
        <text class="text-xs text-muted">Muted elevated fill ideal for grouped sections without heavy outlines.</text>
      </c-card>

      <c-card variant="subtle">
        <view slot="header">
          <text class="text-sm font-semibold text-highlighted">Subtle Variant</text>
        </view>
        <text class="text-xs text-muted">Soft fill combined with a subtle hairline border.</text>
      </c-card>

      <c-card variant="solid">
        <view slot="header">
          <text class="text-sm font-semibold">Solid Variant</text>
        </view>
        <text class="text-xs opacity-85">High-contrast inverted surface pairing well with callout highlights.</text>
      </c-card>
    </view>

    <!-- 2. Rich Header + Body + Footer Composition -->
    <view class="flex flex-col gap-3">
      <text class="text-xs font-semibold uppercase tracking-wider text-dimmed px-1">Full Slot Composition & UI Overrides</text>

      <c-card variant="outline">
        <view slot="header" class="flex items-center justify-between gap-3">
          <view class="flex items-center gap-2.5 min-w-0">
            <c-avatar size="sm" color="primary" text="CU" />
            <view class="min-w-0">
              <text class="block text-sm font-semibold text-highlighted">Release v2.4 Ready</text>
              <text class="block text-[11px] text-muted">Deployment summary · 2 mins ago</text>
            </view>
          </view>
          <c-badge label="Production" color="success" variant="soft" size="xs" />
        </view>

        <view class="flex flex-col gap-2.5">
          <text class="text-xs text-muted leading-relaxed">
            Semantic dark-mode tokens and runtime CSS palette generation compiled across 36 components.
          </text>
          <c-progress value="{{ 100 }}" color="success" size="xs" show-value="{{ true }}" />
        </view>

        <view slot="footer" class="flex items-center justify-end gap-2">
          <c-button size="xs" color="neutral" variant="outline" label="View Logs" bind:tap="onCardAction" />
          <c-button size="xs" color="primary" label="Deploy Now" bind:tap="onCardAction" />
        </view>
      </c-card>

      <c-card
        variant="outline"
        ui="{{ { root: 'border-primary/40 ring-2 ring-primary/15', header: 'bg-primary/5', footer: 'bg-elevated/60' } }}"
      >
        <view slot="header" class="flex items-center gap-2">
          <c-icon name="i-lucide-sparkles" size="sm" color="primary" />
          <text class="text-sm font-semibold text-highlighted">Custom UI Slots Styling</text>
        </view>
        <text class="text-xs text-muted">Each part (root, header, body, footer) can be customized independently via ui.</text>
        <view slot="footer">
          <text class="text-[11px] text-dimmed">Styled via ui.header + ui.footer</text>
        </view>
      </c-card>
    </view>
  </view>
</view>
