<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Tabs"
    badge="Navigation"
    subtitle="Animated pill & underline tabs supporting 7 colors, 5 sizes, fitted, vertical layout, lazy panels & list-trailing slot."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Interactive Compound Tabs -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Interactive Compound Tabs</text>
        <text class="block text-xs text-muted mt-0.5">Active: {{ activeTab }} · List trailing taps: {{ extraCount }}</text>
      </view>

      <view class="flex flex-wrap gap-1.5">
        <c-button
          wx:for="{{ variantOptions }}"
          wx:key="*this"
          size="xs"
          color="{{ variant === item ? 'primary' : 'neutral' }}"
          variant="{{ variant === item ? 'solid' : 'outline' }}"
          label="{{ item }}"
          data-variant="{{ item }}"
          bind:tap="selectVariant"
        />
        <c-button
          wx:for="{{ orientationOptions }}"
          wx:key="*this"
          size="xs"
          color="{{ orientation === item ? 'secondary' : 'neutral' }}"
          variant="{{ orientation === item ? 'solid' : 'outline' }}"
          label="{{ item }}"
          data-orientation="{{ item }}"
          bind:tap="selectOrientation"
        />
        <c-button size="xs" color="{{ fitted ? 'primary' : 'neutral' }}" variant="{{ fitted ? 'soft' : 'outline' }}" label="Fitted" bind:tap="toggleFitted" />
      </view>

      <view class="flex flex-wrap gap-1.5">
        <c-button
          wx:for="{{ colorOptions }}"
          wx:key="*this"
          size="xs"
          color="{{ color === item ? item : 'neutral' }}"
          variant="{{ color === item ? 'solid' : 'outline' }}"
          label="{{ item }}"
          data-color="{{ item }}"
          bind:tap="selectColor"
        />
      </view>

      <view class="flex flex-wrap gap-1.5">
        <c-button
          wx:for="{{ sizeOptions }}"
          wx:key="*this"
          size="xs"
          color="{{ size === item ? 'primary' : 'neutral' }}"
          variant="{{ size === item ? 'soft' : 'outline' }}"
          label="{{ item }}"
          data-size="{{ item }}"
          bind:tap="selectSize"
        />
      </view>

      <c-tabs
        id="interactive-tabs"
        value="{{ activeTab }}"
        variant="{{ variant }}"
        orientation="{{ orientation }}"
        size="{{ size }}"
        color="{{ color }}"
        fitted="{{ fitted }}"
        bind:change="onTabChange"
      >
        <view slot="list-trailing" class="pl-1 flex items-center shrink-0">
          <c-button size="xs" variant="ghost" color="neutral" icon="i-lucide-sparkles" bind:tap="onAddTabTrigger" />
        </view>

        <c-tabs-item value="account" label="Account" icon="i-lucide-user">
          <view class="p-3 bg-muted rounded-xl border border-default">
            <text class="block text-sm font-semibold text-highlighted">Account Settings</text>
            <text class="block text-xs text-muted mt-1">Manage your profile identity, preferences & active workspace sessions.</text>
          </view>
        </c-tabs-item>
        <c-tabs-item value="security" label="Security (Lazy)" icon="i-lucide-lock" lazy="{{ true }}">
          <view class="p-3 bg-muted rounded-xl border border-default">
            <text class="block text-sm font-semibold text-highlighted">Lazy-Mounted Panel</text>
            <text class="block text-xs text-muted mt-1">Mounts only when selected via lazy="true".</text>
          </view>
        </c-tabs-item>
        <c-tabs-item value="billing" label="Billing" icon="i-lucide-credit-card">
          <view class="p-3 bg-muted rounded-xl border border-default">
            <text class="block text-sm font-semibold text-highlighted">Subscription & Invoices</text>
            <text class="block text-xs text-muted mt-1">Download tax receipts and configure usage billing limits.</text>
          </view>
        </c-tabs-item>
        <c-tabs-item value="locked" label="Disabled" icon="i-lucide-shield-alert" disabled="{{ true }}">
          <view class="p-3 bg-muted rounded-xl border border-default">
            <text class="text-xs text-muted">Disabled tab cannot be selected.</text>
          </view>
        </c-tabs-item>
      </c-tabs>

      <view class="flex flex-wrap gap-2 pt-2 border-t border-muted">
        <c-button size="xs" variant="outline" color="neutral" label="selectPrev()" bind:tap="prevTab" />
        <c-button size="xs" variant="outline" color="neutral" label="selectNext()" bind:tap="nextTab" />
        <c-button size="xs" variant="soft" color="primary" label="Billing Tab" bind:tap="selectBilling" />
      </view>
    </view>

    <!-- 2. Data-Driven Items Array -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Data-Driven Items Prop</text>
        <text class="block text-xs text-muted mt-0.5">Includes disabled item support out of the box.</text>
      </view>
      <c-tabs items="{{ dataItems }}" value="{{ dataTab }}" variant="link" color="secondary" bind:change="onDataTabChange" />
    </view>

    <!-- 3. Horizontal Scrollable Tablist -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Scrollable Category Strip</text>
        <text class="block text-xs text-muted mt-0.5">Auto-scrolls active tab into view when overflowed.</text>
      </view>
      <c-tabs items="{{ scrollItems }}" value="{{ scrollTab }}" variant="pill" color="primary" bind:change="onScrollTabChange" />
    </view>
  </view>
</view>
