<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header title="Button" badge="Form" subtitle="Interactive button FSM supporting 5 variants, 7 colors, 5 sizes, icon props/slots, loadingAuto & WeChat openType." />
  <view class="px-4 flex flex-col gap-4">
    <!-- Global Disabled Switch -->
    <view class="bg-default border border-default rounded-2xl p-4 flex items-center justify-between gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Toggle Global Disabled</text>
        <text class="block text-xs text-muted mt-0.5">
          Test disabled styling across variants below.
        </text>
      </view>
      <c-switch checked="{{ disabled }}" size="sm" color="primary" bind:change="toggleDisabled" />
    </view>
    <!-- 1. Variants -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Variants</text>
        <text class="block text-xs text-muted mt-0.5">
          solid, outline, soft, ghost & secondary.
        </text>
      </view>
      <view class="flex flex-wrap gap-2.5 items-center">
        <c-button wx:for="{{ variants }}" wx:key="*this" variant="{{ item }}" color="primary" disabled="{{ disabled }}" label="{{ item }}" bind:tap="handleCountTap" />
      </view>
    </view>
    <!-- 2. Semantic Colors -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Semantic Colors</text>
        <text class="block text-xs text-muted mt-0.5">
          Solid & soft across primary, secondary, neutral, success, warning, danger & info.
        </text>
      </view>
      <view class="flex flex-wrap gap-2">
        <c-button wx:for="{{ colors }}" wx:key="*this" size="sm" color="{{ item }}" variant="solid" disabled="{{ disabled }}" label="{{ item }}" />
      </view>
      <view class="flex flex-wrap gap-2 pt-2 border-t border-muted">
        <c-button wx:for="{{ colors }}" wx:key="*this" size="sm" color="{{ item }}" variant="soft" disabled="{{ disabled }}" label="{{ item }}" />
      </view>
    </view>
    <!-- 3. Size Scale -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Sizes & Icon-Only</text>
        <text class="block text-xs text-muted mt-0.5">
          xs, sm, md, lg & xl button and icon-only proportions.
        </text>
      </view>
      <view class="flex flex-wrap items-center gap-2.5">
        <c-button wx:for="{{ sizes }}" wx:key="*this" size="{{ item }}" color="primary" label="Size {{ item }}" />
      </view>
      <view class="flex flex-wrap items-center gap-2.5 pt-2 border-t border-muted">
        <c-button wx:for="{{ sizes }}" wx:key="*this" size="{{ item }}" color="secondary" variant="soft" icon="i-lucide-sparkles" />
      </view>
    </view>
    <!-- 4. Icons Props & Custom Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">
          Icons, Trailing & Custom Slots
        </text>
        <text class="block text-xs text-muted mt-0.5">
          Using leadingIcon, trailingIcon, trailing prop, or leading/trailing slots.
        </text>
      </view>
      <view class="flex flex-wrap items-center gap-2.5">
        <c-button color="primary" leading-icon="i-lucide-rocket" label="Leading Prop" />
        <c-button color="primary" variant="outline" trailing-icon="i-lucide-arrow-right" label="Trailing Prop" />
        <c-button color="secondary" variant="soft" leading-icon="i-lucide-check" trailing-icon="i-lucide-chevron-right" label="Both Icons" />
        <c-button color="neutral" variant="soft" icon="i-lucide-download" trailing="{{ true }}" label="Icon Trailing" />
        <c-button color="success" variant="outline">
          <c-icon slot="leading" name="i-lucide-shield-check" size="xs" color="success" />
          <text>Slot Icons</text>
          <c-badge slot="trailing" label="New" size="xs" color="success" variant="soft" />
        </c-button>
      </view>
    </view>
    <!-- 5. Async LoadingAuto & Manual Loading -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">
          Loading & Async Auto-Loading
        </text>
        <text class="block text-xs text-muted mt-0.5">Count: {{ count }} · {{ asyncResult }}</text>
      </view>
      <view class="flex flex-wrap gap-2.5">
        <c-button loading-auto="{{ true }}" color="primary" trailing="{{true}}" leading-icon="i-lucide-send" label="Async Resolve" bind:tap="handleAsyncResolve" />
        <c-button loading-auto="{{ true }}" color="danger" variant="soft" leading-icon="i-lucide-alert-circle" label="Async Reject" bind:tap="handleAsyncReject" />
        <c-button loading="{{ true }}" color="neutral" variant="outline" loading-icon="i-lucide-loader-circle" label="Always Loading" />
      </view>
    </view>
    <!-- 6. WeChat Native openType -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">WeChat Native openType</text>
        <text class="block text-xs text-muted mt-0.5">
          Passes open-type and MiniProgram callbacks transparently through native button.
        </text>
      </view>
      <view class="flex flex-wrap gap-2.5">
        <c-button open-type="share" color="primary" variant="soft" leading-icon="i-lucide-share-2" label="Share Page" />
        <c-button open-type="contact" color="secondary" variant="outline" leading-icon="i-lucide-message-circle" label="Support Chat" />
        <c-button open-type="openSetting" color="neutral" variant="outline" leading-icon="i-lucide-settings" label="Open Settings" bind:opensetting="onOpenSetting" />
      </view>
    </view>
    <!-- 7. Block & UI Overrides -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">
          Block Layout & UI Slot Override
        </text>
        <text class="block text-xs text-muted mt-0.5">
          Full-width stack and custom ring/shadow classes via ui.
        </text>
      </view>
      <view class="flex flex-col gap-2.5">
        <c-button block="{{ true }}" color="primary" label="Full Width Primary Action" bind:tap="handleCountTap" />
        <c-button block="{{ true }}" color="primary" variant="soft" disabled="{{ true }}" label="Full Width Disabled" />
        <c-button color="neutral" variant="outline" ui="{{ customButtonUI }}" label="Custom UI Ring Override" />
      </view>
    </view>
  </view>
</view>