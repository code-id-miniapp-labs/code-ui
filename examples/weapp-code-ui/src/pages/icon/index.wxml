<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Icon"
    badge="Data Display"
    subtitle="Multi-collection Iconify vector icons supporting Lucide & Tabler, semantic colors, sizes & spin animation."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Collection Gallery -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view class="flex items-center justify-between gap-2">
        <view>
          <text class="block text-sm font-semibold text-highlighted">Interactive Collection Browser</text>
          <text class="block text-xs text-muted mt-0.5">Tap any icon to copy its <text class="font-mono">&lt;c-icon /&gt;</text> tag.</text>
        </view>
        <view class="flex gap-1.5">
          <c-button
            wx:for="{{ collections }}"
            wx:key="*this"
            size="xs"
            color="{{ selectedCollection === item ? 'primary' : 'neutral' }}"
            variant="{{ selectedCollection === item ? 'solid' : 'outline' }}"
            label="{{ item }}"
            data-collection="{{ item }}"
            bind:tap="onSelectCollection"
          />
        </view>
      </view>

      <view class="flex flex-wrap gap-1.5">
        <c-button
          wx:for="{{ sizes }}"
          wx:key="*this"
          size="xs"
          color="{{ selectedSize === item ? 'secondary' : 'neutral' }}"
          variant="{{ selectedSize === item ? 'solid' : 'outline' }}"
          label="{{ item }}"
          data-size="{{ item }}"
          bind:tap="onSelectSize"
        />
      </view>

      <view class="flex flex-wrap gap-1.5">
        <c-button
          wx:for="{{ colors }}"
          wx:key="*this"
          size="xs"
          color="{{ selectedColor === item ? item : 'neutral' }}"
          variant="{{ selectedColor === item ? 'solid' : 'outline' }}"
          label="{{ item }}"
          data-color="{{ item }}"
          bind:tap="onSelectColor"
        />
      </view>

      <view wx:if="{{ selectedCollection === 'tabler' }}" class="grid grid-cols-3 gap-2.5 pt-2">
        <view
          wx:for="{{ tablerIcons }}"
          wx:key="id"
          data-name="{{ item.name }}"
          data-spin="{{ item.spin }}"
          bind:tap="copyIconTag"
          class="bg-muted border border-muted rounded-xl p-3 flex flex-col items-center gap-1.5 active:bg-elevated"
        >
          <c-icon name="{{ item.name }}" size="{{ selectedSize }}" color="{{ selectedColor }}" spin="{{ item.spin }}" />
          <text class="text-[11px] text-toned text-center">{{ item.label }}</text>
        </view>
      </view>

      <view wx:else class="grid grid-cols-3 gap-2.5 pt-2">
        <view
          wx:for="{{ lucideIcons }}"
          wx:key="id"
          data-name="{{ item.name }}"
          data-spin="{{ item.spin }}"
          bind:tap="copyIconTag"
          class="bg-muted border border-muted rounded-xl p-3 flex flex-col items-center gap-1.5 active:bg-elevated"
        >
          <c-icon name="{{ item.name }}" size="{{ selectedSize }}" color="{{ selectedColor }}" spin="{{ item.spin }}" />
          <text class="text-[11px] text-toned text-center">{{ item.label }}</text>
        </view>
      </view>
    </view>

    <!-- 2. Semantic Colors & Built-in Aliases -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Colors, Sizes & Configured Aliases</text>
        <text class="block text-xs text-muted mt-0.5">Configured aliases: check, minus, close & loading.</text>
      </view>

      <view class="flex flex-wrap items-center justify-between gap-2 py-1">
        <view wx:for="{{ colors }}" wx:key="*this" class="flex flex-col items-center gap-1">
          <c-icon name="i-lucide-heart" size="lg" color="{{ item }}" />
          <text class="text-[10px] text-dimmed">{{ item }}</text>
        </view>
      </view>

      <view class="flex flex-wrap items-center justify-around gap-3 pt-3 border-t border-muted">
        <view wx:for="{{ aliases }}" wx:key="name" class="flex flex-col items-center gap-1">
          <c-icon name="{{ item.name }}" size="md" color="primary" spin="{{ item.spin }}" />
          <text class="text-[10px] font-mono text-dimmed">{{ item.label }}</text>
        </view>
      </view>
    </view>
  </view>
</view>
