<view class="min-h-screen bg-neutral-50 text-neutral-900 pb-20">
  <!-- Page Header -->
  <view class="px-6 pt-8 pb-5 bg-white border-b border-neutral-200 mb-6">
    <view class="text-xl font-extrabold text-neutral-950">Icon Showcase</view>
    <view class="text-xs text-neutral-500 mt-1">
      Multi-collection icon support with Lucide & Tabler via Tailwind CSS v4 and @egoist/tailwindcss-icons.
    </view>
  </view>
  <view class="px-5 flex flex-col gap-6">
    <!-- Live Interactive Controls -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Interactive Customizer</view>
      <view class="text-xs text-neutral-400 mb-4">
        Toggle collection, size, and theme color to preview icons dynamically in real time.
      </view>
      <!-- Collection Selector -->
      <view class="mb-4">
        <view class="text-xs font-semibold text-neutral-600 mb-2">Icon Collection</view>
        <view class="flex flex-wrap gap-2">
          <view wx:for="{{collections}}" wx:key="*this" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold border transition-all cursor-pointer capitalize {{selectedCollection === item ? 'bg-primary text-white border-primary shadow-xs' : 'bg-neutral-100 text-neutral-700 border-neutral-200'}}" data-collection="{{item}}" bind:tap="onSelectCollection">
            {{item}}
          </view>
        </view>
      </view>
      <!-- Size Selector -->
      <view class="mb-4">
        <view class="text-xs font-semibold text-neutral-600 mb-2">Size</view>
        <view class="flex flex-wrap gap-2">
          <view wx:for="{{sizes}}" wx:key="*this" class="px-3 py-1.5 rounded-lg text-xs font-medium border transition-all cursor-pointer {{selectedSize === item ? 'bg-primary text-white border-primary shadow-xs' : 'bg-neutral-100 text-neutral-700 border-neutral-200'}}" data-size="{{item}}" bind:tap="onSelectSize">
            {{item}}
          </view>
        </view>
      </view>
      <!-- Color Selector -->
      <view>
        <view class="text-xs font-semibold text-neutral-600 mb-2">Color</view>
        <view class="flex flex-wrap gap-2">
          <view wx:for="{{colors}}" wx:key="value" class="px-3 py-1.5 rounded-lg text-xs font-medium border transition-all cursor-pointer {{selectedColor === item.value ? 'bg-primary text-white border-primary shadow-xs' : 'bg-neutral-100 text-neutral-700 border-neutral-200'}}" data-color="{{item.value}}" bind:tap="onSelectColor">
            {{item.label}}
          </view>
        </view>
      </view>
    </view>
    <!-- 15 Showcase Icons Grid -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="flex items-center justify-between mb-1">
        <view class="text-sm font-bold text-neutral-900 capitalize">
          15 {{selectedCollection}} Icons
        </view>
        <view class="text-[20rpx] text-neutral-400 font-mono">15 of 15</view>
      </view>
      <view class="text-xs text-neutral-400 mb-4">
        Tap any icon card to copy its WXML component snippet to clipboard.
      </view>
      <view class="grid grid-cols-3 gap-3">
        <view wx:for="{{selectedCollection === 'tabler' ? tablerIcons : lucideIcons}}" wx:key="id" class="flex flex-col items-center justify-center p-3 rounded-xl border border-neutral-100 bg-neutral-50/60 active:bg-neutral-100 transition-all cursor-pointer relative" data-name="{{item.name}}" data-spin="{{item.spin}}" bind:tap="copyIconTag">
          <!-- Icon View -->
          <view class="w-12 h-12 rounded-xl bg-white border border-neutral-200/80 shadow-2xs flex items-center justify-center mb-2">
            <c-icon name="{{item.name}}" className="text-blue-500" />
          </view>
          <!-- Label -->
          <text class="text-xs font-semibold text-neutral-800 text-center leading-tight truncate w-full">
            {{item.label}}
          </text>
          <!-- Category Badge -->
          <text class="text-[18rpx] text-neutral-400 mt-1 uppercase tracking-wider font-mono">
            {{item.category}}
          </text>
        </view>
      </view>
    </view>
    <!-- Cross-Collection Side-by-Side (Namespaced Notation) -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">
        Cross-Collection Comparison (Namespaced Notation)
      </view>
      <view class="text-xs text-neutral-400 mb-4">
        Use name="collection:icon" (e.g. lucide:heart vs tabler:heart) simultaneously in the same view.
      </view>
      <view class="flex flex-col gap-2.5">
        <view wx:for="{{comparison}}" wx:key="label" class="flex items-center justify-between p-3 rounded-xl bg-neutral-50 border border-neutral-200/70">
          <text class="text-xs font-medium text-neutral-700 w-24">{{item.label}}</text>
          <!-- Lucide Variant -->
          <view class="flex items-center gap-2 cursor-pointer" data-name="{{item.lucide}}" bind:tap="copyIconTag">
            <c-icon name="{{item.lucide}}" size="md" color="primary" />
            <text class="text-[20rpx] font-mono text-neutral-500">{{item.lucide}}</text>
          </view>
          <!-- Tabler Variant -->
          <view class="flex items-center gap-2 cursor-pointer" data-name="{{item.tabler}}" bind:tap="copyIconTag">
            <c-icon name="{{item.tabler}}" size="md" color="primary" />
            <text class="text-[20rpx] font-mono text-neutral-500">{{item.tabler}}</text>
          </view>
        </view>
      </view>
    </view>
    <!-- Configured Default Aliases -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Default Config Aliases</view>
      <view class="text-xs text-neutral-400 mb-4">
        Mapped in cui.config.ts — accessible directly without full iconify class prefix.
      </view>
      <view class="grid grid-cols-4 gap-3">
        <view wx:for="{{aliases}}" wx:key="name" class="flex flex-col items-center justify-center p-3 rounded-xl border border-neutral-100 bg-neutral-50/60 active:bg-neutral-100 transition-all cursor-pointer" data-name="{{item.name}}" data-spin="{{item.spin}}" bind:tap="copyIconTag">
          <view class="w-10 h-10 rounded-lg bg-white border border-neutral-200/80 shadow-2xs flex items-center justify-center mb-2">
            <c-icon name="{{item.name}}" size="md" color="primary" spin="{{item.spin}}" />
          </view>
          <text class="text-xs font-mono font-medium text-neutral-700 truncate w-full text-center">
            {{item.label}}
          </text>
        </view>
      </view>
    </view>
    <!-- Size Scale Demo -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Size Scale</view>
      <view class="text-xs text-neutral-400 mb-4">
        xs (14px), sm (16px), md (20px), lg (24px), xl (28px).
      </view>
      <view class="flex items-end justify-around p-4 rounded-xl bg-neutral-50 border border-neutral-200/60">
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-star" size="xs" color="warning" />
          <text class="text-[20rpx] font-mono text-neutral-400">xs</text>
        </view>
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-star" size="sm" color="warning" />
          <text class="text-[20rpx] font-mono text-neutral-400">sm</text>
        </view>
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-star" size="md" color="warning" />
          <text class="text-[20rpx] font-mono text-neutral-400">md</text>
        </view>
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-star" size="lg" color="warning" />
          <text class="text-[20rpx] font-mono text-neutral-400">lg</text>
        </view>
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-star" size="xl" color="warning" />
          <text class="text-[20rpx] font-mono text-neutral-400">xl</text>
        </view>
      </view>
    </view>
    <!-- Semantic Colors Demo -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Semantic Colors</view>
      <view class="text-xs text-neutral-400 mb-4">
        Supports all theme tokens via color property.
      </view>
      <view class="flex items-center justify-around p-4 rounded-xl bg-neutral-50 border border-neutral-200/60">
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-heart" size="lg" color="primary" />
          <text class="text-[20rpx] font-mono text-neutral-500">primary</text>
        </view>
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-heart" size="lg" color="success" />
          <text class="text-[20rpx] font-mono text-neutral-500">success</text>
        </view>
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-heart" size="lg" color="warning" />
          <text class="text-[20rpx] font-mono text-neutral-500">warning</text>
        </view>
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-heart" size="lg" color="danger" />
          <text class="text-[20rpx] font-mono text-neutral-500">danger</text>
        </view>
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-heart" size="lg" color="info" />
          <text class="text-[20rpx] font-mono text-neutral-500">info</text>
        </view>
        <view class="flex flex-col items-center gap-1.5">
          <c-icon name="i-tabler-heart" size="lg" color="neutral" />
          <text class="text-[20rpx] font-mono text-neutral-500">neutral</text>
        </view>
      </view>
    </view>
  </view>
</view>