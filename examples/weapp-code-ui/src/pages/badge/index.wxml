<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Badge"
    badge="Data Display"
    subtitle="Compact status tags across 4 variants, 7 semantic colors, 5 sizes, icons, avatars & ui overrides."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Variants x Colors Matrix -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Variants & Semantic Colors</text>
        <text class="block text-xs text-muted mt-0.5">solid, outline, soft & subtle paired with all 7 color tokens.</text>
      </view>

      <view wx:for="{{ variants }}" wx:key="*this" class="flex flex-col gap-2">
        <text class="text-[11px] font-mono uppercase text-dimmed">{{ item }}</text>
        <view class="flex flex-wrap gap-2">
          <c-badge
            wx:for="{{ colors }}"
            wx:for-item="col"
            wx:key="*this"
            variant="{{ item }}"
            color="{{ col }}"
            label="{{ col }}"
          />
        </view>
      </view>
    </view>

    <!-- 2. Size Scale -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Size Scale</text>
        <text class="block text-xs text-muted mt-0.5">xs, sm, md, lg & xl proportional padding and font sizes.</text>
      </view>
      <view class="flex flex-wrap items-center gap-2">
        <c-badge
          wx:for="{{ sizes }}"
          wx:key="*this"
          size="{{ item }}"
          color="primary"
          variant="soft"
          label="Size {{ item }}"
        />
      </view>
    </view>

    <!-- 3. Props vs Slots (leading, default, trailing) -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Label Prop & Custom Slots</text>
        <text class="block text-xs text-muted mt-0.5">Supports label prop or leading, default & trailing slots with icons or avatars.</text>
      </view>
      <view class="flex flex-wrap items-center gap-2.5">
        <c-badge color="primary" variant="solid" label="Label Prop" />

        <c-badge color="success" variant="soft">
          <c-icon slot="leading" name="i-lucide-check" size="xs" color="success" />
          <text>Verified</text>
        </c-badge>

        <c-badge color="secondary" variant="subtle">
          <text>Notification</text>
          <c-icon slot="trailing" name="i-lucide-bell" size="xs" color="secondary" />
        </c-badge>

        <c-badge color="warning" variant="outline">
          <c-icon slot="leading" name="i-lucide-alert-circle" size="xs" color="warning" />
          <text>Attention</text>
          <c-icon slot="trailing" name="i-lucide-chevron-right" size="xs" color="warning" />
        </c-badge>

        <c-badge color="neutral" variant="outline" size="lg" ui="{{ { root: 'rounded-full pl-1 pr-2.5' } }}">
          <c-avatar slot="leading" text="RD" size="3xs" color="primary" />
          <text>Maintainer</text>
        </c-badge>
      </view>
    </view>

    <!-- 4. Interactive Counter & Filter Pills -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view class="flex items-center justify-between gap-2">
        <view>
          <text class="block text-sm font-semibold text-highlighted">Interactive & UI Overrides</text>
          <text class="block text-xs text-muted mt-0.5">Dynamic label binding and rounded-full pill styling via ui.</text>
        </view>
        <c-badge
          color="{{ unreadCount > 0 ? 'danger' : 'neutral' }}"
          variant="solid"
          size="md"
          label="{{ unreadCount > 0 ? unreadCount + ' unread' : 'Caught up' }}"
          ui="{{ { root: 'rounded-full px-2.5' } }}"
        />
      </view>

      <view class="flex items-center gap-2">
        <c-button size="xs" color="primary" variant="soft" label="+1 Message" bind:tap="onBumpCount" />
        <c-button size="xs" color="neutral" variant="outline" label="Mark Read" bind:tap="onClearCount" />
      </view>

      <view class="flex items-center flex-wrap gap-2 pt-2 border-t border-muted">
        <view data-filter="all" bind:tap="onSelectFilter">
          <c-badge label="All" color="{{ activeFilter === 'all' ? 'primary' : 'neutral' }}" variant="{{ activeFilter === 'all' ? 'solid' : 'outline' }}" ui="{{ { root: 'rounded-full' } }}" />
        </view>
        <view data-filter="active" bind:tap="onSelectFilter">
          <c-badge label="Active" color="{{ activeFilter === 'active' ? 'primary' : 'neutral' }}" variant="{{ activeFilter === 'active' ? 'solid' : 'outline' }}" ui="{{ { root: 'rounded-full' } }}" />
        </view>
        <view data-filter="archived" bind:tap="onSelectFilter">
          <c-badge label="Archived" color="{{ activeFilter === 'archived' ? 'primary' : 'neutral' }}" variant="{{ activeFilter === 'archived' ? 'solid' : 'outline' }}" ui="{{ { root: 'rounded-full' } }}" />
        </view>
      </view>
    </view>
  </view>
</view>
