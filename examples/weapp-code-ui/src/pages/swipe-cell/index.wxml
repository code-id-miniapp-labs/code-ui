<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Swipe Cell"
    badge="Interaction"
    subtitle="WXS physics left/right swipeable row revealing contextual actions across outline, separated & soft variants."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Right Actions (Single & Multi) -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Right Actions (Swipe Left)</text>
        <text class="block text-xs text-muted mt-0.5">Single delete or multi-action Star & Delete group.</text>
      </view>
      <view class="flex flex-col gap-2.5">
        <c-swipe-cell right="{{ rightSingle }}" bind:click="onActionClick" closeOnActionClick closeOnContentClick>
          <view class="p-3.5 bg-default flex items-center justify-between">
            <view class="flex flex-col">
              <text class="text-sm font-semibold text-highlighted">Swipe left for Delete</text>
              <text class="text-xs text-muted mt-0.5">Single action button · auto close on tap</text>
            </view>
            <text class="text-xs text-dimmed">‹ Swipe</text>
          </view>
        </c-swipe-cell>

        <c-swipe-cell right="{{ rightMulti }}" bind:click="onActionClick">
          <view class="p-3.5 bg-default flex items-center justify-between">
            <view class="flex flex-col">
              <text class="text-sm font-semibold text-highlighted">Multi-Action Row</text>
              <text class="text-xs text-muted mt-0.5">Star & Delete actions</text>
            </view>
            <text class="text-xs text-dimmed">‹ Swipe</text>
          </view>
        </c-swipe-cell>
      </view>
    </view>

    <!-- 2. Left & Bi-Directional Actions -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Left & Both Sides</text>
        <text class="block text-xs text-muted mt-0.5">Swipe right for Archive or either direction for Mark Read / Pin / Delete.</text>
      </view>
      <view class="flex flex-col gap-2.5">
        <c-swipe-cell left="{{ leftActions }}" bind:click="onActionClick">
          <view class="p-3.5 bg-default flex items-center justify-between">
            <text class="text-xs text-dimmed">Swipe ›</text>
            <view class="flex flex-col items-end">
              <text class="text-sm font-semibold text-highlighted">Left Archive Action</text>
              <text class="text-xs text-muted mt-0.5">Reveals Archive tray</text>
            </view>
          </view>
        </c-swipe-cell>

        <c-swipe-cell left="{{ bothLeft }}" right="{{ bothRight }}" bind:click="onActionClick">
          <view class="p-3.5 bg-default flex items-center justify-between">
            <text class="text-xs text-dimmed">‹ Both ›</text>
            <text class="text-sm font-semibold text-highlighted">Bi-Directional Cell</text>
            <text class="text-xs text-dimmed">Actions</text>
          </view>
        </c-swipe-cell>

        <c-swipe-cell right="{{ rightSingle }}" disabled="{{ true }}">
          <view class="p-3.5 bg-elevated opacity-60 flex items-center justify-between">
            <text class="text-sm font-medium text-muted">Disabled Swipe Cell</text>
            <c-badge label="Locked" size="xs" color="neutral" variant="soft" />
          </view>
        </c-swipe-cell>
      </view>
    </view>

    <!-- 3. Programmatic / Controlled Open -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled State ({{ controlledStatus }})</text>
        <text class="block text-xs text-muted mt-0.5">Open left/right trays or close cleanly from external controls.</text>
      </view>
      <c-swipe-cell
        opened="{{ controlledOpened }}"
        left="{{ leftActions }}"
        right="{{ rightMulti }}"
        variant="outline"
        class-name="rounded-xl"
        bind:openChange="onControlledOpenChange"
        bind:click="onActionClick"
      >
        <view class="p-3.5 bg-muted">
          <text class="block text-sm font-semibold text-highlighted">Controlled Row</text>
          <text class="block text-xs text-muted mt-0.5">Use the buttons below to toggle left/right trays.</text>
        </view>
      </c-swipe-cell>
      <view class="flex flex-wrap gap-2">
        <c-button size="xs" variant="outline" color="primary" label="Open Left" bind:tap="openControlledLeft" />
        <c-button size="xs" variant="soft" color="secondary" label="Open Right" bind:tap="openControlledRight" />
        <c-button size="xs" variant="outline" color="neutral" label="Close" bind:tap="closeControlled" />
      </view>
    </view>

    <!-- 4. Interactive Message List & Variants -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Interactive Inbox List & Visual Variants</text>
        <text class="block text-xs text-muted mt-0.5">Swipe rows to Star or Delete live list items; variants outline/separated/soft.</text>
      </view>

      <view class="flex flex-col divide-y divide-muted border border-default rounded-xl overflow-hidden">
        <c-swipe-cell
          wx:for="{{ messageList }}"
          wx:key="id"
          data-id="{{ item.id }}"
          right="{{ rightMulti }}"
          bind:click="handleListAction"
          closeOnActionClick
        >
          <view class="p-3.5 bg-default flex items-center justify-between gap-3">
            <view class="min-w-0 flex-1">
              <view class="flex items-center gap-1.5">
                <text class="text-sm font-semibold text-highlighted">{{ item.sender }}</text>
                <c-icon wx:if="{{ item.starred }}" name="i-lucide-star" size="xs" color="warning" />
              </view>
              <text class="block text-xs text-muted line-clamp-1 mt-0.5">{{ item.title }}</text>
            </view>
            <text class="text-[11px] text-dimmed shrink-0">{{ item.time }}</text>
          </view>
        </c-swipe-cell>
        <view wx:if="{{ messageList.length === 0 }}" class="p-6 text-center text-xs text-muted">
          All messages cleared! Reload page to reset.
        </view>
      </view>

      <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
        <c-swipe-cell variant="outline" size="sm" right="{{ rightSingle }}" bind:click="onActionClick">
          <view class="p-3 flex items-center justify-between">
            <text class="text-xs font-semibold text-highlighted">Outline Variant (sm)</text>
            <text class="text-xs text-dimmed">‹ Swipe</text>
          </view>
        </c-swipe-cell>
        <c-swipe-cell variant="separated" size="md" right="{{ rightMulti }}" bind:click="onActionClick">
          <view class="p-3.5 flex items-center justify-between">
            <text class="text-sm font-semibold text-highlighted">Separated Card (md)</text>
            <text class="text-xs text-dimmed">‹ Swipe</text>
          </view>
        </c-swipe-cell>
        <c-swipe-cell variant="soft" size="lg" left="{{ leftActions }}" bind:click="onActionClick">
          <view class="p-4 flex items-center justify-between">
            <text class="text-xs text-dimmed">Swipe ›</text>
            <text class="text-sm font-semibold text-highlighted">Soft Variant (lg)</text>
          </view>
        </c-swipe-cell>
      </view>
    </view>
  </view>
</view>
