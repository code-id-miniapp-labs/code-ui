<view class="min-h-screen bg-muted text-default">
  <!-- Custom Top Navigation Bar (Detected by <c-app> via #cui-top-bar) -->
  <view id="cui-top-bar" class="fixed top-0 left-0 right-0 z-50 bg-default/95 backdrop-blur border-b border-default">
    <view class="px-4 h-11 flex items-center justify-between">
      <view class="flex items-center gap-2">
        <view class="w-8 h-8 rounded-full flex items-center justify-center active:bg-elevated" bindtap="handleBack">
          <c-icon name="i-lucide-chevron-left" size="sm" color="neutral" />
        </view>
        <text class="text-base font-bold text-highlighted">Banner</text>
      </view>
      <c-badge label="#cui-top-bar" color="success" variant="soft" size="xs" />
    </view>
  </view>

  <!-- Pinned Fixed Top Banner (Positioned below #cui-top-bar via --cui-banner-top-offset) -->
  <c-banner
    open="{{ showTopBanner }}"
    placement="top"
    mode="fixed"
    color="{{ topBannerColor }}"
    title="{{ topBannerTitle }}"
    description="{{ topBannerDesc }}"
    close="{{ true }}"
    actions="{{ topBannerActions }}"
    bind:dismiss="onTopBannerDismiss"
    bind:action="onTopBannerAction"
  />

  <view class="px-4 pt-2 pb-24 flex flex-col gap-4">
    <demo-header
      title="Banner"
      badge="Feedback"
      subtitle="Top/bottom inset-aware announcement bars coordinating automatically with #cui-top-bar, #cui-bottom-bar & inline alerts."
    />

    <!-- 1. Interactive Fixed Bars Controller -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view class="flex items-center justify-between gap-2">
        <text class="text-sm font-semibold text-highlighted">Fixed Inset Controls</text>
        <c-badge label="c-app Inset Registry" color="info" variant="soft" size="xs" />
      </view>
      <text class="text-xs text-muted leading-relaxed">
        Toggles fixed top/bottom banners stacked automatically outside #cui-top-bar and #cui-bottom-bar.
      </text>

      <view class="flex flex-wrap gap-2">
        <c-button size="xs" color="{{ showTopBanner ? 'danger' : 'primary' }}" label="{{ showTopBanner ? 'Hide Top Banner' : 'Show Top Banner' }}" bind:tap="toggleTopBanner" />
        <c-button size="xs" color="secondary" variant="outline" label="Secondary" data-color="secondary" bind:tap="setTopBannerColor" />
        <c-button size="xs" color="warning" variant="outline" label="Warning" data-color="warning" bind:tap="setTopBannerColor" />
        <c-button size="xs" color="info" variant="outline" label="Info" data-color="info" bind:tap="setTopBannerColor" />
        <c-button size="xs" color="danger" variant="outline" label="Danger" data-color="danger" bind:tap="setTopBannerColor" />
      </view>

      <view class="flex flex-wrap gap-2 pt-2 border-t border-muted">
        <c-button size="xs" color="{{ showBottomBanner ? 'danger' : 'neutral' }}" label="{{ showBottomBanner ? 'Hide Bottom Banner' : 'Show Bottom Banner' }}" bind:tap="toggleBottomBanner" />
        <c-button size="xs" color="primary" variant="outline" label="Primary" data-color="primary" bind:tap="setBottomBannerColor" />
        <c-button size="xs" color="success" variant="outline" label="Success" data-color="success" bind:tap="setBottomBannerColor" />
      </view>
    </view>

    <!-- 2. Inline Styles & Rich Compositions -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Inline Variants, Actions, Images & Sizes</text>
        <text class="block text-xs text-muted mt-0.5">solid, outline, soft, subtle, badge + actions, secondary & loading.</text>
      </view>

      <c-banner mode="inline" color="primary" variant="solid" title="Pin Code Setup Guide!" description="Protect your account access" image="https://api.dicebear.com/7.x/shapes/svg?seed=pincode" image-shape="full" close="{{ true }}" actions="{{ pinCodeActions }}" bind:action="onPinCodeAction" />
      <c-banner mode="inline" color="secondary" variant="soft" badge="NEW" title="Runtime Secondary Accent" description="Supports full theme color & dark surfaces." close="{{ true }}" actions="{{ promoActions }}" bind:action="onPromoAction" />
      <c-banner mode="inline" color="success" variant="soft" badge="PROMO" title="50% Off Renewal" description="Apply code CODEUI50 at checkout." image="https://api.dicebear.com/7.x/shapes/svg?seed=promo" image-shape="rect" close="{{ true }}" actions="{{ promoActions }}" bind:action="onPromoAction" />
      <c-banner mode="inline" color="neutral" variant="outline" image-position="right" caption="Security Alert" title="New sign-in detected" image="https://api.dicebear.com/7.x/shapes/svg?seed=security" image-shape="full" close="{{ true }}" actions="{{ securityActions }}" bind:action="onSecurityAction" />
      <c-banner mode="inline" color="info" variant="subtle" title="Inline subtle announcement banner." close="{{ true }}" actions="{{ bottomBannerActions }}" bind:action="onInlineAction" bind:more="onInlineMore" />

      <view class="flex flex-col gap-2 pt-2 border-t border-muted">
        <c-banner mode="inline" size="xs" color="neutral" variant="soft" title="Extra Small (xs)" />
        <c-banner mode="inline" size="sm" color="primary" variant="subtle" title="Small (sm)" />
        <c-banner mode="inline" size="md" color="secondary" variant="soft" title="Medium (md)" />
        <c-banner mode="inline" size="lg" color="success" variant="outline" title="Large (lg)" />
      </view>
    </view>

    <!-- 3. Event Log -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-2">
      <text class="text-sm font-semibold text-highlighted">Event Log</text>
      <view class="p-3 bg-muted border border-muted rounded-xl font-mono text-[11px] text-toned break-all">
        {{ lastEvent }}
      </view>
    </view>
  </view>

  <!-- Fixed Bottom Banner -->
  <c-banner
    open="{{ showBottomBanner }}"
    placement="bottom"
    mode="fixed"
    color="{{ bottomBannerColor }}"
    title="{{ bottomBannerTitle }}"
    description="{{ bottomBannerDesc }}"
    close="{{ true }}"
    more="{{ true }}"
    actions="{{ bottomBannerActions }}"
    bind:dismiss="onBottomBannerDismiss"
    bind:action="onBottomBannerAction"
  />

  <!-- Custom Bottom Tab-Bar (#cui-bottom-bar) -->
  <view id="cui-bottom-bar" class="fixed bottom-0 left-0 right-0 z-50 bg-default/95 backdrop-blur border-t border-default">
    <view class="h-14 px-6 flex items-center justify-around">
      <view class="flex flex-col items-center gap-1 {{ activeTab === 0 ? 'text-primary' : 'text-muted' }}" data-tab="{{ 0 }}" bindtap="switchTab">
        <c-icon name="i-lucide-home" size="sm" color="{{ activeTab === 0 ? 'primary' : 'neutral' }}" />
        <text class="text-[10px] font-semibold">Overview</text>
      </view>
      <view class="flex flex-col items-center gap-1 {{ activeTab === 1 ? 'text-primary' : 'text-muted' }}" data-tab="{{ 1 }}" bindtap="switchTab">
        <c-icon name="i-lucide-compass" size="sm" color="{{ activeTab === 1 ? 'primary' : 'neutral' }}" />
        <text class="text-[10px] font-semibold">Explore</text>
      </view>
      <view class="flex flex-col items-center gap-1 {{ activeTab === 2 ? 'text-primary' : 'text-muted' }}" data-tab="{{ 2 }}" bindtap="switchTab">
        <c-icon name="i-lucide-settings" size="sm" color="{{ activeTab === 2 ? 'primary' : 'neutral' }}" />
        <text class="text-[10px] font-semibold">Settings</text>
      </view>
    </view>
  </view>
</view>
