<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Toast"
    badge="Feedback"
    subtitle="Imperative notification queue via useToast() with variants, placements, progress timers, update() & native HUD."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Variant & Placement Matrix -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Variants & Placements</text>
        <text class="block text-xs text-muted mt-0.5">Select variant and screen edge alignment to preview live.</text>
      </view>

      <view class="flex flex-col gap-2">
        <text class="text-[11px] font-mono uppercase text-dimmed">Variant</text>
        <view class="flex flex-wrap gap-2">
          <c-button
            wx:for="{{ variants }}"
            wx:key="*this"
            size="xs"
            color="{{ activeVariant === item ? 'primary' : 'neutral' }}"
            variant="{{ activeVariant === item ? 'solid' : 'outline' }}"
            label="{{ item }}"
            data-variant="{{ item }}"
            bind:tap="onSelectVariant"
          />
        </view>
      </view>

      <view class="flex flex-col gap-2">
        <text class="text-[11px] font-mono uppercase text-dimmed">Placement</text>
        <view class="flex flex-wrap gap-2">
          <c-button
            wx:for="{{ placements }}"
            wx:key="*this"
            size="xs"
            color="{{ activePlacement === item ? 'secondary' : 'neutral' }}"
            variant="{{ activePlacement === item ? 'solid' : 'outline' }}"
            label="{{ item }}"
            data-placement="{{ item }}"
            bind:tap="onSelectPlacement"
          />
        </view>
      </view>
    </view>

    <!-- 2. Semantic Helpers -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Semantic Presets</text>
        <text class="block text-xs text-muted mt-0.5">All color helpers react cleanly to runtime theme changes.</text>
      </view>
      <view class="grid grid-cols-2 gap-2.5">
        <c-button size="sm" color="primary" variant="soft" label="Primary" bind:tap="showDefaultPrimary" />
        <c-button size="sm" color="secondary" variant="soft" label="Secondary" bind:tap="showDefaultSecondary" />
        <c-button size="sm" color="success" variant="soft" label="toast.success()" bind:tap="showDefaultSuccess" />
        <c-button size="sm" color="danger" variant="soft" label="toast.error()" bind:tap="showDefaultError" />
        <c-button size="sm" color="warning" variant="soft" label="toast.warning()" bind:tap="showDefaultWarning" />
        <c-button size="sm" color="info" variant="soft" label="toast.info()" bind:tap="showDefaultInfo" />
      </view>
    </view>

    <!-- 3. Orientations, Progress & Dynamic Update -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Actions, Progress & Persistent update()</text>
        <text class="block text-xs text-muted mt-0.5">Last action: {{ lastActionLog }}</text>
      </view>
      <view class="flex flex-col gap-2">
        <c-button size="sm" color="primary" variant="outline" label="With Undo Action" bind:tap="showWithAction" />
        <c-button size="sm" color="primary" variant="outline" label="Horizontal Bottom Pill" bind:tap="showHorizontalPill" />
        <c-button size="sm" color="primary" variant="outline" label="Top Progress Indicator" bind:tap="showProgressTop" />
        <c-button size="sm" color="primary" variant="outline" label="Progress Disabled (false)" bind:tap="showNoProgress" />
        <c-button size="sm" color="primary" variant="solid" label="Persistent Upload (duration: 0 + update)" bind:tap="showPersistentUpdate" />
      </view>
    </view>

    <!-- 4. Native Mode & Queue Control -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Native MiniProgram HUD & Clear</text>
        <text class="block text-xs text-muted mt-0.5">Centered compact overlay with animated loading-to-done update.</text>
      </view>
      <view class="flex flex-wrap gap-2.5">
        <c-button size="sm" color="neutral" variant="soft" label="Native Success" bind:tap="showNativeSuccess" />
        <c-button size="sm" color="neutral" variant="soft" label="Native Loading -> Done" bind:tap="showNativeLoading" />
        <c-button size="sm" color="danger" variant="outline" label="Clear Queue" bind:tap="clearAllToasts" />
      </view>
    </view>
  </view>
</view>
