<view class="min-h-screen bg-neutral-50 text-neutral-900 pb-16">
  <!-- Page Header -->
  <view class="px-6 pt-8 pb-5 bg-white border-b border-neutral-200 mb-6">
    <view class="text-xl font-extrabold text-neutral-950">Textarea</view>
    <view class="text-xs text-neutral-500 mt-1">
      Multi-line textarea with Nuxt UI v4 styling, controlled value, character counter, auto-height, and Form integration.
    </view>
  </view>
  <view class="px-5 flex flex-col gap-6">
    <!-- 1. Controlled Component -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Controlled Component</view>
      <view class="text-xs text-neutral-400 mb-3">
        Two-way synchronization between Page data and textarea machine context.
      </view>
      <view class="flex flex-col gap-3">
        <c-textarea value="{{controlledValue}}" placeholder="Type your notes here..." count="{{true}}" autoHeight="{{true}}" bind:change="onControlledChange" bind:focus="onTextareaFocus" bind:blur="onTextareaBlur" bind:linechange="onLineChange" />
        <view class="flex flex-col gap-1.5 bg-neutral-50 p-3 rounded-xl border border-neutral-200 text-xs">
          <view class="flex items-center justify-between">
            <text class="text-neutral-500">Live Characters:</text>
            <text class="font-bold text-neutral-900 font-mono">
              {{controlledValue.length}} / 140
            </text>
          </view>
          <view class="flex items-center justify-between">
            <text class="text-neutral-500">Line Count:</text>
            <text class="font-bold text-neutral-900 font-mono">{{lineCount}}</text>
          </view>
          <view class="flex items-center justify-between">
            <text class="text-neutral-500">Last Triggered Event:</text>
            <text class="font-mono text-emerald-600 font-semibold">{{lastEvent || 'none'}}</text>
          </view>
          <view class="pt-1 border-t border-neutral-200">
            <text class="text-neutral-500 block mb-1">Value Preview:</text>
            <text class="font-mono text-neutral-800 break-all whitespace-pre-wrap">
              {{controlledValue || '(empty)'}}
            </text>
          </view>
        </view>
        <view class="flex flex-wrap gap-2 pt-1">
          <c-button size="sm" variant="outline" color="primary" bind:tap="setControlledPreset">
            Set Sample Bio
          </c-button>
          <c-button size="sm" variant="outline" color="neutral" bind:tap="appendControlledLine">
            Append Line
          </c-button>
          <c-button size="sm" variant="outline" color="danger" bind:tap="clearControlled">
            Clear State
          </c-button>
        </view>
      </view>
    </view>
    <!-- 2. Connected with Form & FormField -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Connected with Form & Validation</view>
      <view class="text-xs text-neutral-400 mb-4">
        Integrated with c-form and c-form-field via EventBus. Automatic validation, error highlights, and reset.
      </view>
      <c-form id="feedback-form" focusOnError="{{true}}" showErrors="{{true}}" bind:submit="handleFormSubmit" bind:error="handleFormError">
        <view class="flex flex-col gap-4">
          <!-- Text Input Field -->
          <c-form-field name="title" label="Feedback Title" rules="{{titleRules}}" required="{{true}}">
            <c-input name="title" placeholder="e.g. Component request" clearable="{{true}}" />
          </c-form-field>
          <!-- Textarea Field with Validation -->
          <c-form-field name="description" label="Detailed Description" description="Minimum 10 characters explaining your feedback" rules="{{descriptionRules}}" required="{{true}}">
            <c-textarea name="description" placeholder="Write detailed feedback here..." count="{{true}}" maxlength="{{200}}" clearable="{{true}}" autoHeight="{{true}}" />
          </c-form-field>
          <!-- Form Action Buttons -->
          <view class="flex flex-wrap gap-2 pt-2">
            <c-button color="primary" variant="solid" size="sm" bind:tap="submitForm">
              Submit Form
            </c-button>
            <c-button color="neutral" variant="outline" size="sm" bind:tap="resetForm">
              Reset
            </c-button>
            <c-button color="success" variant="soft" size="sm" bind:tap="prefillForm">
              Pre-fill Valid
            </c-button>
            <c-button color="danger" variant="soft" size="sm" bind:tap="injectServerError">
              Server Error
            </c-button>
          </view>
          <!-- Form Status Feedback -->
          <view wx:if="{{formStatus}}" class="p-3.5 rounded-xl border text-xs {{formStatus === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800'}}">
            <view class="font-bold mb-1">
              {{formStatus === 'success' ? '✓ Form Submitted Successfully' : '✗ Form Validation Error'}}
            </view>
            <view class="font-mono whitespace-pre-wrap break-all">{{formMessage}}</view>
          </view>
        </view>
      </c-form>
    </view>
    <!-- 3. Variants -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Visual Variants</view>
      <view class="text-xs text-neutral-400 mb-3">
        outline (default), soft, subtle, ghost, none
      </view>
      <view class="flex flex-col gap-3">
        <c-textarea variant="outline" placeholder="Outline variant (default)" />
        <c-textarea variant="soft" placeholder="Soft variant" />
        <c-textarea variant="subtle" placeholder="Subtle variant" />
        <c-textarea variant="ghost" placeholder="Ghost variant" />
        <c-textarea variant="none" placeholder="None variant (borderless)" />
      </view>
    </view>
    <!-- 4. Semantic Colors & Focus Ring -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Semantic Colors</view>
      <view class="text-xs text-neutral-400 mb-3">
        Tap each textarea to see its colored focus ring
      </view>
      <view class="flex flex-col gap-3">
        <c-textarea color="primary" placeholder="Primary color ring" />
        <c-textarea color="success" placeholder="Success color ring" />
        <c-textarea color="warning" placeholder="Warning color ring" />
        <c-textarea color="danger" placeholder="Danger color ring" />
        <c-textarea color="info" placeholder="Info color ring" />
        <c-textarea color="neutral" placeholder="Neutral color ring" />
      </view>
    </view>
    <!-- 5. Sizes -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Sizes</view>
      <view class="text-xs text-neutral-400 mb-3">xs, sm, md, lg, xl</view>
      <view class="flex flex-col gap-3">
        <c-textarea size="xs" placeholder="Extra small (xs)" />
        <c-textarea size="sm" placeholder="Small (sm)" />
        <c-textarea size="md" placeholder="Medium (md - default)" />
        <c-textarea size="lg" placeholder="Large (lg)" />
        <c-textarea size="xl" placeholder="Extra large (xl)" />
      </view>
    </view>
    <!-- 6. Features: Counter, Clearable, Auto-Height, Disabled -->
    <view class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-xs">
      <view class="text-sm font-bold text-neutral-900 mb-1">Features & States</view>
      <view class="text-xs text-neutral-400 mb-3">
        Built-in character counter, clear button, auto-expanding height, and disabled/readonly.
      </view>
      <view class="flex flex-col gap-4">
        <view>
          <view class="text-xs font-semibold text-neutral-600 mb-1">
            Character Counter (maxlength 100):
          </view>
          <c-textarea count="{{true}}" maxlength="{{100}}" defaultValue="Nuxt UI v4 style character counter pre-configured in the bottom right corner." placeholder="Type with counter..." />
        </view>
        <view>
          <view class="text-xs font-semibold text-neutral-600 mb-1">Clearable:</view>
          <c-textarea clearable="{{true}}" defaultValue="Tap the clear button on the top right to erase" placeholder="Clearable textarea..." />
        </view>
        <view>
          <view class="text-xs font-semibold text-neutral-600 mb-1">
            Auto-Height (expands with newlines):
          </view>
          <c-textarea autoHeight="{{true}}" defaultValue="Line 1\nLine 2\nLine 3" placeholder="Auto height textarea..." />
        </view>
        <view>
          <view class="text-xs font-semibold text-neutral-600 mb-1">
            Disabled & ReadOnly States:
          </view>
          <view class="flex flex-col gap-2">
            <c-textarea disabled="{{true}}" defaultValue="Disabled textarea (non-interactive)" />
            <c-textarea readOnly="{{true}}" defaultValue="ReadOnly textarea (selectable, not editable)" />
          </view>
        </view>
      </view>
    </view>
  </view>
</view>