<view class="min-h-screen bg-muted text-default pb-12">
  <demo-header
    title="Textarea"
    badge="Form"
    subtitle="Multi-line text input with autoHeight, character counter slots, icons, loading state & FormField validation."
  />

  <view class="px-4 flex flex-col gap-4">
    <!-- 1. Controlled State, AutoHeight & Count -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Controlled State & Auto-Height</text>
        <text class="block text-xs text-muted mt-0.5">Lines: {{ lineCount }} · Last event: {{ lastEvent }}</text>
      </view>
      <c-textarea
        value="{{ controlledValue }}"
        placeholder="Write bio or multi-line message..."
        auto-height="{{ true }}"
        clearable="{{ true }}"
        count="{{ true }}"
        maxlength="{{ 200 }}"
        bind:change="onControlledChange"
        bind:focus="onTextareaFocus"
        bind:blur="onTextareaBlur"
        bind:linechange="onLineChange"
      />
      <view class="flex flex-wrap gap-2">
        <c-button size="xs" variant="outline" color="primary" label="Set Preset" bind:tap="setControlledPreset" />
        <c-button size="xs" variant="soft" color="secondary" label="Append Line" bind:tap="appendControlledLine" />
        <c-button size="xs" variant="outline" color="neutral" label="Clear" bind:tap="clearControlled" />
      </view>
    </view>

    <!-- 2. Leading/Trailing Icons, Loading & Slots -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Icons, Loading & Custom Count Slot</text>
        <text class="block text-xs text-muted mt-0.5">Demonstrates leadingIcon, trailingIcon, loading and slot='count'.</text>
      </view>
      <c-textarea leading-icon="i-lucide-message-circle" trailing-icon="i-lucide-sparkles" color="secondary" highlight="{{ true }}" placeholder="AI prompt notes..." />
      <c-textarea loading="{{ true }}" value="Saving draft..." placeholder="Draft..." />
      <c-textarea placeholder="Custom count badge slot..." maxlength="{{ 120 }}">
        <view slot="leading">
          <c-icon name="i-lucide-edit-3" size="xs" color="primary" />
        </view>
        <view slot="count">
          <c-badge label="Max 120 chars" size="xs" color="neutral" variant="soft" />
        </view>
      </c-textarea>
    </view>

    <!-- 3. Variants, Colors & Sizes -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">Variants, Semantic Colors & Sizes</text>
        <text class="block text-xs text-muted mt-0.5">All 5 variants, highlight colors & xs-xl sizes.</text>
      </view>
      <view class="flex flex-col gap-2.5">
        <c-textarea wx:for="{{ variants }}" wx:key="*this" variant="{{ item }}" placeholder="Variant: {{ item }}" />
      </view>
      <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
        <c-textarea wx:for="{{ colors }}" wx:key="*this" color="{{ item }}" highlight="{{ true }}" placeholder="Highlight color: {{ item }}" />
      </view>
      <view class="flex flex-col gap-2.5 pt-2 border-t border-muted">
        <c-textarea wx:for="{{ sizes }}" wx:key="*this" size="{{ item }}" placeholder="Size: {{ item }}" />
      </view>
    </view>

    <!-- 4. States & Form Validation -->
    <view class="bg-default border border-default rounded-2xl p-4 flex flex-col gap-3">
      <view>
        <text class="block text-sm font-semibold text-highlighted">States & Form Integration</text>
        <text class="block text-xs text-muted mt-0.5">Disabled, readOnly, invalid & validated FormField feedback.</text>
      </view>
      <c-textarea disabled="{{ true }}" value="Disabled textarea" />
      <c-textarea read-only="{{ true }}" value="Read-only system notice" />
      <c-textarea invalid="{{ true }}" value="Invalid content" />

      <c-form id="feedback-form" bind:submit="handleFormSubmit" bind:error="handleFormError">
        <view class="flex flex-col gap-3 pt-2 border-t border-muted">
          <c-form-field name="title" label="Feedback Summary" required="{{ true }}" rules="{{ titleRules }}">
            <c-input placeholder="Short summary" />
          </c-form-field>
          <c-form-field name="description" label="Detailed Feedback" required="{{ true }}" rules="{{ descriptionRules }}">
            <c-textarea placeholder="Minimum 10 characters..." count="{{ true }}" maxlength="{{ 300 }}" />
          </c-form-field>
        </view>
      </c-form>

      <view class="flex flex-wrap gap-2">
        <c-button size="xs" color="primary" label="Submit" bind:tap="submitForm" />
        <c-button size="xs" color="secondary" variant="soft" label="Prefill" bind:tap="prefillForm" />
        <c-button size="xs" color="danger" variant="soft" label="Inject Error" bind:tap="injectServerError" />
        <c-button size="xs" color="neutral" variant="outline" label="Reset" bind:tap="resetForm" />
      </view>
      <text wx:if="{{ formStatus }}" class="text-xs font-mono text-muted">{{ formStatus }}: {{ formMessage }}</text>
    </view>
  </view>
</view>
