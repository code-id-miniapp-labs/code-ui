<view class="bg-default border-b border-default px-4 pt-3 pb-3 mb-4 transition-colors duration-200">
  <view class="flex items-start justify-between gap-3">
    <view class="flex-1 min-w-0">
      <view class="flex items-center gap-2">
        <text class="text-xl font-bold text-highlighted tracking-tight">{{ title }}</text>
        <c-badge wx:if="{{ badge }}" label="{{ badge }}" color="primary" variant="soft" size="sm" />
      </view>
      <text wx:if="{{ subtitle }}" class="block text-xs text-muted mt-1 leading-relaxed">{{ subtitle }}</text>
    </view>

    <c-button
      size="xs"
      color="neutral"
      variant="soft"
      icon="{{ isDark ? 'i-lucide-sun' : 'i-lucide-moon' }}"
      label="{{ isDark ? 'Light' : 'Dark' }}"
      bind:tap="onToggleMode"
    />
  </view>

  <view class="flex items-center justify-between gap-2 mt-3 pt-2.5 border-t border-muted">
    <view class="flex items-center gap-1.5 flex-wrap">
      <text class="text-[11px] font-medium text-dimmed mr-1">Primary:</text>
      <view
        wx:for="{{ presets }}"
        wx:key="id"
        data-value="{{ item.value }}"
        bind:tap="onSelectPreset"
        class="flex items-center justify-center w-6 h-6 rounded-full border transition-transform {{ activePrimary === item.value ? 'border-highlighted scale-110' : 'border-transparent opacity-80' }}"
      >
        <view
          class="w-4 h-4 rounded-full"
          style="background-color: {{ item.hex }};"
        />
      </view>
    </view>

    <view
      wx:if="{{ hasCustomTheme }}"
      bind:tap="onResetTheme"
      class="px-2 py-1 rounded-md bg-elevated active:opacity-75"
    >
      <text class="text-[11px] text-muted font-medium">Reset</text>
    </view>
  </view>
</view>
