{
  "name": "weapp-vite-template",
  "type": "module",
  "version": "1.0.7",
  "private": true,
  "description": "原生微信小程序 weapp-vite 模板",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "templates/weapp-vite-template"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [],
  "scripts": {
    "dev": "wv dev",
    "dev:web": "wv dev -p web --host",
    "dev:open": "wv dev -o",
    "dev:ui": "wv dev --ui",
    "dev:open:ui": "wv dev --ui -o",
    "prebuild": "rm -rf dist",
    "build": "wv build",
    "build:web": "wv build -p web",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "open": "wv open",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue,wxss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,vue,wxss}\" --fix --allow-empty-input",
    "g": "wv generate",
    "postinstall": "wv prepare"
  },
  "dependencies": {
    "@code-ui/components": "workspace:*",
    "@code-ui/composables": "workspace:*",
    "@code-ui/plugin-vite": "workspace:*"
  },
  "devDependencies": {
    "@code-ui/accordion": "workspace:*",
    "@code-ui/accordion-item": "workspace:*",
    "@code-ui/checkbox": "workspace:*",
    "@code-ui/checkbox-group": "workspace:*",
    "@code-ui/input": "workspace:*",
    "@code-ui/pin-input": "workspace:*",
    "@code-ui/qr-code": "workspace:*",
    "@code-ui/radio": "workspace:*",
    "@code-ui/radio-group": "workspace:*",
    "@code-ui/stepper": "workspace:*",
    "@code-ui/stepper-item": "workspace:*",
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@icebreakers/eslint-config": "^8.0.2",
    "@icebreakers/stylelint-config": "^5.1.2",
    "@iconify-json/lucide": "^1.2.146",
    "@iconify-json/tabler": "^1.2.42",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "miniprogram-api-typings": "^5.2.3",
    "stylelint": "^17.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "weapp-vite": "^7.5.0"
  }
}