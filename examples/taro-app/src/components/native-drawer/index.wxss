/* ==========================================================================
   Native WeChat MiniProgram Drawer Component Styles (@code-ui/drawer)
   ========================================================================== */

.code-drawer-root {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  overflow: hidden;
  touch-action: none;
  overscroll-behavior: contain;
}

/* --- Backdrop --- */
.code-drawer-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  opacity: 0;
  transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity;
  touch-action: none;
  overscroll-behavior: contain;
}

.code-drawer-backdrop--open {
  opacity: 1;
}

.code-drawer-backdrop--closed {
  opacity: 0;
}

/* --- Content Sheet --- */
.code-drawer-content {
  position: absolute;
  background: #1e293b;
  color: #f8fafc;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  z-index: 1001;
  transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform;
  overscroll-behavior: contain;
  overscroll-behavior-y: contain;
}

/* When actively dragging, disable CSS transition for instant 60fps tracking */
.code-drawer-content--dragging {
  transition: none !important;
}

/* --- Bottom Placement --- */
.code-drawer-content--bottom {
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 85vh;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  transform: translate3d(0, 100%, 0);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.code-drawer-content--bottom.code-drawer-content--open {
  transform: translate3d(0, 0, 0);
}

.code-drawer-content--bottom.code-drawer-content--closing {
  transform: translate3d(0, 100%, 0);
}

/* --- Top Placement --- */
.code-drawer-content--top {
  left: 0;
  right: 0;
  top: 0;
  max-height: 85vh;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  transform: translate3d(0, -100%, 0);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.code-drawer-content--top.code-drawer-content--open {
  transform: translate3d(0, 0, 0);
}

.code-drawer-content--top.code-drawer-content--closing {
  transform: translate3d(0, -100%, 0);
}

/* --- Left Placement --- */
.code-drawer-content--left {
  top: 0;
  bottom: 0;
  left: 0;
  width: 78vw;
  max-width: 600rpx;
  transform: translate3d(-100%, 0, 0);
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-top: calc(20rpx + env(safe-area-inset-top));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.code-drawer-content--left.code-drawer-content--open {
  transform: translate3d(0, 0, 0);
}

.code-drawer-content--left.code-drawer-content--closing {
  transform: translate3d(-100%, 0, 0);
}

/* --- Right Placement --- */
.code-drawer-content--right {
  top: 0;
  bottom: 0;
  right: 0;
  width: 78vw;
  max-width: 600rpx;
  transform: translate3d(100%, 0, 0);
  border-left: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-top: calc(20rpx + env(safe-area-inset-top));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.code-drawer-content--right.code-drawer-content--open {
  transform: translate3d(0, 0, 0);
}

.code-drawer-content--right.code-drawer-content--closing {
  transform: translate3d(100%, 0, 0);
}

/* --- Grabber --- */
.code-drawer-grabber {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx 0 8rpx 0;
  touch-action: none;
  overscroll-behavior: contain;
}

.code-drawer-grabber-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: rgba(255, 255, 255, 0.25);
}

/* --- Header --- */
.code-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 36rpx 16rpx 36rpx;
  touch-action: none;
  overscroll-behavior: contain;
}

.code-drawer-header-content {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #f1f5f9;
}

.code-drawer-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.code-drawer-close-icon {
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1;
}

/* --- Body --- */
.code-drawer-body {
  flex: 1;
  min-height: 0;
  max-height: 60vh;
  padding: 20rpx 36rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
  overscroll-behavior-y: contain;
  touch-action: pan-y;
  font-size: 28rpx;
  color: #cbd5e1;
  line-height: 1.6;
  box-sizing: border-box;
}

/* --- Footer --- */
.code-drawer-footer {
  padding: 20rpx 36rpx 28rpx 36rpx;
  touch-action: none;
  overscroll-behavior: contain;
}
